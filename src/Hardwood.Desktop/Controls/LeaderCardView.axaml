<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Controls.LeaderCardView"
             x:DataType="vm:LeaderCard">
  <!-- Run 64 (review #13 rank 3): a stat's leader card. The leader big, in his club's colour; 2nd to 5th below. -->
  <Border Classes="panel" Margin="0,0,10,10" Padding="10,8">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" Classes="link" Content="Full list ›" Command="{Binding ShowAll}" FontSize="12"
                ToolTip.Tip="The top 40 in this stat as a table." VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{Binding EmptyText}" Classes="muted" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Margin="0,4"/>
      <Border IsVisible="{Binding HasAny}" BorderBrush="{Binding TopTeam, Converter={x:Static c:Converters.TeamAccentBrush}}"
              BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,4" Background="#14FFFFFF">
        <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto">
          <c:Avatar Grid.RowSpan="2" Player="{Binding TopPlayer}" Team="{Binding TopTeam}" Width="52" Height="52" VerticalAlignment="Center"/>
          <c:PlayerLink Grid.Column="1" Grid.ColumnSpan="2" Player="{Binding TopPlayer}" Text="{Binding TopName}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0,6,0" VerticalAlignment="Center">
            <c:TeamLogo Team="{Binding TopTeam}" Width="18" Height="18" ShowText="False" VerticalAlignment="Center"/>
            <c:TeamLink Team="{Binding TopTeam}" Text="{Binding TopClub}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding TopValue}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Unit}" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Rest}" IsVisible="{Binding HasAny}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LeaderEntry">
            <Grid ColumnDefinitions="22,24,*,Auto" Height="24">
              <TextBlock Text="{Binding Rank}" Classes="muted" VerticalAlignment="Center"/>
              <c:TeamLogo Grid.Column="1" Team="{Binding Team}" Width="18" Height="18" ShowText="False" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              <c:PlayerLink Grid.Column="2" Player="{Binding Player}" Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
