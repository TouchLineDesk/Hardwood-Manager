<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.TeamView"
             x:DataType="vm:TeamViewModel">
  <DockPanel>
    <!-- Broadcast header: team-colour glow, logo, name, league; then the club as stat chips. -->
    <Border DockPanel.Dock="Top" CornerRadius="10" ClipToBounds="True" MinHeight="84" Margin="0,0,0,10">
      <Grid>
        <c:CourtBackdrop Glow="{Binding Accent}" Intensity="0.8"/>
        <!-- The banner is a background, so it never sizes the header (an Image here stretched the header to the whole page). -->
        <Border Opacity="0.35" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border.Background><ImageBrush Source="{Binding Banner}" Stretch="UniformToFill"/></Border.Background>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="16,10" VerticalAlignment="Center">
          <c:TeamLogo Team="{Binding Team}" Width="64" Height="64" ShowText="False" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Team.FullName}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding League}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding Jerseys}" IsVisible="{Binding HasJerseys}" VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="Home, road and alternate jerseys">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="46" Height="52" Stretch="Uniform"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="3" Content="Back" Command="{Binding BackCommand}" VerticalAlignment="Top"/>
        </Grid>
      </Grid>
    </Border>
    <c:StatStrip DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Accent="{Binding Accent}" Margin="0,0,0,2"/>
    <TabControl>
      <TabItem Header="Roster">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
            <Button Content="Open player" Command="{Binding OpenPlayerCommand}"/>
            <TextBlock Text="Ability ranges are what your scouts believe. Click a name to open the player." Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" RowHeight="28">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Player" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TeamPlayerRow"><c:PlayerLink Player="{Binding Player}" Margin="6,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="52"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="52"/>
              <DataGridTextColumn Header="Nat" Binding="{Binding Nat}" Width="150"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="56"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="56"/>
              <DataGridTextColumn Header="Contract" Binding="{Binding Contract}" Width="120"/>
              <DataGridTextColumn Header="G" Binding="{Binding G}" Width="44"/>
              <DataGridTextColumn Header="PPG" Binding="{Binding Ppg}" Width="56"/>
              <DataGridTextColumn Header="RPG" Binding="{Binding Rpg}" Width="56"/>
              <DataGridTextColumn Header="APG" Binding="{Binding Apg}" Width="56"/>
              <DataGridTextColumn Header="" Binding="{Binding Status}" Width="*" MinWidth="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Stats">
        <DataGrid ItemsSource="{Binding Players}" RowHeight="28">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Player" Width="190">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamPlayerRow"><c:PlayerLink Player="{Binding Player}" Margin="6,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="G" Binding="{Binding G}" Width="50"/>
            <DataGridTextColumn Header="MPG" Binding="{Binding Mpg}" Width="66"/>
            <DataGridTextColumn Header="PPG" Binding="{Binding Ppg}" Width="66"/>
            <DataGridTextColumn Header="RPG" Binding="{Binding Rpg}" Width="66"/>
            <DataGridTextColumn Header="APG" Binding="{Binding Apg}" Width="66"/>
            <DataGridTextColumn Header="SPG" Binding="{Binding Spg}" Width="66"/>
            <DataGridTextColumn Header="BPG" Binding="{Binding Bpg}" Width="66"/>
            <DataGridTextColumn Header="FG%" Binding="{Binding Fg}" Width="70"/>
            <DataGridTextColumn Header="3P%" Binding="{Binding Tp}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Schedule &amp; results">
        <DataGrid ItemsSource="{Binding Games}" RowHeight="28" CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110"/>
            <DataGridTextColumn Header="" Binding="{Binding Where}" Width="40"/>
            <DataGridTemplateColumn Header="Opponent" Width="260">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamGameRow">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0">
                    <c:TeamLogo Team="{Binding Opponent}" Width="20" Height="20" ShowText="False"/>
                    <c:TeamLink Team="{Binding Opponent}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="110"/>
            <DataGridTemplateColumn Header="" Width="70">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamGameRow"><Button Content="Box" Command="{Binding Open}" IsVisible="{Binding HasBox}" Padding="8,1" FontSize="11"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Competition" Binding="{Binding Competition}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
