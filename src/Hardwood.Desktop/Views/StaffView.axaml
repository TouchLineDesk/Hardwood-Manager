<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.StaffView"
             x:DataType="vm:StaffViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <TextBlock Text="Staff &amp; Training" Classes="h1" Margin="0"/>
      <c:StatStrip ItemsSource="{Binding Chips}" Accent="{Binding Accent}"/>
      <TextBlock Text="{Binding Status}" Classes="accent" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <!-- Run 66 (review #13 rank 5, Danny's #464): staff as cards (role badge, the five ratings as bars, the deal as a chip);
           the market as cards with roles as chips; both tables one click away. -->
      <Grid ColumnDefinitions="Auto,*">
        <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="120" ToolTip.Tip="Cards, or the full tables with every rating"/>
      </Grid>
      <StackPanel Spacing="12">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Your staff" Classes="h2"/>
            <Button Grid.Column="1" Classes="primary" Content="Extend" Command="{Binding ExtendCommand}" IsEnabled="{Binding CanExtend}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="Release selected" Command="{Binding FireCommand}" IsEnabled="{Binding SelectedOurs, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick someone on your staff first" ToolTip.ShowOnDisabled="True" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBlock Text="{Binding Renewal}" TextWrapping="Wrap" Margin="0,4" IsVisible="{Binding Renewal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel IsVisible="{Binding ShowCards}" Margin="0,4,0,0">
            <ItemsControl x:Name="OurCards" ItemsSource="{Binding Ours}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="250" MaxColumns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StaffRow">
                  <Button Classes="marketCard staffCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Click="OnOursClick" ToolTip.Tip="Pick him to extend or release">
                      <Border BorderBrush="{Binding RoleBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="9,7">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <Border Background="{Binding RoleBrush}" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Role}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                              </Border>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                              <TextBlock Text="{Binding AgeLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StyleText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="His role's key rating, out of 20">
                              <TextBlock Text="{Binding Key}" FontSize="26" FontWeight="Bold" Foreground="{Binding KeyBrush}" HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding KeyLabel}" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Bars}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StaffBar">
                                <Grid ColumnDefinitions="34,*,24" Height="15" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                  <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                                  <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" FontWeight="{Binding Weight}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <WrapPanel>
                            <Border Background="{Binding CompareBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding HasCompare}" ToolTip.Tip="{Binding CompareTip}">
                              <TextBlock Text="{Binding Compare}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Background="{Binding ContractBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding ContractTip}">
                              <TextBlock Text="{Binding ContractChip}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="VacantCards" ItemsSource="{Binding Vacant}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="250" MaxColumns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VacantRole">
                  <Border Classes="panel" BorderBrush="{Binding RoleBrush}" BorderThickness="4,1,1,1" Margin="0,0,10,10" Padding="9,7">
                    <StackPanel Spacing="4">
                      <Border Background="{Binding RoleBrush}" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                      </Border>
                      <TextBlock Text="Vacant" FontWeight="SemiBold" FontSize="14" Foreground="#F85149"/>
                      <TextBlock Text="{Binding Text}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                      <Button Content="Find one ›" Click="OnFindClick" HorizontalAlignment="Left" ToolTip.Tip="Show the staff market for this role"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <DataGrid x:Name="StaffOursGrid" ItemsSource="{Binding Ours}" SelectedItem="{Binding SelectedOurs}" Height="200" IsVisible="{Binding ShowTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="190"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64"/>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="64"/>
              <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="120"/>
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="96"/>
              <DataGridTextColumn Header="Deal" Binding="{Binding Contract}" Width="*" MinWidth="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Staff market" Classes="h2"/>
            <Button Grid.Column="1" Content="Interview" Command="{Binding InterviewCandidateCommand}" IsEnabled="{Binding SelectedMarket, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a candidate in the staff market first" ToolTip.ShowOnDisabled="True" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Classes="primary" Content="Hire on his terms" Command="{Binding HireCommand}" IsEnabled="{Binding CanHire}" VerticalAlignment="Bottom"/>
          </Grid>
          <ItemsControl x:Name="RoleChips" ItemsSource="{Binding RoleChips}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChip">
                <Button Classes="filter" Classes.on="{Binding Selected}" Margin="0,0,6,4" ToolTip.Tip="{Binding Tip}" Tag="{Binding Name}" Click="OnRoleClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Record}" Classes="filterRecord"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Interview}" TextWrapping="Wrap" Margin="0,4" IsVisible="{Binding Interview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel IsVisible="{Binding ShowCards}">
            <TextBlock Text="{Binding MarketCardsNote}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ItemsControl x:Name="StaffMarketCards" ItemsSource="{Binding MarketCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="250" MaxColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StaffRow">
                  <Button Classes="marketCard staffCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Click="OnMarketClick" ToolTip.Tip="Pick him, then Interview">
                      <Border BorderBrush="{Binding RoleBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="9,7">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <Border Background="{Binding RoleBrush}" CornerRadius="4" Padding="7,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Role}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                              </Border>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                              <TextBlock Text="{Binding AgeLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StyleText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="His role's key rating, out of 20">
                              <TextBlock Text="{Binding Key}" FontSize="26" FontWeight="Bold" Foreground="{Binding KeyBrush}" HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding KeyLabel}" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Bars}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StaffBar">
                                <Grid ColumnDefinitions="34,*,24" Height="15" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                  <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                                  <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" FontWeight="{Binding Weight}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <WrapPanel>
                            <Border Background="{Binding CompareBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding HasCompare}" ToolTip.Tip="{Binding CompareTip}">
                              <TextBlock Text="{Binding Compare}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Background="{Binding ContractBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding ContractTip}">
                              <TextBlock Text="{Binding ContractChip}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <DataGrid x:Name="StaffMarketGrid" ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedMarket}" Height="240" IsVisible="{Binding ShowTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="190"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64"/>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="64"/>
              <DataGridTextColumn Header="Coa" Binding="{Binding Coaching}" Width="58"/>
              <DataGridTextColumn Header="Dev" Binding="{Binding Development}" Width="58"/>
              <DataGridTextColumn Header="Fit" Binding="{Binding Fitness}" Width="58"/>
              <DataGridTextColumn Header="Med" Binding="{Binding Medical}" Width="58"/>
              <DataGridTextColumn Header="Sco" Binding="{Binding Scouting}" Width="58"/>
              <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="110"/>
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="*" MinWidth="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>

      <!-- You as a coach (staff part 2): your ratings, and how a season's work grows them. -->
      <Border Classes="panel">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Session.Coach.Name, StringFormat='You: {0}'}" FontWeight="SemiBold"/>
          <c:StatStrip ItemsSource="{Binding CoachChips}" Accent="{Binding Accent}"/>
          <TextBlock Text="{Binding CoachNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Delegation (roadmap 12): hand an area to the staff member who runs it. -->
      <Border Classes="panel">
        <StackPanel Spacing="4">
          <TextBlock Text="Delegate" FontWeight="SemiBold"/>
          <CheckBox Content="Development coach plans training (focus and intensity, every Monday)" IsChecked="{Binding DelegateTraining}"/>
          <CheckBox Content="{Binding DelegateRecruitingText}" IsChecked="{Binding DelegateRecruiting}" IsVisible="{Binding ShowDelegateRecruiting}"/>
          <CheckBox Content="Assistant picks tactics for each opponent" IsChecked="{Binding DelegateTactics}"/>
          <CheckBox Content="Assistant coach fronts the press and handles the locker room" IsChecked="{Binding DelegateMedia}"/>
          <CheckBox Content="Sporting director makes the end-of-summer signings (to the roster minimum, within the budget)" IsChecked="{Binding DelegateSignings}" IsVisible="{Binding ShowSummerDuties}"/>
          <CheckBox Content="General manager fills empty staff posts when the summer ends" IsChecked="{Binding DelegateStaffHiring}" IsVisible="{Binding ShowSummerDuties}"/>
          <TextBlock Text="{Binding DelegationNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="panel" IsEnabled="{Binding TrainingManual}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Training intensity" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding IntensityText}" Classes="muted"/></Grid>
          <Slider Minimum="0" Maximum="100" Value="{Binding Intensity}"/>
          <TextBlock Text="Harder training grows players faster and wears them down; your strength coach decides how much it costs." Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Individual focus" Classes="h2"/>
      <TextBlock Text="Pick what each player works on. Focus tilts skill growth toward one area; young players with headroom benefit most. Projected is where this summer's development is heading at his minutes (before luck); Staff is your staff's share of it against average training." Classes="muted" TextWrapping="Wrap"/>
      <c:StatStrip ItemsSource="{Binding DevelopmentChips}" Accent="{Binding Accent}"/>
      <DataGrid ItemsSource="{Binding Players}" IsReadOnly="False" Height="380" CanUserSortColumns="False" IsEnabled="{Binding TrainingManual}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="CA / PA" Binding="{Binding Ability}" Width="120" IsReadOnly="True"/>
          <DataGridTextColumn Header="Projected" Binding="{Binding Projected}" Width="100" IsReadOnly="True"/>
          <DataGridTextColumn Header="Staff" Binding="{Binding FromStaff}" Width="72" IsReadOnly="True"/>
          <DataGridTemplateColumn Header="Focus" Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:FocusRow">
                <ComboBox ItemsSource="{Binding Owner.FocusOptions}" SelectedItem="{Binding Focus}" HorizontalAlignment="Stretch" Margin="2"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
