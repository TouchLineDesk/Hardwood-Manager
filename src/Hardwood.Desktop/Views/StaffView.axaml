<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.StaffView"
             x:DataType="vm:StaffViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <TextBlock Text="Staff &amp; Training" Classes="h1" Margin="0"/>
      <c:StatStrip ItemsSource="{Binding Chips}" Accent="{Binding Accent}"/>
      <TextBlock Text="{Binding Status}" Classes="accent" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <!-- Stacked rather than side by side (critic review #4: half-width tables cut off salary and ratings). -->
      <StackPanel Spacing="12">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Your staff" Classes="h2"/>
            <Button Grid.Column="1" Classes="primary" Content="Extend" Command="{Binding ExtendCommand}" IsEnabled="{Binding CanExtend}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="Release selected" Command="{Binding FireCommand}" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBlock Text="{Binding Renewal}" TextWrapping="Wrap" Margin="0,4" IsVisible="{Binding Renewal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <DataGrid ItemsSource="{Binding Ours}" SelectedItem="{Binding SelectedOurs}" Height="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="190"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64"/>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="64"/>
              <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="120"/>
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="96"/>
              <DataGridTextColumn Header="Deal" Binding="{Binding Contract}" Width="*" MinWidth="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Text="Staff market" Classes="h2"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding RoleFilter}" Width="190" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="Interview" Command="{Binding InterviewCandidateCommand}" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="3" Classes="primary" Content="Hire on his terms" Command="{Binding HireCommand}" IsEnabled="{Binding CanHire}" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBlock Text="{Binding Interview}" TextWrapping="Wrap" Margin="0,4" IsVisible="{Binding Interview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <DataGrid ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedMarket}" Height="240">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="190"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64"/>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="64"/>
              <DataGridTextColumn Header="Coa" Binding="{Binding Coaching}" Width="58"/>
              <DataGridTextColumn Header="Dev" Binding="{Binding Development}" Width="58"/>
              <DataGridTextColumn Header="Fit" Binding="{Binding Fitness}" Width="58"/>
              <DataGridTextColumn Header="Med" Binding="{Binding Medical}" Width="58"/>
              <DataGridTextColumn Header="Sco" Binding="{Binding Scouting}" Width="58"/>
              <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="110"/>
              <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="*" MinWidth="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>

      <!-- You as a coach (staff part 2): your ratings, and how a season's work grows them. -->
      <Border Classes="panel">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Session.Coach.Name, StringFormat='You: {0}'}" FontWeight="SemiBold"/>
          <c:StatStrip ItemsSource="{Binding CoachChips}" Accent="{Binding Accent}"/>
          <TextBlock Text="{Binding CoachNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Delegation (roadmap 12): hand an area to the staff member who runs it. -->
      <Border Classes="panel">
        <StackPanel Spacing="4">
          <TextBlock Text="Delegate" FontWeight="SemiBold"/>
          <CheckBox Content="Development coach plans training (focus and intensity, every Monday)" IsChecked="{Binding DelegateTraining}"/>
          <CheckBox Content="{Binding DelegateRecruitingText}" IsChecked="{Binding DelegateRecruiting}"/>
          <CheckBox Content="Assistant picks tactics for each opponent" IsChecked="{Binding DelegateTactics}"/>
          <CheckBox Content="Assistant coach fronts the press and handles the locker room" IsChecked="{Binding DelegateMedia}"/>
          <TextBlock Text="{Binding DelegationNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="panel" IsEnabled="{Binding TrainingManual}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Training intensity" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding IntensityText}" Classes="muted"/></Grid>
          <Slider Minimum="0" Maximum="100" Value="{Binding Intensity}"/>
          <TextBlock Text="Harder training grows players faster and wears them down; your strength coach decides how much it costs." Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Individual focus" Classes="h2"/>
      <TextBlock Text="Pick what each player works on. Focus tilts skill growth toward one area; young players with headroom benefit most. Projected is where this summer's development is heading at his minutes (before luck); Staff is your staff's share of it against average training." Classes="muted" TextWrapping="Wrap"/>
      <c:StatStrip ItemsSource="{Binding DevelopmentChips}" Accent="{Binding Accent}"/>
      <DataGrid ItemsSource="{Binding Players}" IsReadOnly="False" Height="380" CanUserSortColumns="False" IsEnabled="{Binding TrainingManual}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="CA / PA" Binding="{Binding Ability}" Width="90" IsReadOnly="True"/>
          <DataGridTextColumn Header="Projected" Binding="{Binding Projected}" Width="100" IsReadOnly="True"/>
          <DataGridTextColumn Header="Staff" Binding="{Binding FromStaff}" Width="72" IsReadOnly="True"/>
          <DataGridTemplateColumn Header="Focus" Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:FocusRow">
                <ComboBox ItemsSource="{Binding Owner.FocusOptions}" SelectedItem="{Binding Focus}" HorizontalAlignment="Stretch" Margin="2"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
