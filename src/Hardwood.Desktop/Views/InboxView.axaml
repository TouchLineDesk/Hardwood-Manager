<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             x:Class="Hardwood.Desktop.Views.InboxView"
             x:DataType="vm:InboxViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Inbox" Classes="h1"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Classes="muted" Margin="0,0,0,10" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="2*,3*">
      <Border Classes="panel" Padding="0">
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:InboxItem">
              <Grid ColumnDefinitions="56,*,Auto" Margin="2,2">
                <TextBlock Text="{Binding Date}" Classes="muted" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{StaticResource HwPanelAltBrush}" CornerRadius="3" Padding="6,1">
                  <TextBlock Text="{Binding Category}" FontSize="10.5" Classes="muted"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Classes="panel">
        <ScrollViewer>
          <StackPanel Spacing="8" DataContext="{Binding Selected}">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Date}" Classes="muted"/>
              <TextBlock Text="{Binding Category}" Classes="muted"/>
            </StackPanel>
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="20"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
