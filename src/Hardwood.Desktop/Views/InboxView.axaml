<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.InboxView"
             x:DataType="vm:InboxViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" CornerRadius="8" Margin="0,0,0,12" Padding="14,10" Background="{Binding TeamBrush}">
      <Grid ColumnDefinitions="Auto,*">
        <c:TeamLogo Team="{Binding Session.HumanTeam}" Width="56" Height="56" Margin="0,0,14,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Session.HumanTeam.FullName}" FontSize="22" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="{Binding Summary}" Foreground="#E6EAF0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="170" Margin="0,0,8,4"/>
      <Button Content="Mark all read" Command="{Binding MarkAllReadCommand}" Margin="0,0,8,4"/>
      <Button Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}" Margin="0,0,8,4" ToolTip.Tip="Delete the open message (Delete key)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="Trash" Width="14" Height="14"/>
          <TextBlock Text="Delete"/>
        </StackPanel>
      </Button>
      <Button Content="{Binding DeleteReadLabel}" Command="{Binding DeleteReadCommand}" IsEnabled="{Binding CanDeleteRead}" Margin="0,0,8,4" ToolTip.Tip="Delete every message you've read. Questions you haven't answered stay."/>
      <Button Content="{Binding DeleteShownLabel}" Command="{Binding DeleteShownCommand}" IsEnabled="{Binding CanDeleteShown}" Margin="0,0,8,4" ToolTip.Tip="Delete every message in this list (asks once). Questions you haven't answered stay."/>
    </WrapPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <ComboBox ItemsSource="{Binding ResultsOptions}" SelectedItem="{Binding ResultsCadence}" MinWidth="170" Margin="0,0,8,4"/>
      <ComboBox ItemsSource="{Binding AutoClearOptions}" SelectedItem="{Binding AutoClear}" MinWidth="170" Margin="0,0,8,4"/>
      <TextBlock Text="{Binding CleanupNote}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,4"/>
      <TextBlock Text="In the season, world news and short knocks ride in the weekly results; otherwise world news comes every other week." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
    </WrapPanel>
    <Grid ColumnDefinitions="2*,3*">
      <Border Classes="panel" Padding="0">
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}"/>
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:InboxItem">
              <!-- Two lines (run 22): the title gets the row's full width, so it never wraps letter by letter at 1280 px / 130%. -->
              <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,Auto" Margin="2,2">
                <c:Icon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{Binding IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="{Binding Weight}" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                  <TextBlock Text="{Binding Date}" Classes="muted" FontSize="11.5" VerticalAlignment="Center"/>
                  <Border Background="{StaticResource HwPanelAltBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Category}" FontSize="10.5" Classes="muted"/>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Classes="panel">
        <ScrollViewer>
          <StackPanel Spacing="8" DataContext="{Binding Selected}">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Date}" Classes="muted"/>
              <TextBlock Text="{Binding Category}" Classes="muted"/>
            </StackPanel>
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="20"/>
            <!-- Press conference / locker room: the answers and what each will do (people part 2). -->
            <Border IsVisible="{Binding HasDecision}" Background="{StaticResource HwPanelAltBrush}" CornerRadius="6" Padding="10" Margin="0,6,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DecisionHeading}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Answers}" IsVisible="{Binding DecisionOpen}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DecisionButton">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                        <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="150" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" Margin="10,4,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding !DecisionOpen}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
