<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <!-- Broadcast header: team-colour glow, logo, name, position and club. -->
      <Border CornerRadius="10" ClipToBounds="True" MinHeight="88">
        <Grid>
          <c:CourtBackdrop Glow="{Binding Accent}" Intensity="0.8"/>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,12" VerticalAlignment="Center">
            <c:TeamLogo Team="{Binding TeamObj}" Width="60" Height="60" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
              <WrapPanel>
                <TextBlock Text="{Binding Headline}" Classes="accent" FontSize="14" Margin="0,0,10,0"/>
                <c:TeamLink Team="{Binding Club}" IsVisible="{Binding Club, Converter={x:Static ObjectConverters.IsNotNull}}" Text="Open team page" FontSize="12" VerticalAlignment="Center"/>
              </WrapPanel>
              <TextBlock Text="{Binding TierLine}" Classes="muted" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Back" Command="{Binding BackCommand}" VerticalAlignment="Top"/>
          </Grid>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="Auto,*">
        <c:PlayerCard Player="{Binding Player}" Team="{Binding TeamObj}" Knowledge="{Binding Knowledge}" Width="200" Height="290" Margin="0,0,16,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Spacing="6">
          <c:StatStrip ItemsSource="{Binding Chips}" Accent="{Binding Accent}"/>
          <TextBlock Text="{Binding Honours}" Classes="accent" TextWrapping="Wrap" IsVisible="{Binding Honours, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding Tendencies}" Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
          <Button Content="Talk to him" Command="{Binding TalkToHimCommand}" IsVisible="{Binding CanTalk}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          <c:RadarChart Values="{Binding RadarValues}" Labels="{Binding RadarLabels}" Accent="{Binding Accent}" Height="250" Width="440" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*">
        <StackPanel Margin="0,0,6,0" IsVisible="{Binding HasShots}">
          <TextBlock Text="Shot chart (this season)" Classes="h2"/>
          <Border Classes="panel" Padding="6"><c:ShotChart Attempts="{Binding ZoneAttempts}" Makes="{Binding ZoneMakes}" Height="300"/></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0" IsVisible="{Binding HasTrend}">
          <TextBlock Text="Career trend (points, rebounds, assists per game)" Classes="h2"/>
          <Border Classes="panel" Padding="6"><c:LineChart Series="{Binding Trend}" XLabels="{Binding TrendLabels}" Height="300"/></Border>
        </StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AttrGroupVm">
            <Border Classes="panel" Margin="0,0,10,10" Width="250">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Average}" Classes="muted"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttrCell">
                      <Grid ColumnDefinitions="*,48" Margin="0,1">
                        <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{Binding Color}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Season by season" Classes="h2"/>
      <DataGrid ItemsSource="{Binding Seasons}" Height="200">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="96"/>
          <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="64"/>
          <DataGridTextColumn Header="GP" Binding="{Binding GP}" Width="66"/>
          <DataGridTextColumn Header="MPG" Binding="{Binding MPG}" Width="66"/>
          <DataGridTextColumn Header="PPG" Binding="{Binding PPG}" Width="66"/>
          <DataGridTextColumn Header="RPG" Binding="{Binding RPG}" Width="66"/>
          <DataGridTextColumn Header="APG" Binding="{Binding APG}" Width="66"/>
          <DataGridTextColumn Header="FG%" Binding="{Binding FG}" Width="66"/>
          <DataGridTextColumn Header="3P%" Binding="{Binding TP}" Width="66"/>
          <DataGridTextColumn Header="FT%" Binding="{Binding FT}" Width="66"/>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
