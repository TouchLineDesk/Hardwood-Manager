<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             xmlns:core="using:Hardwood.Core.Season"
             x:Class="Hardwood.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <UserControl.Resources>
    <!-- A records table (roadmap 4). Run 76 (review #13 rank 15): the holder leads the card with his photo (the club's crest
         for a team record) under the club's colour; places 2-5 follow as lines. Your club's entries in the accent colour. -->
    <DataTemplate x:Key="RecordCard" x:DataType="vm:RecordTable">
      <Border Classes="panel" Classes.mine="{Binding TopOurs}" Width="318" Margin="0,0,10,10" Padding="0" VerticalAlignment="Top">
        <Border BorderBrush="{Binding Stripe}" BorderThickness="0,5,0,0" CornerRadius="5" Padding="12,8,12,10">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="No record yet: it's set the first time it happens." Classes="muted" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding Empty}"/>
            <Grid ColumnDefinitions="52,*" IsVisible="{Binding HasTop}" Margin="0,2,0,2">
              <Panel Width="48" Height="48" VerticalAlignment="Top">
                <c:Avatar Player="{Binding Leader}" Team="{Binding LeaderClub}" Width="48" Height="48" IsVisible="{Binding HasPhoto}"/>
                <c:TeamLogo Team="{Binding LeaderClub}" ShowText="False" ShowRank="False" Width="46" Height="46" IsVisible="{Binding HasCrest}"/>
              </Panel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Top.Value}" FontWeight="Bold" FontSize="22"/>
                <TextBlock Text="{Binding Top.Who}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Classes.accent="{Binding TopOurs}"/>
                <TextBlock Text="{Binding Top.When}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Rest}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecordRow">
                  <Grid ColumnDefinitions="22,58,*" Margin="0,2">
                    <TextBlock Text="{Binding Rank}" Classes="muted" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" FontSize="13"/>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Who}" FontSize="12" TextWrapping="Wrap" Classes.accent="{Binding Ours}"/>
                      <TextBlock Text="{Binding When}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Border>
    </DataTemplate>
    <!-- A real NBA record (R1): the mark, who holds it, and when. Run 76: his photo if he's in the game, else the club's
         crest, else the trophy; the club's colour as a stripe. -->
    <DataTemplate x:Key="RealCard" x:DataType="vm:RealRecordCard">
      <Border Classes="panel" Width="296" Margin="0,0,10,10" Padding="0" VerticalAlignment="Top" ToolTip.Tip="{Binding Holder}">
        <Border BorderBrush="{Binding Stripe}" BorderThickness="0,5,0,0" CornerRadius="5" Padding="12,8,12,10">
          <Grid ColumnDefinitions="52,*">
            <Panel Width="48" Height="48" VerticalAlignment="Top" Margin="0,4,0,0">
              <c:Avatar Player="{Binding Player}" Team="{Binding Club}" Width="48" Height="48" IsVisible="{Binding HasPhoto}"/>
              <c:TeamLogo Team="{Binding Club}" ShowText="False" Width="46" Height="46" IsVisible="{Binding HasCrest}"/>
              <c:Icon Kind="Trophy" Width="30" Height="30" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding HasIcon}"/>
            </Panel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="22"/>
              <TextBlock Text="{Binding Holder}" FontSize="12" TextWrapping="Wrap" Classes.accent="{Binding Broken}"/>
              <TextBlock Text="{Binding When}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </DataTemplate>
    <!-- Run 76: a season as the champion's card (crest, colour, who they beat, the MVPs). -->
    <DataTemplate x:Key="SeasonCardTemplate" x:DataType="vm:SeasonCard">
      <Border Classes="panel" Classes.mine="{Binding Mine}" Width="300" MinHeight="132" Margin="0,0,10,10" Padding="0" ToolTip.Tip="{Binding Tip}">
        <Border BorderBrush="{Binding Stripe}" BorderThickness="0,5,0,0" CornerRadius="5" Padding="12,8,12,10">
          <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Trophy" Width="15" Height="15" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Season}" Classes="accent" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid ColumnDefinitions="56,*">
              <Panel Width="52" Height="52" VerticalAlignment="Top">
                <c:TeamLogo Team="{Binding Champion}" ShowText="False" ShowRank="False" Width="52" Height="52" IsVisible="{Binding HasCrest}"/>
                <c:Icon Kind="Trophy" Width="32" Height="32" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding !HasCrest}"/>
              </Panel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ChampionName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Beat}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <TextBlock FontSize="12" TextWrapping="Wrap">
              <Run Text="{Binding FinalsMvpLabel}" Foreground="{DynamicResource HwMutedBrush}"/><Run Text="{Binding FinalsMvp}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock FontSize="12" TextWrapping="Wrap">
              <Run Text="{Binding MvpLabel}" Foreground="{DynamicResource HwMutedBrush}"/><Run Text="{Binding Mvp}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Text="{Binding Extra}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasExtra}"/>
            <TextBlock Text="{Binding OurRecord}" FontSize="12" FontWeight="SemiBold" Classes="accent" IsVisible="{Binding HasOurRecord}"/>
          </StackPanel>
        </Border>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="History" Classes="h1"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Classes="muted" Margin="0,0,0,8"/>
    <TabControl SelectedIndex="{Binding Tab}">
      <TabItem Header="Seasons">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding SeasonsNote}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding HasSeasonsNote}"/>
            <ComboBox x:Name="Views" Grid.Column="1" ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="120" IsVisible="{Binding HasSeasonCards}"
                      ToolTip.Tip="Each season as the champion's card, or the full table"/>
          </Grid>
          <Panel>
            <ScrollViewer x:Name="SeasonCardsView" IsVisible="{Binding ShowCards}">
              <StackPanel Spacing="6">
                <ItemsControl x:Name="SeasonCards" ItemsSource="{Binding SeasonCards}" ItemTemplate="{StaticResource SeasonCardTemplate}" IsVisible="{Binding HasSeasonCards}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding RealPastTitle}" Classes="h2" IsVisible="{Binding HasRealPast}"/>
                <ItemsControl x:Name="RealPastCards" ItemsSource="{Binding RealPastCards}" ItemTemplate="{StaticResource SeasonCardTemplate}" IsVisible="{Binding HasRealPast}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding RealPastFootnote}" Classes="muted" FontSize="11.5" IsVisible="{Binding HasRealPast}"/>
              </StackPanel>
            </ScrollViewer>
            <DataGrid x:Name="SeasonsTable" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowTable}">
              <DataGrid.Columns>
                <!-- Run 76: the scoring leader moved to the cards so "Your record" fits at 1480 px with the assistant. -->
                <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="76"/>
                <DataGridTextColumn Header="Champion" Binding="{Binding Champion}" Width="190"/>
                <DataGridTextColumn Header="Runner-up" Binding="{Binding RunnerUp}" Width="190"/>
                <DataGridTextColumn Header="MVP" Binding="{Binding Mvp}" Width="160"/>
                <DataGridTextColumn Header="Finals MVP" Binding="{Binding FinalsMvp}" Width="160"/>
                <DataGridTextColumn Header="Your record" Binding="{Binding OurRecord}" Width="*" MinWidth="150"/>
              </DataGrid.Columns>
            </DataGrid>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Records book" IsVisible="{Binding ShowProTabs}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="Single game (regular season)" Classes="h2"/>
            <ItemsControl x:Name="GameRecordCards" ItemsSource="{Binding GameRecordsSet}" ItemTemplate="{StaticResource RecordCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding GameRecordsToSet}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       IsVisible="{Binding GameRecordsToSet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="Single season" Classes="h2"/>
            <ItemsControl x:Name="SeasonRecordCards" ItemsSource="{Binding SeasonRecordsSet}" ItemTemplate="{StaticResource RecordCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding SeasonRecordsToSet}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       IsVisible="{Binding SeasonRecordsToSet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="Career (including this season)" Classes="h2"/>
            <ItemsControl x:Name="CareerRecordCards" ItemsSource="{Binding CareerRecordsSet}" ItemTemplate="{StaticResource RecordCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding CareerRecordsToSet}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       IsVisible="{Binding CareerRecordsToSet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="NBA history" IsVisible="{Binding IsReal}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding RealSummary}" TextWrapping="Wrap"/>
            <TextBlock Text="Records to beat" Classes="h2"/>
            <TextBlock Text="Single game" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding RealGameRecords}" ItemTemplate="{StaticResource RealCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Single season" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding RealSeasonRecords}" ItemTemplate="{StaticResource RealCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Career" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding RealCareerRecords}" ItemTemplate="{StaticResource RealCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Championships by franchise" Classes="h2"/>
            <ItemsControl ItemsSource="{Binding RealTitles}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RealTitlesRow">
                  <Border Classes="panel" Classes.mine="{Binding Ours}" Width="230" Margin="0,0,8,8" Padding="0">
                    <Border BorderBrush="{Binding Stripe}" BorderThickness="4,0,0,0" CornerRadius="5" Padding="8,6">
                      <Grid ColumnDefinitions="40,*">
                        <c:TeamLogo Team="{Binding Club}" ShowText="False" Width="36" Height="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                          <TextBlock Text="{Binding Team}" FontSize="12" TextWrapping="Wrap" Classes.accent="{Binding Ours}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Titles}" FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="{Binding Last, StringFormat='titles · last {0}'}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Every season" Classes="h2"/>
            <DataGrid ItemsSource="{Binding RealSeasons}" Height="520">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="90"/>
                <DataGridTextColumn Header="Champion" Binding="{Binding Champion}" Width="220"/>
                <DataGridTextColumn Header="Runner-up" Binding="{Binding RunnerUp}" Width="220"/>
                <DataGridTextColumn Header="Finals MVP" Binding="{Binding FinalsMvp}" Width="200"/>
                <DataGridTextColumn Header="MVP" Binding="{Binding Mvp}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding RealSource}" Classes="muted" FontSize="10.5" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Milestones" IsVisible="{Binding ShowProTabs}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="Career milestones as they happen: 5,000 points and every 5,000 after, rebounds, assists and games played." Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="No milestones yet. They come as careers grow." Classes="muted" IsVisible="{Binding !HasMilestones}"/>
            <ItemsControl ItemsSource="{Binding Milestones}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- K12b (run 137): the college game's records book and every national champion since 1985 (a real world). -->
      <TabItem Header="College records" IsVisible="{Binding IsCollege}">
        <ScrollViewer x:Name="CollegeRecordsView">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding CollegeRecordsNote}" TextWrapping="Wrap"/>
            <TextBlock Text="Programs" Classes="h2"/>
            <ItemsControl x:Name="CollegeRecordCards" ItemsSource="{Binding CollegeRecords}" ItemTemplate="{StaticResource RecordCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Every national champion" Classes="h2" IsVisible="{Binding HasCollegeChampions}"/>
            <DataGrid x:Name="CollegeChampionsTable" ItemsSource="{Binding CollegeChampions}" Height="520" IsVisible="{Binding HasCollegeChampions}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="80"/>
                <DataGridTextColumn Header="Champion" Binding="{Binding Champion}" Width="150"/>
                <DataGridTextColumn Header="Runner-up" Binding="{Binding RunnerUp}" Width="150"/>
                <DataGridTextColumn Header="Final" Binding="{Binding Score}" Width="100"/>
                <DataGridTextColumn Header="Final Four" Binding="{Binding FinalFour}" Width="220"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="120"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding CollegeSource}" Classes="muted" FontSize="10.5" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- W2 (run 225): the yearly almanac. Editions down the left, newest first; the chosen one as a magazine page. -->
      <TabItem Header="Almanac">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="AlmanacNote" Text="{Binding AlmanacNote}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Grid ColumnDefinitions="170,*" IsVisible="{Binding HasAlmanacs}">
            <ListBox x:Name="AlmanacEditions" ItemsSource="{Binding Almanacs}" SelectedItem="{Binding SelectedAlmanac}" VerticalAlignment="Top">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AlmanacCard">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Cover}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" x:Name="AlmanacPage" Margin="12,0,0,0">
              <StackPanel Spacing="10" DataContext="{Binding SelectedAlmanac}" x:DataType="vm:AlmanacCard" MaxWidth="900" HorizontalAlignment="Left">
                <Border Classes="panel" Padding="0">
                  <Border BorderBrush="{Binding Stripe}" BorderThickness="0,6,0,0" CornerRadius="5" Padding="16,12">
                    <Grid ColumnDefinitions="64,*">
                      <Panel Width="58" Height="58" VerticalAlignment="Center">
                        <c:TeamLogo Team="{Binding Champion}" ShowText="False" ShowRank="False" Width="56" Height="56" IsVisible="{Binding HasCrest}"/>
                        <c:Icon Kind="Trophy" Width="34" Height="34" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding !HasCrest}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" Classes="muted" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"/>
                        <TextBlock x:Name="AlmanacCover" Text="{Binding Cover}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <ItemsControl x:Name="AlmanacSections" ItemsSource="{Binding Sections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:AlmanacSection">
                      <Border Classes="panel" Margin="0,0,0,10" Padding="14,10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Classes="h2"/>
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
