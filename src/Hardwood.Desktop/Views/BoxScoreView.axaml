<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.BoxScoreView"
             x:DataType="vm:BoxScoreViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="BoxGrid" x:DataType="vm:BoxLineRow"/>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Spacing="10">
      <Border CornerRadius="10" ClipToBounds="True" Height="104">
        <Grid>
          <c:CourtBackdrop Intensity="0.7" Glow="{DynamicResource HwAccent}"/>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,16,0" VerticalAlignment="Center">
              <c:TeamLogo Team="{Binding AwayTeam}" Width="64" Height="64"/>
              <c:TeamLogo Team="{Binding HomeTeam}" Width="64" Height="64"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="Bold"/>
              <TextBlock Text="{Binding Periods}" FontFamily="Consolas,Menlo,monospace" Classes="muted"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Back" Command="{Binding BackCommand}" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>

      <c:StatStrip ItemsSource="{Binding Leaders}" Accent="{DynamicResource HwAccent}"/>
      <!-- Game flow (roadmap 2): how the game went, not just how it ended -->
      <Border Classes="panel" Padding="8" IsVisible="{Binding HasFlow}">
        <StackPanel Spacing="8">
          <TextBlock Text="Game flow" FontWeight="SemiBold" Margin="4,0"/>
          <c:StatStrip ItemsSource="{Binding FlowChips}" Accent="{DynamicResource HwAccent}"/>
          <Grid x:Name="FlowRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <c:GameFlowChart x:Name="FlowChart" Result="{Binding Result}" HomeColor="{Binding FlowHome}" AwayColor="{Binding FlowAway}" Height="190" MinWidth="240"/>
            <StackPanel x:Name="FlowSide" Grid.Column="1" Margin="14,10,4,0" Spacing="10" MaxWidth="340">
              <ItemsControl ItemsSource="{Binding Splits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SplitRow">
                    <StackPanel Orientation="Horizontal" Margin="0,2" Opacity="{Binding Opacity}">
                      <TextBlock Text="{Binding Team}" Width="44" FontWeight="SemiBold" FontSize="12"/>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="30" TextAlignment="Center" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding Total}" Width="34" TextAlignment="Right" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="2" IsVisible="{Binding HasRuns}">
                <TextBlock Text="Runs" Classes="muted" FontSize="11.5"/>
                <ItemsControl ItemsSource="{Binding RunLines}">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasLog}">
        <Border Classes="panel" Padding="6" Margin="0,0,6,0"><StackPanel><TextBlock Text="{Binding AwayName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding AwayZoneAttempts}" Makes="{Binding AwayZoneMakes}" Height="230"/></StackPanel></Border>
        <Border Grid.Column="1" Classes="panel" Padding="6" Margin="6,0,0,0"><StackPanel><TextBlock Text="{Binding HomeName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding HomeZoneAttempts}" Makes="{Binding HomeZoneMakes}" Height="230"/></StackPanel></Border>
      </Grid>
      <c:TeamLink Team="{Binding AwayTeam}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6"/>
      <c:StatStrip ItemsSource="{Binding AwayChips}" Accent="{Binding AwayAccent}"/>
      <DataGrid ItemsSource="{Binding Away}" Height="300">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
          <DataGridCheckBoxColumn Header="St" Binding="{Binding Started}" Width="66"/>
          <DataGridTextColumn Header="MIN" Binding="{Binding Min}" Width="66"/>
          <DataGridTextColumn Header="PTS" Binding="{Binding Pts}" Width="66"/>
          <DataGridTextColumn Header="FG" Binding="{Binding FG}" Width="66"/>
          <DataGridTextColumn Header="3P" Binding="{Binding TP}" Width="66"/>
          <DataGridTextColumn Header="FT" Binding="{Binding FT}" Width="66"/>
          <DataGridTextColumn Header="REB" Binding="{Binding Reb}" Width="66"/>
          <DataGridTextColumn Header="AST" Binding="{Binding Ast}" Width="66"/>
          <DataGridTextColumn Header="STL" Binding="{Binding Stl}" Width="66"/>
          <DataGridTextColumn Header="BLK" Binding="{Binding Blk}" Width="66"/>
          <DataGridTextColumn Header="TO" Binding="{Binding Tov}" Width="66"/>
          <DataGridTextColumn Header="PF" Binding="{Binding PF}" Width="66"/>
          <DataGridTextColumn Header="+/-" Binding="{Binding PM}" Width="66"/>
        </DataGrid.Columns>
      </DataGrid>

      <c:TeamLink Team="{Binding HomeTeam}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6"/>
      <c:StatStrip ItemsSource="{Binding HomeChips}" Accent="{Binding HomeAccent}"/>
      <DataGrid ItemsSource="{Binding Home}" Height="300">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
          <DataGridCheckBoxColumn Header="St" Binding="{Binding Started}" Width="66"/>
          <DataGridTextColumn Header="MIN" Binding="{Binding Min}" Width="66"/>
          <DataGridTextColumn Header="PTS" Binding="{Binding Pts}" Width="66"/>
          <DataGridTextColumn Header="FG" Binding="{Binding FG}" Width="66"/>
          <DataGridTextColumn Header="3P" Binding="{Binding TP}" Width="66"/>
          <DataGridTextColumn Header="FT" Binding="{Binding FT}" Width="66"/>
          <DataGridTextColumn Header="REB" Binding="{Binding Reb}" Width="66"/>
          <DataGridTextColumn Header="AST" Binding="{Binding Ast}" Width="66"/>
          <DataGridTextColumn Header="STL" Binding="{Binding Stl}" Width="66"/>
          <DataGridTextColumn Header="BLK" Binding="{Binding Blk}" Width="66"/>
          <DataGridTextColumn Header="TO" Binding="{Binding Tov}" Width="66"/>
          <DataGridTextColumn Header="PF" Binding="{Binding PF}" Width="66"/>
          <DataGridTextColumn Header="+/-" Binding="{Binding PM}" Width="66"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Play by play" Classes="h2" IsVisible="{Binding HasLog}"/>
      <Border Classes="panel" IsVisible="{Binding HasLog}" MaxHeight="400">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
