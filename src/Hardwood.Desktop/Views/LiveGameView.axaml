<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.LiveGameView"
             x:DataType="vm:LiveGameViewModel">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="3*,2*">
    <!-- Scoreboard: arena floor, team colours, big score (game-day presentation, decision #69) -->
    <Border Grid.ColumnSpan="2" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,10" Height="118">
      <Grid>
        <c:CourtBackdrop Glow="{Binding HomeColor}" Intensity="0.7"/>
        <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="16,8">
          <!-- Away -->
          <Grid ColumnDefinitions="6,Auto,*,Auto" VerticalAlignment="Center">
            <Border Background="{Binding AwayBrush}" CornerRadius="3"/>
            <c:TeamLogo Grid.Column="1" Team="{Binding AwayTeam}" Width="52" Height="52" Margin="10,0"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding AwayName}" FontSize="22" FontWeight="Bold" MinWidth="58"/>
              <TextBlock Text="AWAY" Classes="muted" FontSize="11" LetterSpacing="2"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding AwayScore}" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
          </Grid>
          <!-- Clock -->
          <Border Grid.Column="1" Background="#C0101318" CornerRadius="8" Padding="16,6" VerticalAlignment="Center" Margin="10,0">
            <StackPanel>
              <TextBlock Text="{Binding Clock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource HwAccentBrush}"/>
              <TextBlock Text="{Binding PeriodLine}" Classes="muted" FontFamily="Consolas,Menlo,monospace" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- Home -->
          <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto,6" VerticalAlignment="Center">
            <TextBlock Text="{Binding HomeScore}" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding HomeName}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" MinWidth="58" TextAlignment="Right"/>
              <TextBlock Text="HOME" Classes="muted" FontSize="11" LetterSpacing="2" HorizontalAlignment="Right"/>
            </StackPanel>
            <c:TeamLogo Grid.Column="2" Team="{Binding HomeTeam}" Width="52" Height="52" Margin="10,0"/>
            <Border Grid.Column="3" Background="{Binding HomeBrush}" CornerRadius="3"/>
          </Grid>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{Binding SpeedLabel}" Command="{Binding CycleSpeedCommand}" MinWidth="80"/>
            <Button Content="Sim to end" Command="{Binding SimToEndCommand}" IsEnabled="{Binding !Complete}"/>
            <Button Classes="primary" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding !Complete}" MinWidth="96">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="{Binding PlayPauseIcon}" Width="15" Height="15" Foreground="#111"/>
                <TextBlock Text="{Binding PlayPauseText}"/>
              </StackPanel>
            </Button>
            <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding Complete}" MinWidth="110"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Play by play -->
    <Border Grid.Row="1" Grid.Column="0" Classes="panel" Margin="0,0,10,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Headline}" Classes="muted" Margin="4,0,4,2"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Classes="accent" Margin="4,0,4,6" TextWrapping="Wrap"/>
        <ListBox ItemsSource="{Binding Log}" Background="Transparent" FontFamily="Consolas,Menlo,monospace" FontSize="12.5">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,-2"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Bench and controls: lineup and tactics on tabs, so tactics never sit below the fold -->
    <TabControl Grid.Row="1" Grid.Column="1" Padding="0">
      <TabItem Header="Lineup">
        <ScrollViewer>
          <StackPanel Spacing="10">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Your five" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Apply lineup" Command="{Binding ApplyLineupCommand}" Padding="10,3"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Lineup}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineupSlot">
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" Margin="0,2">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Your players tonight" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding OurPlayers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <Grid ColumnDefinitions="14,150,*" Margin="0,1">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Line}" Classes="muted" FontSize="11.5"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Opponent on the floor" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding TheirFloor}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <Grid ColumnDefinitions="164,*" Margin="0,1">
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Line}" Classes="muted" FontSize="11.5"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Tactics">
        <ScrollViewer>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Tactics (live)" FontWeight="SemiBold"/>
            <TextBlock Text="Offense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SystemChoices}" SelectedItem="{Binding OffenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Defense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SchemeChoices}" SelectedItem="{Binding DefenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Double their best scorer" IsChecked="{Binding DoubleStar}"/>
            <TextBlock Text="Pace" Classes="muted" FontSize="11.5"/><Slider Minimum="88" Maximum="110" Value="{Binding Pace}"/>
            <TextBlock Text="Three-point emphasis" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding ThreeEmphasis}"/>
            <TextBlock Text="Offensive glass" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding CrashGlass}"/>
            <TextBlock Text="Defensive aggression" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding Aggression}"/>
            <TextBlock Text="Star usage" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding StarUsage}"/>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
