<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             xmlns:v="using:Hardwood.Desktop.Views"
             x:Class="Hardwood.Desktop.Views.LiveGameView"
             x:DataType="vm:LiveGameViewModel" Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}"/>
    <KeyBinding Gesture="OemPlus" Command="{Binding SpeedUpCommand}"/>
    <KeyBinding Gesture="Add" Command="{Binding SpeedUpCommand}"/>
    <KeyBinding Gesture="OemMinus" Command="{Binding SpeedDownCommand}"/>
    <KeyBinding Gesture="Subtract" Command="{Binding SpeedDownCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseDrawerCommand}"/>
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Border.hud"><Setter Property="Background" Value="#E60A0C12"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Button.speed"><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.tab"><Setter Property="Padding" Value="10,4"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  </UserControl.Styles>
  <!-- M1 of the 2D match engine (run 148, claude/match-engine-2d-design.md): the whole page is the court, top down, in
       real time. The score bar sits on top, the controls and speeds in the corners, the drawers on the right and the
       commentary bar at the bottom. Every result still comes from the game engine. -->
  <Panel x:Name="RootGrid" Background="#12161D" ClipToBounds="True">
    <c:MatchCourt x:Name="Match" Frame="{Binding MatchFrame}" Dress="{Binding FloorDress}" Markings="{Binding Markings}"
                  HomeKit="{Binding HomeKit}" HomeTrim="{Binding HomeKitTrim}" AwayKit="{Binding AwayKit}" AwayTrim="{Binding AwayKitTrim}"
                  Numbers="{Binding Numbers}"/>

    <!-- The score bar: rank, crest, team and score each side; the period and clock; team fouls, the bonus and what each side runs. -->
    <Border x:Name="ScoreBar" Classes="hud" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{x:Static v:LiveGameView.ScoreMargin}" Padding="8,8,8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
        <Border Background="{Binding AwayBrush}" CornerRadius="7" Padding="10,4" MinWidth="{x:Static v:LiveGameView.SideBlockWidth}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="{Binding AwayRank}" IsVisible="{Binding AwayRanked}" FontSize="13" FontWeight="Bold" Foreground="#F2D58A" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <c:TeamLogo Grid.Column="1" Team="{Binding AwayTeam}" ShowText="False" Width="30" Height="30" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="{Binding AwayName}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="AwayScoreText" Grid.Column="3" Text="{Binding BarAwayScore}" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" MinWidth="92">
          <TextBlock Text="{Binding BarPeriod}" FontSize="12" FontWeight="Bold" Foreground="#AAB3C2" HorizontalAlignment="Center" LetterSpacing="1"/>
          <TextBlock x:Name="BarClockText" Text="{Binding BarClock}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{Binding HomeBrush}" CornerRadius="7" Padding="10,4" MinWidth="{x:Static v:LiveGameView.SideBlockWidth}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*">
            <TextBlock x:Name="HomeScoreText" Text="{Binding BarHomeScore}" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1" Text="{Binding HomeRank}" IsVisible="{Binding HomeRanked}" FontSize="13" FontWeight="Bold" Foreground="#F2D58A" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <c:TeamLogo Grid.Column="2" Team="{Binding HomeTeam}" ShowText="False" Width="30" Height="30" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="3" Text="{Binding HomeName}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
        <!-- #1064 (run 168): timeouts left, away on the left and home on the right, under the clock. -->
        <TextBlock x:Name="TimeoutsText" Grid.Row="1" Grid.Column="1" Text="{Binding TimeoutsLine}" FontSize="11.5" FontWeight="Bold" Foreground="#AAB3C2"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" ToolTip.Tip="Timeouts left: the away side's, then the home side's"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,0" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="{Binding AwayFouls}" FontSize="11.5" FontWeight="Bold" Foreground="#AAB3C2" VerticalAlignment="Center"/>
            <Border Background="#F0A33A" CornerRadius="3" Padding="6,0" IsVisible="{Binding AwayInBonus}"><TextBlock Text="{Binding AwayBonus}" FontSize="11" FontWeight="Bold" Foreground="#111"/></Border>
          </StackPanel>
          <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,1" HorizontalAlignment="Center"><TextBlock Text="{Binding OffenceTagAway}" FontSize="11" FontWeight="Bold" Foreground="White"/></Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" Margin="0,5,0,0" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Border Background="#F0A33A" CornerRadius="3" Padding="6,0" IsVisible="{Binding HomeInBonus}"><TextBlock Text="{Binding HomeBonus}" FontSize="11" FontWeight="Bold" Foreground="#111"/></Border>
            <TextBlock Text="{Binding HomeFouls}" FontSize="11.5" FontWeight="Bold" Foreground="#AAB3C2" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,1" HorizontalAlignment="Center"><TextBlock Text="{Binding OffenceTagHome}" FontSize="11" FontWeight="Bold" Foreground="White"/></Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Top left: play, step, sim and the break setting, and the speeds under them (Space pauses, + and - change the speed). -->
    <StackPanel x:Name="LeftStack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Spacing="8" Width="{x:Static v:LiveGameView.CornerWidth}">
    <Border x:Name="MatchControls" Classes="hud" Padding="8">
      <StackPanel Spacing="6">
        <WrapPanel x:Name="ScoreButtons">
          <Button Classes="primary" Command="{Binding PlayPauseCommand}" IsVisible="{Binding !Complete}" MinWidth="88" Margin="0,0,6,6" ToolTip.Tip="Play or pause (Space). Keys: 1-4 and K the speeds, + and - faster or slower; B, P, T, S, H, A, G and O the drawers; Esc closes one; M mutes the crowd">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="{Binding PlayPauseIcon}" Width="15" Height="15" Foreground="#111"/>
              <TextBlock Text="{Binding PlayPauseText}"/>
            </StackPanel>
          </Button>
          <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding Complete}" MinWidth="110" Margin="0,0,6,6"/>
          <Button Content="Step" Command="{Binding StepOneCommand}" IsEnabled="{Binding CanStep}" IsVisible="{Binding !Complete}" Margin="0,0,6,6" ToolTip.Tip="Paused: play one possession and stop"/>
          <Button Content="Sim to end" Command="{Binding SimToEndCommand}" IsVisible="{Binding !Complete}" Margin="0,0,6,6"/>
          <Button Content="Break card" Command="{Binding ReopenBreakCommand}" IsVisible="{Binding CanReopenBreak}" Margin="0,0,6,6"/>
          <Button x:Name="SpeedCycle" Content="{Binding SpeedLabel}" Command="{Binding CycleSpeedCommand}" IsVisible="False" MinWidth="64" Margin="0,0,6,6" ToolTip.Tip="The speed: 1×, 2×, 4×, 8× or Key moments (+ and - too)"/>
        </WrapPanel>
        <CheckBox Content="Stop at breaks" IsChecked="{Binding PauseAtBreaks}" Foreground="White" ToolTip.Tip="Pause at the end of each period for the break card"/>
        <!-- M6 (run 153): the crowd's sound. The speaker mutes (M); the slider is the volume. Both are saved, like Settings' switch. -->
        <Grid x:Name="SoundRow" ColumnDefinitions="Auto,*">
          <Button x:Name="SoundButton" Command="{Binding ToggleSoundCommand}" Padding="6,4" Margin="0,0,8,0" ToolTip.Tip="{Binding SoundTip}">
            <c:Icon Kind="{Binding SoundIcon}" Width="16" Height="16" Foreground="White"/>
          </Button>
          <Slider x:Name="SoundSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SoundVolume}" IsEnabled="{Binding SoundOn}" VerticalAlignment="Center" Margin="0,-8" ToolTip.Tip="Crowd volume"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="SpeedBar" Classes="hud" Padding="6">
      <WrapPanel>
        <Button Classes="speed" Classes.primary="{Binding Speed1}" Content="1×" Command="{Binding SetSpeedCommand}" CommandParameter="1" Margin="0,0,4,4" ToolTip.Tip="Real time: the game clock runs as it does in the arena (1)"/>
        <Button Classes="speed" Classes.primary="{Binding Speed2}" Content="2×" Command="{Binding SetSpeedCommand}" CommandParameter="2" Margin="0,0,4,4" ToolTip.Tip="Twice real time (2)"/>
        <Button Classes="speed" Classes.primary="{Binding Speed4}" Content="4×" Command="{Binding SetSpeedCommand}" CommandParameter="4" Margin="0,0,4,4" ToolTip.Tip="Four times real time (3)"/>
        <Button Classes="speed" Classes.primary="{Binding Speed8}" Content="8×" Command="{Binding SetSpeedCommand}" CommandParameter="8" Margin="0,0,4,4" ToolTip.Tip="Eight times real time (4)"/>
        <Button Classes="speed" Classes.primary="{Binding SpeedKey}" Content="Key" Command="{Binding SetSpeedCommand}" CommandParameter="key" Margin="0,0,0,4" ToolTip.Tip="Key moments: baskets, blocks, steals and the late, close possessions, runs and milestones at 2×; the rest flies by (K)"/>
      </WrapPanel>
    </Border>

    <!-- M3 (run 150): the shout bar, FM-style. Each shout moves the levers the engine already reads; tap again to cancel. -->
    <Border x:Name="ShoutBar" Classes="hud" Padding="6" IsVisible="{Binding !Complete}">
      <StackPanel Spacing="4">
        <Button x:Name="ShoutsToggle" Classes="tab" Command="{Binding ToggleShoutsCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Show or fold the shouts">
          <TextBlock Text="{Binding ShoutsHeader}" FontWeight="SemiBold"/>
        </Button>
        <!-- #1064 (run 168): call a timeout at the next dead ball. -->
        <Button x:Name="TimeoutButton" Classes="speed" Command="{Binding CallTimeoutCommand}" IsEnabled="{Binding CanCallTimeout}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,3" ToolTip.Tip="{Binding TimeoutTip}">
          <TextBlock Text="{Binding TimeoutButtonText}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <ItemsControl x:Name="ShoutButtons" ItemsSource="{Binding ShoutRows}" IsVisible="{Binding ShoutsOpen}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShoutRow">
              <Button Classes="speed" Classes.primary="{Binding IsOn}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,3" Padding="4,3"
                      Command="{Binding Toggle}" CommandParameter="{Binding Key}" ToolTip.Tip="{Binding Tip}">
                <TextBlock Text="{Binding Label}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="ActiveShoutsChip" Background="#2A3A24" BorderBrush="#7FC46A" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding HasActiveShouts}">
          <TextBlock Text="{Binding ActiveShoutsLine}" FontSize="11" Foreground="#CFEFC4" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="SubChipBorder" Background="#3A2A12" BorderBrush="#F0A33A" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding HasSubChip}">
          <TextBlock x:Name="SubChipText" Text="{Binding SubChip}" FontSize="11" Foreground="#F6E3B0" TextWrapping="Wrap"/>
        </Border>
        <!-- M5 (run 152): the late-game preset is playing, so the shouts move the base plan for later (run 150's review). -->
        <Border x:Name="ClutchChipBorder" Background="#2A2440" BorderBrush="#A58CF0" BorderThickness="1" CornerRadius="4" Padding="6,2" IsVisible="{Binding HasClutchChip}">
          <TextBlock x:Name="ClutchChipText" Text="{Binding ClutchChip}" FontSize="11" Foreground="#E2D9FF" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Border>
    </StackPanel>

    <!-- The drawers on the right: the box score, the play by play, tactics, subs, shots, stats and the game flow.
         K23 (run 158): the tabs stay up beside an open drawer, and the court fits into the room left (no panel covers it). -->
    <Border x:Name="DrawerTabs" Classes="hud" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="4">
      <StackPanel Spacing="4" Width="{x:Static v:LiveGameView.TabsInner}">
        <Button Classes="tab" Content="Box score" Classes.primary="{Binding Tab0}" Command="{Binding OpenDrawerCommand}" CommandParameter="0" ToolTip.Tip="Box score (B)"/>
        <Button Classes="tab" Content="Play by play" Classes.primary="{Binding Tab1}" Command="{Binding OpenDrawerCommand}" CommandParameter="1" ToolTip.Tip="Play by play (P)"/>
        <Button Classes="tab" Content="Tactics" Classes.primary="{Binding Tab2}" Command="{Binding OpenDrawerCommand}" CommandParameter="2" ToolTip.Tip="Tactics (T)"/>
        <Button Classes="tab" Content="Subs" Classes.primary="{Binding Tab3}" Command="{Binding OpenDrawerCommand}" CommandParameter="3" ToolTip.Tip="Subs (S)"/>
        <Button Classes="tab" Content="Shots" Classes.primary="{Binding Tab4}" Command="{Binding OpenDrawerCommand}" CommandParameter="4" ToolTip.Tip="Shots (H)"/>
        <Button Classes="tab" Content="Stats" Classes.primary="{Binding Tab5}" Command="{Binding OpenDrawerCommand}" CommandParameter="5" ToolTip.Tip="Stats (A)"/>
        <Button Classes="tab" Content="Game flow" Classes.primary="{Binding Tab6}" Command="{Binding OpenDrawerCommand}" CommandParameter="6" ToolTip.Tip="Game flow (G)"/>
        <Button x:Name="FloorTab" Classes="tab" Content="On the floor" Classes.primary="{Binding Tab7}" Command="{Binding OpenDrawerCommand}" CommandParameter="7" ToolTip.Tip="The jumbotron's numbers, momentum and both fives with their energy (O)"/>
      </StackPanel>
    </Border>
    <Border x:Name="Drawer" Classes="hud" Background="#F2141920" HorizontalAlignment="Right" Width="{x:Static v:LiveGameView.DrawerWidth}" Margin="0,124,8,62"
            Padding="8" IsVisible="{Binding DrawerOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,6">
          <TextBlock Text="{Binding DrawerTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Close" Command="{Binding CloseDrawerCommand}" Padding="10,3"/>
        </Grid>
        <TextBlock x:Name="LogHeadline" DockPanel.Dock="Top" Text="{Binding Headline}" Classes="muted" Margin="4,0,4,6" TextWrapping="Wrap"/>
        <Panel>
      <Border x:Name="LogPanel" Padding="4" IsVisible="{Binding DrawerLog}">
        <DockPanel>
          <StackPanel x:Name="LogTabs" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4,0,4,6">
            <Button Content="Play by play" Command="{Binding ToLogCommand}" Classes.primary="{Binding ShowLog}" Padding="10,3"/>
            <Button x:Name="BoxTab" Content="Box score" Command="{Binding ToBoxCommand}" Classes.primary="{Binding ShowBox}" Padding="10,3"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Log}" Background="Transparent" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" IsVisible="{Binding ShowLog}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,-2" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <!-- The tracker's second slice (run 83): a compact live box score beside the court; green dot: on the floor. -->
          <ScrollViewer x:Name="LiveBox" IsVisible="{Binding ShowBox}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,18,0">
                <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,6,0,2">
                  <TextBlock Grid.Column="1" Text="{Binding AwayBoxTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Text="MIN" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="PTS" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="REB" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="AST" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="7" Text="3P" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="8" Text="PF" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                </Grid>
              <ItemsControl ItemsSource="{Binding AwayBox}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveBoxRow">
                    <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,1">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding Pts}" TextAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Grid.Column="4" Text="{Binding Reb}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="5" Text="{Binding Ast}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="6" Text="{Binding Fg}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="7" Text="{Binding Three}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="8" Text="{Binding Pf}" TextAlignment="Right" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
                <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,6,0,2">
                  <TextBlock Grid.Column="1" Text="{Binding HomeBoxTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Text="MIN" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="PTS" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="REB" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="AST" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="7" Text="3P" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="8" Text="PF" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                </Grid>
              <ItemsControl ItemsSource="{Binding HomeBox}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveBoxRow">
                    <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,1">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding Pts}" TextAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Grid.Column="4" Text="{Binding Reb}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="5" Text="{Binding Ast}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="6" Text="{Binding Fg}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="7" Text="{Binding Three}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="8" Text="{Binding Pf}" TextAlignment="Right" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Green dot: on the floor now. The full box score opens after the game." Classes="muted" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    <TabControl x:Name="SideTabs" Padding="0" SelectedIndex="{Binding SideTab}" IsVisible="{Binding DrawerSide}">
      <TabItem Header="Lineup">
        <ScrollViewer>
          <StackPanel Spacing="10">
        <!-- H71 (run 106): after the final the lineup editor is read-only. -->
        <Border Classes="panel" IsEnabled="{Binding !Complete}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Your five" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Apply lineup" Command="{Binding ApplyLineupCommand}" Padding="10,3"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Lineup}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineupSlot">
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" Margin="0,2">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Your players tonight" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding OurPlayers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <Grid ColumnDefinitions="14,*" Margin="0,1">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <!-- The stat line sits beside the name, or under it when the panel is narrow. -->
                    <WrapPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" Width="140" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,2"/>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Opponent on the floor" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding TheirFloor}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <WrapPanel Margin="0,1">
                    <TextBlock Text="{Binding Name}" Width="154" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,2"/>
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Shots">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Border Classes="panel" Padding="6"><StackPanel><TextBlock Text="{Binding AwayName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding AwayZoneAttempts}" Makes="{Binding AwayZoneMakes}" Height="220"/></StackPanel></Border>
            <Border Classes="panel" Padding="6"><StackPanel><TextBlock Text="{Binding HomeName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding HomeZoneAttempts}" Makes="{Binding HomeZoneMakes}" Height="220"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Stats">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Border Classes="panel">
              <StackPanel Spacing="6">
                <TextBlock Text="Highlights so far" FontWeight="SemiBold"/>
                <c:HighlightStrip ItemsSource="{Binding Highlights}"/>
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding AwayName}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding HomeName}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            <ItemsControl ItemsSource="{Binding TeamStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeamStatRow">
                  <StackPanel Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto,*">
                      <TextBlock Text="{Binding AwayText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" FontSize="11" Margin="8,0" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding HomeText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <c:CompareBar Away="{Binding Away}" Home="{Binding Home}" AwayColor="{Binding AwayColor}" HomeColor="{Binding HomeColor}" Margin="0,3,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Tactics">
        <ScrollViewer>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Tactics (live)" FontWeight="SemiBold"/>
            <TextBlock Text="Offense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SystemChoices}" SelectedItem="{Binding OffenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Defense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SchemeChoices}" SelectedItem="{Binding DefenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Double their best scorer" IsChecked="{Binding DoubleStar}"/>
            <TextBlock Text="Pace" Classes="muted" FontSize="11.5"/><Slider Minimum="88" Maximum="110" Value="{Binding Pace}"/>
            <TextBlock Text="Three-point emphasis" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding ThreeEmphasis}"/>
            <TextBlock Text="Offensive glass" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding CrashGlass}"/>
            <TextBlock Text="Defensive aggression" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding Aggression}"/>
            <TextBlock Text="Star usage" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding StarUsage}"/>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
          <ScrollViewer x:Name="FlowDrawer" IsVisible="{Binding DrawerFlow}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="FlowRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <c:GameFlowChart x:Name="FlowChart" Result="{Binding Result}" Version="{Binding FlowVersion}" HomeColor="{Binding FlowHome}" AwayColor="{Binding FlowAway}" Height="150" MinWidth="200"/>
          <ItemsControl x:Name="FlowSplits" Grid.Column="1" ItemsSource="{Binding Splits}" Margin="12,14,4,0" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SplitRow">
                <StackPanel Orientation="Horizontal" Margin="0,2" Opacity="{Binding Opacity}">
                  <TextBlock Text="{Binding Team}" Width="44" FontWeight="SemiBold" FontSize="12"/>
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="30" TextAlignment="Center" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Total}" Width="34" TextAlignment="Right" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Grid>
          </ScrollViewer>
          <!-- M5 (run 152): the arena's jumbotron numbers and the two "On the floor" panels (B2b), now a drawer over the court. -->
          <ScrollViewer x:Name="FloorDrawer" IsVisible="{Binding DrawerFloor}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <Border x:Name="Jumbotron" Background="#F2050608" BorderBrush="#3C434C" BorderThickness="3" CornerRadius="6" Padding="10,4,10,6">
              <StackPanel>
                <TextBlock Text="{Binding BoardTitle}" FontSize="13" FontWeight="Black" Foreground="#FF6A3D" HorizontalAlignment="Center" LetterSpacing="1"/>
                <Grid ColumnDefinitions="90,*,*" Margin="0,2,0,2">
                  <TextBlock Grid.Column="1" Text="{Binding AwayName}" FontSize="13" FontWeight="Black" Foreground="White" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding HomeName}" FontSize="13" FontWeight="Black" Foreground="White" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Border Height="2" Background="#2A3038" Margin="0,0,0,2"/>
                <ItemsControl ItemsSource="{Binding JumboRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JumboRow">
                      <Grid ColumnDefinitions="90,*,*" Height="19">
                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Bold" Foreground="#7D8794" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Away}" FontSize="13" FontWeight="Bold" Foreground="{Binding AwayBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Home}" FontSize="13" FontWeight="Bold" Foreground="{Binding HomeBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <!-- Momentum: the last four minutes played, the away colour from the left and the home colour from the right. -->
            <Border x:Name="MomentumChip" Background="#E60B0E14" CornerRadius="6" Padding="10,3,10,6">
              <StackPanel Spacing="3">
                <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"><Run Text="MOMENTUM (4 MIN) " Foreground="#9AA5B4"/><Run Text="{Binding Momentum.Label}"/></TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Border Width="{Binding MomentumAwayWidth}" Height="6" Background="{Binding AwayBrush}" CornerRadius="3,0,0,3"/>
                  <Border Width="{Binding MomentumHomeWidth}" Height="6" Background="{Binding HomeBrush}" CornerRadius="0,3,3,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="AwayFloorPanel" CornerRadius="6" ClipToBounds="True" Background="#E60B0E14" BorderBrush="#40FFFFFF" BorderThickness="1">
              <StackPanel>
                <Border Background="{Binding AwayBrush}" Padding="8,3">
                  <TextBlock Text="{Binding AwayFloorTitle}" FontSize="12" FontWeight="Black" Foreground="White" LetterSpacing="1"/>
                </Border>
                <Grid ColumnDefinitions="30,*,34,34,34,28,52" Margin="8,3,8,0">
                  <TextBlock Grid.Column="2" Text="PTS" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="REB" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="AST" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="PF" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding AwayFloor}" Margin="8,0,8,6">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FloorPanelRow">
                      <Grid ColumnDefinitions="30,*,34,34,34,28,52" RowDefinitions="Auto,7" Margin="0,1">
                        <TextBlock Text="{Binding Pos}" FontSize="11" FontWeight="Bold" Foreground="#9AA5B4" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Pts}" FontSize="13" FontWeight="Bold" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Reb}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Ast}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding Pf}" FontSize="13" Foreground="{Binding PfBrush}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="{Binding Fg}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <!-- The energy bar: the engine's own energy (green 85%+, yellow 70-84%, red below 70%). -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Width="{x:Static vm:FloorPanelRow.BarMax}" Height="4" CornerRadius="2"
                                Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Width="{Binding BarWidth}" Height="4" CornerRadius="2"
                                Background="{Binding BarBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="HomeFloorPanel" CornerRadius="6" ClipToBounds="True" Background="#E60B0E14" BorderBrush="#40FFFFFF" BorderThickness="1">
              <StackPanel>
                <Border Background="{Binding HomeBrush}" Padding="8,3">
                  <TextBlock Text="{Binding HomeFloorTitle}" FontSize="12" FontWeight="Black" Foreground="White" LetterSpacing="1"/>
                </Border>
                <Grid ColumnDefinitions="30,*,34,34,34,28,52" Margin="8,3,8,0">
                  <TextBlock Grid.Column="2" Text="PTS" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="REB" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="AST" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="PF" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" FontSize="10.5" FontWeight="Bold" Foreground="#9AA5B4" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding HomeFloor}" Margin="8,0,8,6">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FloorPanelRow">
                      <Grid ColumnDefinitions="30,*,34,34,34,28,52" RowDefinitions="Auto,7" Margin="0,1">
                        <TextBlock Text="{Binding Pos}" FontSize="11" FontWeight="Bold" Foreground="#9AA5B4" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Pts}" FontSize="13" FontWeight="Bold" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Reb}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Ast}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding Pf}" FontSize="13" Foreground="{Binding PfBrush}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="{Binding Fg}" FontSize="13" Foreground="White" TextAlignment="Right"/>
                        <!-- The energy bar: the engine's own energy (green 85%+, yellow 70-84%, red below 70%). -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Width="{x:Static vm:FloorPanelRow.BarMax}" Height="4" CornerRadius="2"
                                Background="#30FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Width="{Binding BarWidth}" Height="4" CornerRadius="2"
                                Background="{Binding BarBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The break: the HSN desk at halftime and the final, or the break card, over the court. -->
    <Border x:Name="BreakOverlay" Classes="hud" Background="#F20F1318" IsVisible="{Binding ShowBreak}" HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="{x:Static v:LiveGameView.BreakWidth}" Margin="16,120,16,80" Padding="6">
      <StackPanel>
          <StackPanel x:Name="HalftimeDesk" IsVisible="{Binding DeskUp}" Spacing="4" Margin="4,0,4,4">
            <WrapPanel>
              <TextBlock Text="{Binding DeskName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,2"/>
              <Button Content="Break card" Command="{Binding ToCardCommand}" Padding="8,1" Margin="0,0,6,2" ToolTip.Tip="{Binding CardTip}"/>
              <Button Content="Hide" Command="{Binding HideBreakCommand}" Padding="8,1" Margin="0,0,0,2" ToolTip.Tip="Put the desk away and see the court again; Break card brings it back"/>
              <!-- M1 (run 148): the desk takes the controls' corner, so it carries the way on. -->
              <Button Classes="primary" Content="Play on" Command="{Binding PlayPauseCommand}" IsVisible="{Binding !Complete}" Padding="10,1" Margin="6,0,0,2" ToolTip.Tip="Put the desk away and play the next period"/>
              <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding Complete}" Padding="10,1" Margin="6,0,0,2" ToolTip.Tip="Record the result and move on"/>
            </WrapPanel>
            <v:StudioDeskView x:Name="HalftimeSet" DataContext="{Binding HalftimeReel}" HorizontalAlignment="Left"/>
          </StackPanel>
          <ScrollViewer x:Name="BreakCard" IsVisible="{Binding CardUp}" MaxHeight="{x:Static v:LiveGameView.BreakCardMax}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Background="#141920" BorderBrush="{DynamicResource HwAccentBrush}" BorderThickness="0,3,0,0"
                  CornerRadius="6" Padding="10,8" Margin="4,0,4,4">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
              <WrapPanel>
                <TextBlock Text="{Binding BreakTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding PeriodLine}" Classes="muted" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center"/>
              </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Top">
                  <Button Content="{Binding DeskButton}" Command="{Binding ToDeskCommand}" IsVisible="{Binding HasDesk}" Padding="8,1"
                          ToolTip.Tip="{Binding DeskButtonTip}"/>
                  <Button Content="Hide" Command="{Binding HideBreakCommand}" Padding="8,1"
                          ToolTip.Tip="Put the card away and see the court again; Break card brings it back"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding BreakLine}" TextWrapping="Wrap"/>
              <!-- D75 A (run 69): the assistant's halftime read as a one-click suggestion. -->
              <Border IsVisible="{Binding HasReadSuggestion}" Background="#1C2430" BorderBrush="#E0A93B" BorderThickness="3,0,0,0"
                      CornerRadius="4" Padding="10,6" Margin="0,2,0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReadTitle}" FontWeight="Bold" Foreground="#E0A93B"/>
                    <TextBlock Text="{Binding ReadLine}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReadNote}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Apply the read" Command="{Binding ApplyReadCommand}" IsVisible="{Binding CanApplyRead}" Classes="primary"/>
                    <Button Content="Undo" Command="{Binding UndoReadCommand}" IsVisible="{Binding ReadApplied}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <c:StatStrip ItemsSource="{Binding BreakChips}" Accent="{DynamicResource HwAccent}"/>
            </StackPanel>
          </Border>
          </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- The commentary bar: one line at a time, bold for the big moments; the run alert at the right. -->
    <Border x:Name="CommentaryBar" VerticalAlignment="Bottom" Background="{Binding CommentaryBrush}" BorderBrush="{Binding HomeTrimBrush}" BorderThickness="0,3,0,0" MinHeight="54">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="16,6">
        <TextBlock x:Name="CommentaryTag" Text="HSN LIVE" FontSize="13" FontWeight="Bold" Foreground="#F6E3B0" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock x:Name="CommentaryText" Grid.Column="1" Text="{Binding Commentary}" FontSize="20" FontWeight="{Binding CommentaryWeight}" Foreground="White"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Border Grid.Column="2" Background="#3A2A12" BorderBrush="#F0A33A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="16,0,0,0" IsVisible="{Binding HasRunAlert}" VerticalAlignment="Center">
          <TextBlock Text="{Binding RunAlert}" Foreground="#F0A33A" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <TextBlock x:Name="LogStatus" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="#F6E3B0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding HasStatus}" Margin="0,2,0,0"/>
      </Grid>
    </Border>
  </Panel>
</UserControl>
