<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             xmlns:v="using:Hardwood.Desktop.Views"
             x:Class="Hardwood.Desktop.Views.LiveGameView"
             x:DataType="vm:LiveGameViewModel">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*" ColumnDefinitions="3*,2*">
    <!-- Scoreboard: arena floor, team colours, big score (game-day presentation, decision #69) -->
    <Border Grid.ColumnSpan="2" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,10" MinHeight="118">
      <Grid>
        <c:CourtBackdrop Glow="{Binding HomeColor}" Intensity="0.7"/>
        <!-- College games: the home program's own court from Danny's pack (run 45), dimmed so the score reads. -->
        <Border Background="{Binding CourtBrush}" IsVisible="{Binding HasCourt}"/>
        <Border Background="#8C0B0E12" IsVisible="{Binding HasCourt}"/>
        <StackPanel VerticalAlignment="Center">
        <Grid x:Name="ScoreRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="16,8,16,4">
        <Grid x:Name="ScoreLine" ColumnDefinitions="*,Auto,*" MinHeight="100">
          <!-- Away -->
          <Grid ColumnDefinitions="6,Auto,*,Auto" VerticalAlignment="Center">
            <Border Background="{Binding AwayBrush}" CornerRadius="3"/>
            <c:TeamLogo x:Name="AwayLogo" Grid.Column="1" Team="{Binding AwayTeam}" Width="52" Height="52" Margin="10,0"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding AwayName}" FontSize="22" FontWeight="Bold" MinWidth="58"/>
              <TextBlock Text="AWAY" Classes="muted" FontSize="11" LetterSpacing="2"/>
            </StackPanel>
            <TextBlock x:Name="AwayScoreText" Grid.Column="3" Text="{Binding AwayScore}" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
          </Grid>
          <!-- Clock -->
          <Border Grid.Column="1" Background="#C0101318" CornerRadius="8" Padding="16,6" VerticalAlignment="Center" Margin="10,0">
            <StackPanel>
              <TextBlock Text="{Binding Clock}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource HwAccentBrush}"/>
              <TextBlock Text="{Binding PeriodLine}" Classes="muted" FontFamily="Consolas,Menlo,monospace" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- Home -->
          <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto,6" VerticalAlignment="Center">
            <TextBlock x:Name="HomeScoreText" Text="{Binding HomeScore}" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding HomeName}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" MinWidth="58" TextAlignment="Right"/>
              <TextBlock Text="HOME" Classes="muted" FontSize="11" LetterSpacing="2" HorizontalAlignment="Right"/>
            </StackPanel>
            <c:TeamLogo x:Name="HomeLogo" Grid.Column="2" Team="{Binding HomeTeam}" Width="52" Height="52" Margin="10,0"/>
            <Border Grid.Column="3" Background="{Binding HomeBrush}" CornerRadius="3"/>
          </Grid>
        </Grid>
          <StackPanel x:Name="ScoreButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{Binding SpeedLabel}" Command="{Binding CycleSpeedCommand}" MinWidth="80"/>
            <Button Content="Step" Command="{Binding StepOneCommand}" IsEnabled="{Binding CanStep}" ToolTip.Tip="Paused: play one possession and stop"/>
            <Button Content="Sim to end" Command="{Binding SimToEndCommand}" IsEnabled="{Binding !Complete}"/>
            <CheckBox Content="Stop at breaks" IsChecked="{Binding PauseAtBreaks}" VerticalAlignment="Center" ToolTip.Tip="Pause at the end of each period for the break card"/>
            <Button Classes="primary" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding !Complete}" MinWidth="96">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="{Binding PlayPauseIcon}" Width="15" Height="15" Foreground="#111"/>
                <TextBlock Text="{Binding PlayPauseText}"/>
              </StackPanel>
            </Button>
            <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding Complete}" MinWidth="110"/>
          </StackPanel>
        </Grid>
        <!-- Stat ticker (match day part 2): one fact at a time, moving on as the game goes; click for the next. -->
        <Button Classes="flat" Command="{Binding NextFactCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#B0101318" CornerRadius="0" Padding="16,4" ToolTip.Tip="Next fact">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" LetterSpacing="1.5" Foreground="#F85149" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Ticker}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="LeftCol" Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,10,0">
      <!-- On the floor (Danny, run 45: the whole court, every shot as it happens) and the game flow (roadmap 2: win
           probability and momentum, quarter splits, run alerts) share one panel, so the play by play keeps its room. -->
      <Border x:Name="CourtPanel" Classes="panel" Padding="8" Margin="0,0,0,10">
        <StackPanel Spacing="4">
          <WrapPanel Margin="4,0,4,4">
            <Button Content="On the floor" Command="{Binding ToCourtCommand}" Classes.primary="{Binding ShowCourt}" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button Content="Game flow" Command="{Binding ToFlowCommand}" Classes.primary="{Binding ShowFlow}" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Border Background="#26303B" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock FontSize="11.5"><Run Text="Win chance " Foreground="#8B96A5"/><Run Text="{Binding WinChance}" FontWeight="SemiBold"/></TextBlock>
            </Border>
            <Border Background="#3A2A12" BorderBrush="#F0A33A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" IsVisible="{Binding HasRunAlert}" VerticalAlignment="Center">
              <TextBlock Text="{Binding RunAlert}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0A33A"/>
            </Border>
            <!-- The big view (run 85, tracker slice 3): the court takes the window's room; the play by play folds under it. -->
            <Button x:Name="BigCourtButton" Content="{Binding BigCourtLabel}" Command="{Binding ToggleBigCourtCommand}" IsVisible="{Binding CourtShown}" Padding="10,3" VerticalAlignment="Center"
                    ToolTip.Tip="Bigger: the court fills the room the window has and the play by play folds under it. Smaller: the court keeps 300 px."/>
          </WrapPanel>
          <!-- Match day part 3: the break card, like a broadcast's quarter-break graphic. -->
          <!-- Scrolls rather than being cut when its chips wrap onto extra lines (big text, narrow window). -->
          <!-- H57 (run 86): at a break the card takes the court's place in this panel (Hide, On the floor or Game flow bring the
               court back), so the play by play and box score under it keep all their rows. -->
          <ScrollViewer x:Name="BreakCard" IsVisible="{Binding ShowBreak}" MaxHeight="{x:Static v:LiveGameView.BreakCardMax}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Background="#141920" BorderBrush="{DynamicResource HwAccentBrush}" BorderThickness="0,3,0,0"
                  CornerRadius="6" Padding="10,8" Margin="4,0,4,4">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
              <WrapPanel>
                <TextBlock Text="{Binding BreakTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding PeriodLine}" Classes="muted" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center"/>
              </WrapPanel>
                <Button Grid.Column="1" Content="Hide" Command="{Binding HideBreakCommand}" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Top"
                        ToolTip.Tip="Hide the card and see the court again; Play goes on to the next period"/>
              </Grid>
              <TextBlock Text="{Binding BreakLine}" TextWrapping="Wrap"/>
              <!-- D75 A (run 69): the assistant's halftime read as a one-click suggestion. -->
              <Border IsVisible="{Binding HasReadSuggestion}" Background="#1C2430" BorderBrush="#E0A93B" BorderThickness="3,0,0,0"
                      CornerRadius="4" Padding="10,6" Margin="0,2,0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReadTitle}" FontWeight="Bold" Foreground="#E0A93B"/>
                    <TextBlock Text="{Binding ReadLine}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReadNote}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Apply the read" Command="{Binding ApplyReadCommand}" IsVisible="{Binding CanApplyRead}" Classes="primary"/>
                    <Button Content="Undo" Command="{Binding UndoReadCommand}" IsVisible="{Binding ReadApplied}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <c:StatStrip ItemsSource="{Binding BreakChips}" Accent="{DynamicResource HwAccent}"/>
            </StackPanel>
          </Border>
          </ScrollViewer>
          <!-- The 2D tracker (D67 B, run 80): the latest play in words over the court that draws it. -->
          <TextBlock x:Name="PlayCaptionText" Text="{Binding PlayCaption}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding CourtShown}"/>
          <Grid IsVisible="{Binding CourtShown}" HorizontalAlignment="Center">
            <c:LiveCourt x:Name="Court" Floor="{Binding HomeCourt}" Shots="{Binding CourtShots}" Version="{Binding CourtVersion}"
                         HomeColor="{Binding HomeDot}" AwayColor="{Binding AwayDot}" MaxHeight="300" Frame="{Binding Frame}" MotionMs="{Binding MotionMs}"
                         FloorColor="{Binding FloorColor}" FloorTrim="{Binding FloorTrim}" FloorName="{Binding FloorName}"/>
            <!-- The home club's logo at centre court (the pack's own courts already carry theirs). -->
            <c:TeamLogo Team="{Binding HomeTeam}" Width="40" Height="40" Opacity="0.85" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasCourt}"/>
          </Grid>
          <TextBlock Text="{Binding CourtLegend}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding CourtShown}"/>
          <Grid x:Name="FlowRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding FlowShown}">
          <c:GameFlowChart x:Name="FlowChart" Result="{Binding Result}" Version="{Binding FlowVersion}" HomeColor="{Binding FlowHome}" AwayColor="{Binding FlowAway}" Height="150" MinWidth="200"/>
          <ItemsControl x:Name="FlowSplits" Grid.Column="1" ItemsSource="{Binding Splits}" Margin="12,14,4,0" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SplitRow">
                <StackPanel Orientation="Horizontal" Margin="0,2" Opacity="{Binding Opacity}">
                  <TextBlock Text="{Binding Team}" Width="44" FontWeight="SemiBold" FontSize="12"/>
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="30" TextAlignment="Center" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Total}" Width="34" TextAlignment="Right" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Grid>
        </StackPanel>
      </Border>


      <!-- Play by play (folds under the big court, keeping at least LiveGameView.MinLogHeight) -->
      <Border x:Name="LogPanel" Grid.Row="1" Classes="panel" Padding="8">
        <DockPanel>
          <StackPanel x:Name="LogTabs" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4,0,4,6">
            <Button Content="Play by play" Command="{Binding ToLogCommand}" Classes.primary="{Binding ShowLog}" Padding="10,3"/>
            <Button x:Name="BoxTab" Content="Box score" Command="{Binding ToBoxCommand}" Classes.primary="{Binding ShowBox}" Padding="10,3"/>
          </StackPanel>
          <TextBlock x:Name="LogHeadline" DockPanel.Dock="Top" Text="{Binding Headline}" Classes="muted" Margin="4,0,4,2" TextWrapping="Wrap"/>
          <TextBlock x:Name="LogStatus" DockPanel.Dock="Top" Text="{Binding Status}" Classes="accent" Margin="4,0,4,6" TextWrapping="Wrap"/>
          <ListBox ItemsSource="{Binding Log}" Background="Transparent" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" IsVisible="{Binding ShowLog}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,-2" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <!-- The tracker's second slice (run 83): a compact live box score beside the court; green dot: on the floor. -->
          <ScrollViewer x:Name="LiveBox" IsVisible="{Binding ShowBox}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,18,0">
                <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,6,0,2">
                  <TextBlock Grid.Column="1" Text="{Binding AwayBoxTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Text="MIN" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="PTS" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="REB" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="AST" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="7" Text="3P" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="8" Text="PF" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                </Grid>
              <ItemsControl ItemsSource="{Binding AwayBox}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveBoxRow">
                    <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,1">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding Pts}" TextAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Grid.Column="4" Text="{Binding Reb}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="5" Text="{Binding Ast}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="6" Text="{Binding Fg}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="7" Text="{Binding Three}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="8" Text="{Binding Pf}" TextAlignment="Right" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
                <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,6,0,2">
                  <TextBlock Grid.Column="1" Text="{Binding HomeBoxTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="2" Text="MIN" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="PTS" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="REB" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="AST" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="FG" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="7" Text="3P" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                  <TextBlock Grid.Column="8" Text="PF" Classes="muted" FontSize="10.5" TextAlignment="Right"/>
                </Grid>
              <ItemsControl ItemsSource="{Binding HomeBox}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveBoxRow">
                    <Grid ColumnDefinitions="10,*,34,34,34,34,48,48,28" Margin="0,1">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="3" Text="{Binding Pts}" TextAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Grid.Column="4" Text="{Binding Reb}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="5" Text="{Binding Ast}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="6" Text="{Binding Fg}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="7" Text="{Binding Three}" TextAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Column="8" Text="{Binding Pf}" TextAlignment="Right" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Green dot: on the floor now. The full box score opens after the game." Classes="muted" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Bench and controls: lineup and tactics on tabs, so tactics never sit below the fold -->
    <TabControl Grid.Row="1" Grid.Column="1" Padding="0">
      <TabItem Header="Lineup">
        <ScrollViewer>
          <StackPanel Spacing="10">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Your five" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Apply lineup" Command="{Binding ApplyLineupCommand}" Padding="10,3"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Lineup}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineupSlot">
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" Margin="0,2">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="4">
            <TextBlock Text="Your players tonight" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding OurPlayers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <Grid ColumnDefinitions="14,*" Margin="0,1">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource HwGoodBrush}" IsVisible="{Binding OnCourt}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    <!-- The stat line sits beside the name, or under it when the panel is narrow. -->
                    <WrapPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" Width="140" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,2"/>
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Opponent on the floor" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding TheirFloor}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OnCourtRow">
                  <WrapPanel Margin="0,1">
                    <TextBlock Text="{Binding Name}" Width="154" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,2"/>
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Shots">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Border Classes="panel" Padding="6"><StackPanel><TextBlock Text="{Binding AwayName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding AwayZoneAttempts}" Makes="{Binding AwayZoneMakes}" Height="220"/></StackPanel></Border>
            <Border Classes="panel" Padding="6"><StackPanel><TextBlock Text="{Binding HomeName}" FontWeight="SemiBold" Margin="4,0,0,4"/><c:ShotChart Attempts="{Binding HomeZoneAttempts}" Makes="{Binding HomeZoneMakes}" Height="220"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Stats">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Border Classes="panel">
              <StackPanel Spacing="6">
                <TextBlock Text="Highlights so far" FontWeight="SemiBold"/>
                <c:HighlightStrip ItemsSource="{Binding Highlights}"/>
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding AwayName}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding HomeName}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            <ItemsControl ItemsSource="{Binding TeamStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeamStatRow">
                  <StackPanel Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto,*">
                      <TextBlock Text="{Binding AwayText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" FontSize="11" Margin="8,0" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding HomeText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <c:CompareBar Away="{Binding Away}" Home="{Binding Home}" AwayColor="{Binding AwayColor}" HomeColor="{Binding HomeColor}" Margin="0,3,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Tactics">
        <ScrollViewer>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Tactics (live)" FontWeight="SemiBold"/>
            <TextBlock Text="Offense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SystemChoices}" SelectedItem="{Binding OffenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Defense" Classes="muted" FontSize="11.5"/>
            <ComboBox ItemsSource="{Binding SchemeChoices}" SelectedItem="{Binding DefenseChoice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SystemOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Double their best scorer" IsChecked="{Binding DoubleStar}"/>
            <TextBlock Text="Pace" Classes="muted" FontSize="11.5"/><Slider Minimum="88" Maximum="110" Value="{Binding Pace}"/>
            <TextBlock Text="Three-point emphasis" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding ThreeEmphasis}"/>
            <TextBlock Text="Offensive glass" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding CrashGlass}"/>
            <TextBlock Text="Defensive aggression" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding Aggression}"/>
            <TextBlock Text="Star usage" Classes="muted" FontSize="11.5"/><Slider Minimum="0" Maximum="100" Value="{Binding StarUsage}"/>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
