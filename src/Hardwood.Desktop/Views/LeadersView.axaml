<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             x:Class="Hardwood.Desktop.Views.LeadersView"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:DataType="vm:LeadersViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="League Leaders" Classes="h1" Margin="0"/>
        <TextBlock Text="{Binding Note}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <ComboBox x:Name="LeagueBox" ItemsSource="{Binding LeagueNames}" SelectedItem="{Binding LeagueName}" MinWidth="200" MaxWidth="320"
                  IsVisible="{Binding HasLeagueChoice}" ToolTip.Tip="Your league first; the NBA's leaders are one pick away"/>
        <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="130"/>
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="150" IsVisible="{Binding ShowTable}"/>
      </StackPanel>
    </Grid>
    <!-- Run 64 (review #13 rank 3): a card per stat, the leader big; the table below is one click away. -->
    <Panel>
    <ScrollViewer IsVisible="{Binding ShowCards}" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="LeaderCards" ItemsSource="{Binding Cards}" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="300" MaxColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LeaderCard"><c:LeaderCardView/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <DockPanel IsVisible="{Binding ShowTable}">
    <c:ColumnPicker DockPanel.Dock="Top" Key="leaders" Target="{Binding #LeadersGrid}"
                    Presets="Scoring=Team,Pos,GP,MPG,PPG,FG%,3P%|All-round=Team,Pos,GP,PPG,RPG,APG,SPG,BPG"/>
    <DataGrid x:Name="LeadersGrid" ItemsSource="{Binding Rows}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="66"/>
        <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="200"/>
        <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="64"/>
        <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
        <DataGridTextColumn Header="GP" Binding="{Binding GP}" Width="66"/>
        <DataGridTextColumn Header="MPG" Binding="{Binding MPG}" Width="66"/>
        <DataGridTextColumn Header="PPG" Binding="{Binding PPG}" Width="66"/>
        <DataGridTextColumn Header="RPG" Binding="{Binding RPG}" Width="66"/>
        <DataGridTextColumn Header="APG" Binding="{Binding APG}" Width="66"/>
        <DataGridTextColumn Header="SPG" Binding="{Binding SPG}" Width="66"/>
        <DataGridTextColumn Header="BPG" Binding="{Binding BPG}" Width="66"/>
        <DataGridTextColumn Header="FG%" Binding="{Binding FG}" Width="66"/>
        <DataGridTextColumn Header="3P%" Binding="{Binding TP}" Width="66"/>
      </DataGrid.Columns>
    </DataGrid>
    </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
