<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.StartView"
             x:DataType="vm:StartViewModel">
  <Grid>
  <c:CourtBackdrop/>
  <Grid Margin="40">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="330" MaxWidth="390"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" Margin="0,0,24,0">
    <StackPanel Spacing="14" VerticalAlignment="Center" Margin="0,0,14,0">
      <c:Wordmark Size="48" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <TextBlock Text="A basketball management universe. Pick a franchise, set your rotation, and build a dynasty one day at a time." Classes="muted" TextWrapping="Wrap"/>

      <Border Classes="panel">
        <StackPanel Spacing="6">
          <TextBlock Text="Your coach" Classes="h2" Margin="0"/>
          <Grid ColumnDefinitions="*,8,*">
            <TextBox Text="{Binding CoachFirst}" Watermark="First name"/>
            <TextBox Grid.Column="2" Text="{Binding CoachLast}" Watermark="Last name"/>
          </Grid>
          <Grid ColumnDefinitions="*,8,130">
            <ComboBox ItemsSource="{Binding Nationalities}" SelectedItem="{Binding CoachNationality}" HorizontalAlignment="Stretch"/>
            <NumericUpDown Grid.Column="2" Value="{Binding CoachAge}" Minimum="28" Maximum="75" FormatString="0" ToolTip.Tip="Age" Watermark="Age"/>
          </Grid>
          <Grid ColumnDefinitions="*,8,*">
            <StackPanel>
              <TextBlock Text="Playing background" Classes="muted" FontSize="11"/>
              <ComboBox ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding CoachBackground}" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Coaching licence" Classes="muted" FontSize="11"/>
              <ComboBox ItemsSource="{Binding Licences}" SelectedItem="{Binding CoachLicence}" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding CoachAttrs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CoachAttrRow">
                <Grid ColumnDefinitions="*,30,34,30" Margin="0,1" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="−" Command="{Binding DownCommand}" Padding="0" Width="28" Height="26" FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Button Grid.Column="3" Content="+" Command="{Binding UpCommand}" Padding="0" Width="28" Height="26" FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding PointsText}" Classes="muted" FontSize="11.5"/>
          <TextBlock Text="Ratings run 5-20. A better playing background and licence give you more points and a bigger reputation, which opens doors when you look for work." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="New career" Classes="h2" Margin="0"/>
          <CheckBox Content="Real world" IsChecked="{Binding RealWorld}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding WorldText}" Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="World seed" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SeedText}"/>
            <Button Grid.Column="2" Content="Random" Command="{Binding RandomSeedCommand}"/>
            <TextBlock Grid.Row="1" Text="Save file" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SavePath}"/>
          </Grid>
          <TextBlock Text="The seed decides every team and player in the world. The same seed always builds the same world." Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
          <TextBlock Text="Full match engine for (others get quick results):" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Leagues}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LeagueChoice"><CheckBox Content="{Binding Name}" IsChecked="{Binding FullSim}" Margin="0,0,12,0" FontSize="12"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primary" Content="Start career with selected team" Command="{Binding NewGameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Load career" Classes="h2" Margin="0"/>
          <TextBox Text="{Binding LoadPath}"/>
          <Button Content="Load" Command="{Binding LoadGameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
      <ContentControl Content="{Binding Graphics}"/>
      <TextBlock Text="{Binding Status}" Classes="bad" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="panel" Padding="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10,12,6">
          <TextBlock Text="{Binding ChooseTitle}" Classes="h2" Margin="0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="League" Classes="muted" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding PlayLeagues}" SelectedItem="{Binding PlayLeague}" MinWidth="200"/>
          </StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" BorderThickness="0" RowHeight="50">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="48">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamChoice"><c:TeamLogo Team="{Binding Team}" Width="32" Height="32" ShowText="False" Margin="4,2"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Review #11 (run 33): two lines per cell, so nothing is cut off at 1280 px or at 130%. -->
            <DataGridTemplateColumn Header="Team" Width="5*" MinWidth="212" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamChoice">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Conference}" Classes="muted" FontSize="11.5"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Outlook" Width="4*" MinWidth="164" SortMemberPath="CoreCa">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamChoice">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Strength}"/>
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Best player" Width="4*" MinWidth="160" SortMemberPath="Star">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TeamChoice">
                  <StackPanel VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Star}"/>
                    <TextBlock Text="{Binding StarDetail}" Classes="muted" FontSize="11.5"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
  </Grid>
</UserControl>
