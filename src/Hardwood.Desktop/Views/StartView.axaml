<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             x:Class="Hardwood.Desktop.Views.StartView"
             x:DataType="vm:StartViewModel">
  <Grid ColumnDefinitions="*,2*" Margin="40">
    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,30,0" VerticalAlignment="Center">
      <TextBlock Text="HARDWOOD MANAGER" FontSize="30" FontWeight="Bold" Classes="accent"/>
      <TextBlock Text="A basketball management universe. Pick a franchise, set your rotation, and build a dynasty one day at a time." Classes="muted" TextWrapping="Wrap"/>

      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="New career" Classes="h2" Margin="0"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="World seed" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SeedText}"/>
            <Button Grid.Column="2" Content="Random" Command="{Binding RandomSeedCommand}"/>
            <TextBlock Grid.Row="1" Text="Save file" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SavePath}"/>
          </Grid>
          <TextBlock Text="The seed decides every team and player in the world. The same seed always builds the same world." Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
          <Button Classes="primary" Content="Start career with selected team" Command="{Binding NewGameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Load career" Classes="h2" Margin="0"/>
          <TextBox Text="{Binding LoadPath}"/>
          <Button Content="Load" Command="{Binding LoadGameCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Status}" Classes="bad" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Column="1" Classes="panel" Padding="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Choose your franchise" Classes="h2" Margin="12,10,12,6"/>
        <DataGrid ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Team" Binding="{Binding Name}" Width="64"/>
            <DataGridTextColumn Header="Conference" Binding="{Binding Conference}" Width="150"/>
            <DataGridTextColumn Header="Outlook" Binding="{Binding Strength}" Width="150"/>
            <DataGridTextColumn Header="Core ability" Binding="{Binding CoreCa, StringFormat={}{0:F0}}" Width="90"/>
            <DataGridTextColumn Header="Payroll" Binding="{Binding Payroll}" Width="84"/>
            <DataGridTextColumn Header="Best player" Binding="{Binding Star}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
