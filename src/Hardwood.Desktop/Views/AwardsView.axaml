<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.AwardsView"
             x:DataType="vm:AwardsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="HonourChipTemplate" x:DataType="vm:HonourChip">
      <Border Classes="honourChip" Classes.mine="{Binding Mine}" Margin="0,0,6,6" ToolTip.Tip="{Binding Name}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Avatar Player="{Binding Player}" Team="{Binding Club}" Width="26" Height="26" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Team}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
          <c:Icon Kind="Star" Width="13" Height="13" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding Star}" VerticalAlignment="Center" ToolTip.Tip="{Binding StarTip}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:CompetitionBadge Kind="Finals" Width="48" Height="48" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Headline}" Classes="h1" Margin="0"/>
          <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <ComboBox x:Name="Views" ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="120" IsVisible="{Binding HasSeason}" ToolTip.Tip="The winners as cards, or the full vote tables"/>
          <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding Season}" Width="200"/>
        </StackPanel>
      </Grid>

      <Border Classes="panel" IsVisible="{Binding HasEmptyNote}">
        <Grid ColumnDefinitions="Auto,*">
          <c:Icon Kind="History" Width="20" Height="20" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Top" Margin="0,0,10,0"/>
          <TextBlock x:Name="EmptyNote" Grid.Column="1" Text="{Binding EmptyNote}" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <!-- Run 75 (review #13 rank 12): the winners as trophy cards, each vote as a ladder of bars, the teams as chips. -->
      <StackPanel x:Name="CardsView" Spacing="10" IsVisible="{Binding ShowCards}">
        <ItemsControl x:Name="WinnerCards" ItemsSource="{Binding Winners}" IsVisible="{Binding HasWinners}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WinnerCard">
              <Border Classes="panel" Classes.mine="{Binding Mine}" Width="268" MinHeight="150" Margin="0,0,10,10" Padding="0" ToolTip.Tip="{Binding Tip}">
                <Border BorderBrush="{Binding Stripe}" BorderThickness="0,5,0,0" CornerRadius="5" Padding="12,8,12,10">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Award}" Classes="accent" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="64,*">
                      <Panel Width="60" Height="60" VerticalAlignment="Top">
                        <c:Avatar Player="{Binding Player}" Team="{Binding Club}" Width="60" Height="60" IsVisible="{Binding HasPortrait}"/>
                        <c:TeamLogo Team="{Binding Club}" ShowText="False" Width="56" Height="56" IsVisible="{Binding IsCoach}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TeamLine}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StatLine}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Vote}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding HasVote}"/>
                  </StackPanel>
                </Border>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4" IsVisible="{Binding HasLadders}">
          <TextBlock Text="The vote" Classes="h2" Margin="0"/>
          <ItemsControl x:Name="LadderCards" ItemsSource="{Binding Ladders}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LadderCard">
                <Border Classes="panel" Width="420" Margin="0,0,10,10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Award}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LadderRow">
                          <Grid ColumnDefinitions="22,*,46,126,40" Margin="0,2" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                            <TextBlock Text="{Binding Rank}" Classes="muted" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Winner, Converter={x:Static c:Converters.BoldIf}}" Classes.accent="{Binding Mine}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Team}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Height="10" CornerRadius="5" Background="#2A333D" VerticalAlignment="Center" Width="120" HorizontalAlignment="Left">
                              <Border Height="10" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{DynamicResource HwAccentBrush}"
                                      Opacity="{Binding BarOpacity}"/>
                            </Border>
                            <TextBlock Grid.Column="4" Text="{Binding Share}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding More}" Classes="muted" FontSize="11" IsVisible="{Binding HasMore}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="panel" IsVisible="{Binding HasAllLeague}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="Award" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding AllLeagueTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <ItemsControl x:Name="AllLeagueLines" ItemsSource="{Binding AllLeagueTeams}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HonourLine">
                  <Grid ColumnDefinitions="100,*" Margin="0,2">
                    <TextBlock Text="{Binding Title}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Players}" ItemTemplate="{StaticResource HonourChipTemplate}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel" IsVisible="{Binding HasAllStarPanel}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:CompetitionBadge Kind="AllStar" Width="22" Height="22"/><TextBlock Text="{Binding AllStarTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Text="{Binding AllStarLine}" TextWrapping="Wrap"/>
            <ItemsControl x:Name="AllStarLines" ItemsSource="{Binding AllStarTeams}" IsVisible="{Binding HasAllStars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HonourLine">
                  <Grid ColumnDefinitions="100,*" Margin="0,2">
                    <TextBlock Text="{Binding Title}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Players}" ItemTemplate="{StaticResource HonourChipTemplate}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- One column (review #13): side by side, real names and stat lines were cut off at 1480 px. -->
      <StackPanel x:Name="TableView" Spacing="10" IsVisible="{Binding ShowTable}">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel>
          <TextBlock Text="{Binding MvpTitle}" Classes="h2"/>
          <DataGrid ItemsSource="{Binding Mvp}" MaxHeight="300" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44"/>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="240"/>
              <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="66"/>
              <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="72"/>
              <DataGridTextColumn Header="Season" Binding="{Binding StatLine}" Width="*" MinWidth="300"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Defensive Player of the Year" Classes="h2"/>
          <DataGrid ItemsSource="{Binding Dpoy}" MaxHeight="220" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44"/>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="240"/>
              <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="66"/>
              <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="72"/>
              <DataGridTextColumn Header="Season" Binding="{Binding StatLine}" Width="*" MinWidth="300"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="{Binding RoyTitle}" Classes="h2"/>
          <DataGrid ItemsSource="{Binding Roy}" MaxHeight="220" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44"/>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="240"/>
              <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="66"/>
              <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="72"/>
              <DataGridTextColumn Header="Season" Binding="{Binding StatLine}" Width="*" MinWidth="300"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Sixth Man of the Year" Classes="h2" IsVisible="{Binding ShowSixth}"/>
          <DataGrid ItemsSource="{Binding SixthMan}" IsVisible="{Binding ShowSixth}" MaxHeight="220" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44"/>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="240"/>
              <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="66"/>
              <DataGridTextColumn Header="Share" Binding="{Binding Share}" Width="72"/>
              <DataGridTextColumn Header="Season" Binding="{Binding StatLine}" Width="*" MinWidth="300"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Grid>

      <Border Classes="panel">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding AllLeagueTitle}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding AllLeague}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"><c:CompetitionBadge Kind="AllStar" Width="22" Height="22"/><TextBlock Text="{Binding AllStarTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="{Binding AllStars}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding ShowHall}">
      <TextBlock Text="Hall of Fame" Classes="h2"/>
      <TextBlock Text="{Binding HallNote}" Classes="muted"/>
      <ItemsControl x:Name="HallCards" ItemsSource="{Binding Hall}" IsVisible="{Binding ShowCards}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HallRow">
            <Border Classes="panel" Width="320" Margin="0,0,10,10">
              <Grid ColumnDefinitions="52,*">
                <c:Avatar Player="{Binding Player}" Team="{Binding Club}" Width="48" Height="48" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Inducted}" Classes="accent" FontSize="12"/>
                  <TextBlock Text="{Binding Career}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Honours}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DataGrid x:Name="HallTable" ItemsSource="{Binding Hall}" MaxHeight="300" IsVisible="{Binding ShowTable}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Inducted" Binding="{Binding Year}" Width="92"/>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="240"/>
          <DataGridTextColumn Header="Career" Binding="{Binding Career}" Width="260"/>
          <DataGridTextColumn Header="Honours" Binding="{Binding Honours}" Width="*"/>
          <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="76"/>
        </DataGrid.Columns>
      </DataGrid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
