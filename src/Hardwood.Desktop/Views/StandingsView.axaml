<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.StandingsView"
             x:DataType="vm:StandingsViewModel">
  <!-- Side by side when there's room for both tables in full; otherwise one above the other (roadmap 1: the two
       tables used to squeeze the team names out entirely at 1480 px with the assistant open). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="0">
    <TextBlock Text="Standings" Classes="h1"/>
    <WrapPanel Margin="0,0,0,8">
      <TextBlock Text="{Binding Note}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowPromotion}" Margin="0,0,12,0">
        <Border Background="{x:Static vm:StandingRow.PromotionBrush}" CornerRadius="3" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock Text="Division winner: promoted" Classes="muted" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
        <Border Background="{x:Static vm:StandingRow.PlayoffBrush}" CornerRadius="3" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock Text="{Binding PlayoffLabel}" Classes="muted" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowPlayIn}" Margin="0,0,12,0">
        <Border Background="{x:Static vm:StandingRow.PlayInBrush}" CornerRadius="3" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock Text="{Binding PlayInLabel}" Classes="muted" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowRelegation}" Margin="0,0,12,0">
        <Border Background="{x:Static vm:StandingRow.RelegationBrush}" CornerRadius="3" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock Text="Last in division: relegated" Classes="muted" VerticalAlignment="Center"/>
      </StackPanel>
      <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding View}" MinWidth="150" IsVisible="{Binding CanDivide}" VerticalAlignment="Center"/>
    </WrapPanel>
    <!-- Danny, #448 / D55: one small table per four-team division, East beside West (stacked when narrow). -->
    <Grid x:Name="Cards" ColumnDefinitions="*,*" IsVisible="{Binding ShowCards}">
      <StackPanel x:Name="LeftCardsPanel" Margin="0,0,8,0">
        <TextBlock Text="{Binding LeftTitle}" Classes="h2" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding LeftCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DivisionCard">
                <Border Classes="panel" Margin="0,0,0,10" Padding="10,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="34,30,*,62,54,44,50" Margin="0,0,0,2">
                      <TextBlock Grid.Column="2" Text="Team" Classes="muted" FontSize="11" Margin="4,0"/>
                      <TextBlock Grid.Column="3" Text="W-L" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="4" Text="Pct" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="5" Text="GB" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="6" Text="L10" Classes="muted" FontSize="11"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StandingRow">
                          <Border Background="{Binding RowBrush}" CornerRadius="4" Padding="0,2">
                            <Grid ColumnDefinitions="34,30,*,62,54,44,50" Height="26">
                              <Border Background="{Binding ZoneBrush}" CornerRadius="4" Width="24" Height="20" HorizontalAlignment="Left" ToolTip.Tip="{Binding ZoneTip}">
                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                              </Border>
                              <c:TeamLogo Grid.Column="1" Team="{Binding Team}" Width="22" Height="22" ShowText="False" HorizontalAlignment="Left"/>
                              <c:TeamLink Grid.Column="2" Team="{Binding Team}" Text="{Binding Label}" FontWeight="{Binding Weight}" VerticalAlignment="Center" Margin="4,0"/>
                              <TextBlock Grid.Column="3" Text="{Binding Record}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="4" Text="{Binding Pct}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="5" Text="{Binding GB}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="6" Text="{Binding Last10}" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel x:Name="RightCardsPanel" Grid.Column="1">
        <TextBlock Text="{Binding RightTitle}" Classes="h2" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding RightCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DivisionCard">
                <Border Classes="panel" Margin="0,0,0,10" Padding="10,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="34,30,*,62,54,44,50" Margin="0,0,0,2">
                      <TextBlock Grid.Column="2" Text="Team" Classes="muted" FontSize="11" Margin="4,0"/>
                      <TextBlock Grid.Column="3" Text="W-L" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="4" Text="Pct" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="5" Text="GB" Classes="muted" FontSize="11"/>
                      <TextBlock Grid.Column="6" Text="L10" Classes="muted" FontSize="11"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StandingRow">
                          <Border Background="{Binding RowBrush}" CornerRadius="4" Padding="0,2">
                            <Grid ColumnDefinitions="34,30,*,62,54,44,50" Height="26">
                              <Border Background="{Binding ZoneBrush}" CornerRadius="4" Width="24" Height="20" HorizontalAlignment="Left" ToolTip.Tip="{Binding ZoneTip}">
                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                              </Border>
                              <c:TeamLogo Grid.Column="1" Team="{Binding Team}" Width="22" Height="22" ShowText="False" HorizontalAlignment="Left"/>
                              <c:TeamLink Grid.Column="2" Team="{Binding Team}" Text="{Binding Label}" FontWeight="{Binding Weight}" VerticalAlignment="Center" Margin="4,0"/>
                              <TextBlock Grid.Column="3" Text="{Binding Record}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="4" Text="{Binding Pct}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="5" Text="{Binding GB}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="6" Text="{Binding Last10}" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
    <Grid x:Name="Tables" ColumnDefinitions="*,*" IsVisible="{Binding ShowTables}">
      <DockPanel x:Name="LeftTable" Margin="0,0,8,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding LeftTitle}" Classes="h2" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding East}" CanUserSortColumns="False" RowHeight="28">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="#" Width="40">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow">
                  <Border Background="{Binding ZoneBrush}" CornerRadius="4" Width="26" Height="20" HorizontalAlignment="Center" ToolTip.Tip="{Binding ZoneTip}">
                    <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="32">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow"><c:TeamLogo Team="{Binding Team}" Width="22" Height="22" ShowText="False" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Team" Width="*" MinWidth="196">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow"><c:TeamLink Team="{Binding Team}" Text="{Binding Label}" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Div" Binding="{Binding Div}" Width="140"/>
            <DataGridTextColumn Header="W" Binding="{Binding W}" Width="38"/>
            <DataGridTextColumn Header="L" Binding="{Binding L}" Width="38"/>
            <DataGridTextColumn Header="Pct" Binding="{Binding Pct}" Width="54"/>
            <DataGridTextColumn Header="GB" Binding="{Binding GB}" Width="48"/>
            <DataGridTextColumn Header="Diff" Binding="{Binding Diff}" Width="58"/>
            <DataGridTextColumn Header="Home" Binding="{Binding Home}" Width="58"/>
            <DataGridTextColumn Header="L10" Binding="{Binding Last10}" Width="48"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <DockPanel x:Name="RightTable" Grid.Column="1" Margin="0,0,0,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding RightTitle}" Classes="h2" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding West}" CanUserSortColumns="False" RowHeight="28">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="#" Width="40">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow">
                  <Border Background="{Binding ZoneBrush}" CornerRadius="4" Width="26" Height="20" HorizontalAlignment="Center" ToolTip.Tip="{Binding ZoneTip}">
                    <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="32">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow"><c:TeamLogo Team="{Binding Team}" Width="22" Height="22" ShowText="False" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Team" Width="*" MinWidth="196">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:StandingRow"><c:TeamLink Team="{Binding Team}" Text="{Binding Label}" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Div" Binding="{Binding Div}" Width="140"/>
            <DataGridTextColumn Header="W" Binding="{Binding W}" Width="38"/>
            <DataGridTextColumn Header="L" Binding="{Binding L}" Width="38"/>
            <DataGridTextColumn Header="Pct" Binding="{Binding Pct}" Width="54"/>
            <DataGridTextColumn Header="GB" Binding="{Binding GB}" Width="48"/>
            <DataGridTextColumn Header="Diff" Binding="{Binding Diff}" Width="58"/>
            <DataGridTextColumn Header="Home" Binding="{Binding Home}" Width="58"/>
            <DataGridTextColumn Header="L10" Binding="{Binding Last10}" Width="48"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
    <StackPanel IsVisible="{Binding HasRace}" Margin="0,4,0,0">
      <TextBlock Text="Conference race: games above .500 by week (your team highlighted)" Classes="h2" Margin="0,0,0,6"/>
      <Border Classes="panel" Padding="6"><c:LineChart Series="{Binding Race}" XLabels="{Binding RaceLabels}" ZeroLine="True" Height="220"/></Border>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
