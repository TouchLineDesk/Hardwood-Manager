<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hardwood.Desktop.ViewModels"
        x:Class="Hardwood.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Hardwood Manager" Width="1480" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- Start screen -->
    <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding !HasSession}"/>

    <!-- Shell -->
    <Grid IsVisible="{Binding HasSession}" RowDefinitions="Auto,*" ColumnDefinitions="210,*">
      <!-- Top bar -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource HwPanelBrush}" BorderBrush="{StaticResource HwBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
            <TextBlock Text="HARDWOOD" FontWeight="Bold" FontSize="15" Classes="accent" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="{Binding TeamText}" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding PhaseText}" Classes="muted" FontSize="11.5"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding RecordText}" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding NextGameText}" Classes="muted" FontSize="11.5"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CheckBox Content="Watch my games" IsChecked="{Binding LiveGames}" IsVisible="{Binding InSeason}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <Button Content="Sim week" Command="{Binding SimWeekCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding ShowSimButtons}"/>
            <Button Content="Sim to next game" Command="{Binding SimToNextGameCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding ShowSimButtons}"/>
            <Button Classes="primary" Content="{Binding ContinueText}" Command="{Binding ContinueCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !InLiveGame}" MinWidth="150"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource HwPanelBrush}" BorderBrush="{StaticResource HwBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="nav" Content="Main menu" Command="{Binding BackToStartCommand}" Foreground="{StaticResource HwMutedBrush}"/>
          <ItemsControl ItemsSource="{Binding Nav}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding Command}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}"/>
                    <Border Grid.Column="1" Background="{StaticResource HwAccentBrush}" CornerRadius="8" Padding="6,0" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Badge}" Foreground="#111" FontSize="11" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- Content -->
      <Border Grid.Row="1" Grid.Column="1" Padding="16">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Background="#80000000" IsVisible="{Binding IsBusy}">
        <TextBlock Text="Simulating…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
      </Border>
    </Grid>
  </Grid>
</Window>
