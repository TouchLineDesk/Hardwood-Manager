<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hardwood.Desktop.ViewModels"
        xmlns:c="using:Hardwood.Desktop.Controls"
        xmlns:v="using:Hardwood.Desktop.Views"
        x:Class="Hardwood.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Hardwood Manager" Width="1480" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <!-- Text and interface size (Settings): scales everything and reflows the layout at the smaller logical width. -->
  <LayoutTransformControl x:Name="ScaleRoot">
  <Grid>
    <!-- Start screen -->
    <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding !HasSession}"/>

    <!-- Shell -->
    <Grid IsVisible="{Binding HasSession}" RowDefinitions="Auto,*" ColumnDefinitions="210,*,Auto">
      <!-- Top bar -->
      <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource HwPanelBrush}" BorderBrush="{StaticResource HwBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <!-- When the two halves don't fit side by side (a big text size, a narrow window), the buttons drop to a
             second row instead of covering the team name or running off the edge (roadmap 1). -->
        <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel x:Name="TopLeft" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
            <c:BallMark Width="34" Height="34" Fill="{DynamicResource HwAccentBrush}"/>
            <c:TeamLogo Team="{Binding Session.HumanTeam}" Width="40" Height="40"/>
            <StackPanel>
              <TextBlock Text="{Binding TeamText}" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding PhaseText}" Classes="muted" FontSize="11.5"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding RecordText}" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{Binding NextGameText}" Classes="muted" FontSize="11.5"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="TopRight" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CheckBox Content="Watch games" ToolTip.Tip="Watch your own games live" IsChecked="{Binding LiveGames}" IsVisible="{Binding InSeason}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Classes="nav" Command="{Binding GoBoardCommand}" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip.Tip="Board confidence: open the Board page">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="Shield" Width="15" Height="15" Foreground="{Binding JobBrush}"/>
                <TextBlock Text="{Binding JobText}" Foreground="{Binding JobBrush}" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <ToggleButton Classes="nav" IsChecked="{Binding Guide.On}" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Turn your assistant on or off">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="Lightbulb" Width="15" Height="15" Foreground="{DynamicResource HwAccentBrush}"/>
                <TextBlock Text="Assistant" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </ToggleButton>
            <TextBlock Text="{Binding PortraitStatus}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <Button Content="Sim week" Command="{Binding SimWeekCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding ShowSimButtons}"/>
            <Button Content="Next game" ToolTip.Tip="Sim to your next game" Command="{Binding SimToNextGameCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding ShowSimButtons}"/>
            <Button Classes="primary" Content="{Binding ContinueText}" Command="{Binding ContinueCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !InLiveGame}" MinWidth="150"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource HwPanelBrush}" BorderBrush="{StaticResource HwBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="nav" Command="{Binding BackToStartCommand}" Foreground="{StaticResource HwMutedBrush}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Kind="LogOut" Width="17" Height="17" Margin="0,0,10,0" Stroke="1.8" Foreground="{StaticResource HwMutedBrush}"/>
              <TextBlock Text="Main menu"/>
            </StackPanel>
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Nav}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding Command}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,10,0" Stroke="1.8" VerticalAlignment="Center"
                            Foreground="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                    <Border Grid.Column="2" Background="{DynamicResource HwAccentBrush}" CornerRadius="8" Padding="6,0" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Badge}" Foreground="#111" FontSize="11" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Content -->
      <Border Grid.Row="1" Grid.Column="1" Padding="16">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>

      <!-- Assistant (decisions #115-118) -->
      <v:GuidePanel Grid.Row="1" Grid.Column="2" DataContext="{Binding Guide}"/>

      <Border Grid.Row="1" Grid.Column="1" Background="#80000000" IsVisible="{Binding IsBusy}">
        <TextBlock Text="Simulating…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
      </Border>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
