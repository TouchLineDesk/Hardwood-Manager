<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             x:Class="Hardwood.Desktop.Views.RotationView"
             x:DataType="vm:RotationViewModel">
  <Grid>
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Rotation" Classes="h1" Margin="0"/>
          <TextBlock Text="Starters by position, then minutes for everyone who plays. The engine follows these targets and adjusts for fatigue and foul trouble." Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Suggest rotation" Command="{Binding AutoRotationCommand}" VerticalAlignment="Top"/>
      </Grid>
      <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,10">
        <ItemsControl ItemsSource="{Binding Starters}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StarterSlot">
              <StackPanel Margin="4,0" Spacing="4">
                <TextBlock Text="{Binding Label}" Classes="muted" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
        <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" Classes.good="{Binding TotalOk}" Classes.bad="{Binding !TotalOk}"/>
        <TextBlock Text="{Binding Status}" Classes="bad"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="False" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76" IsReadOnly="True"/>
          <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="66" IsReadOnly="True"/>
          <DataGridCheckBoxColumn Header="Starter" Binding="{Binding IsStarter}" Width="80" IsReadOnly="True"/>
          <DataGridTemplateColumn Header="Minutes" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RotationRow">
                <Grid ColumnDefinitions="*,40" Margin="4,0">
                  <Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Minutes}" IsEnabled="{Binding Healthy}"/>
                  <TextBlock Grid.Column="1" Text="{Binding MinutesText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="100" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

  </Grid>
</UserControl>
