<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.TransactionsView"
             x:DataType="vm:TransactionsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Transactions" Classes="h1" Margin="0"/>
      <TextBlock Text="{Binding CapText}" Classes="muted"/>
      <TextBlock Text="{Binding DeadlineText}" Classes="muted"/>
    </StackPanel>
    <TabControl SelectedIndex="{Binding Tab}">
      <TabItem Header="Transfer market">
        <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,*">
          <!-- Wraps rather than running under the side panel at big text sizes (roadmap 1). -->
          <!-- Run 65 (review #13 rank 4): positions as chips with counts; cards first, the table one click away. -->
          <StackPanel Spacing="2" Margin="0,0,0,6">
            <WrapPanel>
              <ComboBox ItemsSource="{Binding MarketLeagues}" SelectedItem="{Binding MarketLeague}" MinWidth="170" Margin="0,0,8,4"/>
              <TextBlock Text="Min CA" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,4"/>
              <NumericUpDown Value="{Binding MinAbility}" Minimum="40" Maximum="200" Increment="5" Width="120" FormatString="0" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding MarketViews}" SelectedItem="{Binding MarketView}" Width="120" Margin="0,0,8,4"/>
              <TextBlock Text="{Binding TransferBudgetText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"/>
            </WrapPanel>
            <ItemsControl x:Name="PositionChips" ItemsSource="{Binding PositionChips}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <Button Classes="filter" Classes.on="{Binding Selected}" Margin="0,0,6,4" ToolTip.Tip="{Binding Tip}"
                          Tag="{Binding Name}" Click="OnPositionClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Record}" Classes="filterRecord"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Panel Grid.Row="1">
          <DockPanel IsVisible="{Binding ShowMarketCards}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding MarketCardsNote}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="MarketCards" ItemsSource="{Binding MarketCards}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="290" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketRow">
                    <Button Classes="marketCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="OnCardClick"
                            ToolTip.Tip="Pick him to see the deal and bid">
                      <Border BorderBrush="{Binding Team, Converter={x:Static c:Converters.TeamAccentBrush}}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto">
                            <c:Avatar Grid.RowSpan="2" Player="{Binding Player}" Team="{Binding Team}" Width="52" Height="52" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" ToolTip.Tip="{Binding Name}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,1,6,0" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                              <Grid ColumnDefinitions="Auto,*">
                                <c:TeamLogo Team="{Binding Team}" Width="16" Height="16" ShowText="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ClubName}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClubName}"/>
                              </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="Current ability as your scouts see him">
                              <TextBlock Text="{Binding CA}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                              <TextBlock Text="CA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                          <WrapPanel>
                            <Border Background="{Binding StanceBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding HasStance}" ToolTip.Tip="{Binding StanceTip}">
                              <TextBlock Text="{Binding Stance}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Background="{Binding InterestBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding InterestTip}">
                              <TextBlock Text="{Binding InterestChip}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <Border Background="#2A3440" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding HasClause}" ToolTip.Tip="A release clause can't be refused">
                              <TextBlock Text="{Binding ClauseChip}" FontSize="11"/>
                            </Border>
                            <Border Background="#2E8B57" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding Agreed}">
                              <TextBlock Text="Fee agreed" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                          </WrapPanel>
                          <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding FeeLine}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ContractLine}" ToolTip.Tip="His contract: wage a season × years left" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
          <DockPanel IsVisible="{Binding ShowMarketTable}">
          <c:ColumnPicker DockPanel.Dock="Top" Key="market" Target="{Binding #MarketGrid}"
                          Presets="Scouting=Pos,Age,CA,PA,Club,Contract|The deal=Pos,Age,CA,Joins?,Club stance,Likely fee,Contract,Clause"/>
          <DataGrid x:Name="MarketGrid" ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedMarket}">
            <DataGrid.Columns>
              <!-- The deal columns sit before Club (critic review #6): at 1480 px Club stance ran off the table's edge. -->
              <!-- Real names (R2) need 188 px: "Shai Gilgeous-Alexander"; the number columns gave up 4 px each. -->
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="188"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="40"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="40"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="40"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="40"/>
              <DataGridTemplateColumn Header="Joins?" Width="102">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MarketRow">
                    <Border Background="{Binding InterestBrush}" CornerRadius="4" Padding="6,0" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding InterestTip}">
                      <TextBlock Text="{Binding Interest}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Run 65: the club's stance as a coloured chip, not a word repeated down the column. -->
              <DataGridTemplateColumn Header="Club stance" Width="118">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MarketRow">
                    <Border Background="{Binding StanceBrush}" CornerRadius="4" Padding="6,0" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasStance}" ToolTip.Tip="{Binding StanceTip}">
                      <TextBlock Text="{Binding Stance}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Likely fee" Binding="{Binding Ask}" Width="120"/>
              <DataGridTextColumn Header="Club" Binding="{Binding ClubName}" Width="190"/>
              <DataGridTextColumn Header="Contract" Binding="{Binding Contract}" Width="108"/>
              <DataGridTextColumn Header="Clause" Binding="{Binding Clause}" Width="70"/>
              <DataGridTextColumn Header="" Binding="{Binding Status}" Width="SizeToCells" MinWidth="40"/>
            </DataGrid.Columns>
          </DataGrid>
          </DockPanel>
          </Panel>
          <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
            <StackPanel Spacing="10">
              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="ArrowLeftRight" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Make a bid" Classes="h2" Margin="0"/></StackPanel>
                  <TextBlock Text="{Binding WindowText}" Classes="muted" TextWrapping="Wrap"/>
                  <c:StatStrip ItemsSource="{Binding DealChips}" Accent="{DynamicResource HwAccent}"/>
                  <TextBlock Text="{Binding DealText}" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Fee $M" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding BidFee}" Increment="0.05" Minimum="0" FormatString="0.00"/>
                    <Button Grid.Column="2" Classes="primary" Content="Bid" Command="{Binding PlaceBidCommand}" IsEnabled="{Binding SelectedMarket, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a player in the market first" ToolTip.ShowOnDisabled="True" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding DealReply}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}"/>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding Talk}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="My bids">
        <!-- Danny, #447 / D54: every player you've bid for this window, what you offered and how the club took it. -->
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MyBidsText}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <DataGrid ItemsSource="{Binding MyBids}" CanUserSortColumns="False" RowHeight="72">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Player · club" Width="*" MinWidth="226">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MyBidRow">
                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                      <TextBlock Text="{Binding Player}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Club}" Classes="muted" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Your offer" Width="128">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MyBidRow">
                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                      <TextBlock Text="{Binding Offer}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding OfferNote}" Classes="muted" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Their answer" Width="2*" MinWidth="270">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MyBidRow">
                    <StackPanel VerticalAlignment="Center" Margin="4,0" Spacing="1">
                      <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,1" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Reaction}"/>
                      <TextBlock Text="{Binding When}" Classes="muted" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Wages" Binding="{Binding Wages}" Width="104"/>
              <DataGridTemplateColumn Header="" Width="112">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MyBidRow">
                    <Button Content="{Binding ActText}" Command="{Binding Act}" IsVisible="{Binding CanAct}" Padding="8,2" Margin="4,0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Bids for your players">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <TextBlock Text="Clubs bidding for your players. A bid lapses after five days." Classes="muted" Margin="0,0,0,6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Incoming}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="220"/>
              <DataGridTextColumn Header="Club" Binding="{Binding From}" Width="200"/>
              <DataGridTextColumn Header="Bid" Binding="{Binding Fee}" Width="90"/>
              <DataGridTextColumn Header="Your valuation" Binding="{Binding Value}" Width="120"/>
              <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="90"/>
              <DataGridTemplateColumn Header="" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:IncomingRow">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Accept" Command="{Binding Accept}" Padding="8,2"/>
                      <Button Content="Reject" Command="{Binding Reject}" Padding="8,2"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="Recent transfers" Classes="h2" Margin="0,12,0,6"/>
          <ListBox Grid.Row="3" ItemsSource="{Binding RecentTransfers}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Free agents">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,330">
          <TextBlock Text="{Binding FaStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
            <ContentControl Content="{Binding Talk}"/>
          </ScrollViewer>
          <DockPanel Grid.Row="1">
          <c:ColumnPicker DockPanel.Dock="Top" Key="freeagents" Target="{Binding #FreeAgentGrid}"
                          Presets="Quick look=Pos,Age,OVR,Status|Ratings=Pos,Age,OVR,CA,PA,Sho,Ply,Def,Phy"/>
          <DataGrid x:Name="FreeAgentGrid" ItemsSource="{Binding FreeAgents}" SelectedItem="{Binding SelectedFreeAgent}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="192"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="50"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="46"/>
              <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="52"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="52"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="52"/>
              <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="50"/>
              <DataGridTextColumn Header="Ply" Binding="{Binding Ply}" Width="50"/>
              <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="50"/>
              <DataGridTextColumn Header="Phy" Binding="{Binding Phy}" Width="50"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="SizeToCells" MinWidth="60"/>
            </DataGrid.Columns>
          </DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Waive">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="Press Waive beside a player to release him outright: he becomes a free agent and his deal comes off your books." Classes="muted" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="{Binding FaStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,6" IsVisible="{Binding FaStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Ours}" x:Name="WaiveGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="196"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
              <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112"/>
              <DataGridTemplateColumn Header="" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TradePiece">
                    <Button Content="Waive" Command="{Binding Owner.WaiveCommand}" CommandParameter="{Binding}" Padding="8,2"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Trade builder" IsVisible="{Binding TradesOpen}">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Trade partner" VerticalAlignment="Center" Classes="muted"/>
            <ComboBox ItemsSource="{Binding Partners}" SelectedItem="{Binding Partner}" Width="230">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding PartnerDirection}" VerticalAlignment="Center" Classes="muted"/>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,Auto">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="You send" Classes="h2" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Ours}" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="66"/>
                  <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="186" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="56" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="52" IsReadOnly="True"/>
                  <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <TextBlock DockPanel.Dock="Top" Text="You receive" Classes="h2" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Theirs}" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="66"/>
                  <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="186" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="56" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="52" IsReadOnly="True"/>
                  <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OurPicks}" IsReadOnly="False" MaxHeight="150" Margin="0,8,6,0">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="44"/>
                <DataGridTextColumn Header="Your picks" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proj." Binding="{Binding Projected}" Width="66" IsReadOnly="True"/>
                <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TheirPicks}" IsReadOnly="False" MaxHeight="150" Margin="6,8,0,0">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="44"/>
                <DataGridTextColumn Header="Their picks" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proj." Binding="{Binding Projected}" Width="66" IsReadOnly="True"/>
                <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Border Grid.Row="2" Classes="panel">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding VerdictDetail}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Clear" Command="{Binding ClearTradeCommand}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="primary" Content="Propose trade" Command="{Binding ProposeCommand}" IsEnabled="{Binding CanPropose}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
