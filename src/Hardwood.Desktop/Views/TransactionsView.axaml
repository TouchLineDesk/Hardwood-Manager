<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.TransactionsView"
             x:DataType="vm:TransactionsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Transactions" Classes="h1" Margin="0"/>
      <TextBlock Text="{Binding CapText}" Classes="muted"/>
      <TextBlock Text="{Binding DeadlineText}" Classes="muted"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="Transfer market">
        <Grid ColumnDefinitions="*,380" RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding MarketLeagues}" SelectedItem="{Binding MarketLeague}" MinWidth="170"/>
            <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding MarketPosition}" MinWidth="80"/>
            <TextBlock Text="Min CA" Classes="muted" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding MinAbility}" Minimum="40" Maximum="200" Increment="5" Width="120" FormatString="0"/>
            <TextBlock Text="{Binding TransferBudgetText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedMarket}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="150"/>
              <DataGridTextColumn Header="Club" Binding="{Binding ClubName}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="56"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="54"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="80"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="80"/>
              <DataGridTextColumn Header="Contract" Binding="{Binding Contract}" Width="110"/>
              <DataGridTextColumn Header="Value" Binding="{Binding Ask}" Width="90"/>
              <DataGridTextColumn Header="Clause" Binding="{Binding Clause}" Width="80"/>
              <DataGridTextColumn Header="" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
            <StackPanel Spacing="10">
              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="ArrowLeftRight" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Make a bid" Classes="h2" Margin="0"/></StackPanel>
                  <TextBlock Text="{Binding WindowText}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding DealText}" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Fee $M" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding BidFee}" Increment="0.05" Minimum="0" FormatString="0.00"/>
                    <Button Grid.Column="2" Classes="primary" Content="Bid" Command="{Binding PlaceBidCommand}" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding DealReply}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}"/>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding Talk}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Bids for your players">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <TextBlock Text="Clubs bidding for your players. A bid lapses after five days." Classes="muted" Margin="0,0,0,6"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Incoming}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Player}" Width="220"/>
              <DataGridTextColumn Header="Club" Binding="{Binding From}" Width="200"/>
              <DataGridTextColumn Header="Bid" Binding="{Binding Fee}" Width="90"/>
              <DataGridTextColumn Header="Your valuation" Binding="{Binding Value}" Width="120"/>
              <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="90"/>
              <DataGridTemplateColumn Header="" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:IncomingRow">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Accept" Command="{Binding Accept}" Padding="8,2"/>
                      <Button Content="Reject" Command="{Binding Reject}" Padding="8,2"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="Recent transfers" Classes="h2" Margin="0,12,0,6"/>
          <ListBox Grid.Row="3" ItemsSource="{Binding RecentTransfers}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Free agents">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,360">
          <TextBlock Text="{Binding FaStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ScrollViewer Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0">
            <ContentControl Content="{Binding Talk}"/>
          </ScrollViewer>
          <DataGrid Grid.Row="1" ItemsSource="{Binding FreeAgents}" SelectedItem="{Binding SelectedFreeAgent}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66"/>
              <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="84"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
              <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="80"/>
              <DataGridTextColumn Header="Ply" Binding="{Binding Ply}" Width="80"/>
              <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="80"/>
              <DataGridTextColumn Header="Phy" Binding="{Binding Phy}" Width="80"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Waive">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Select a player in 'You send' on the trade builder and use the button below to release him outright." Classes="muted"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Ours}" x:Name="WaiveGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
              <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112"/>
              <DataGridTemplateColumn Header="" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:TradePiece">
                    <Button Content="Waive" Command="{Binding Owner.WaiveCommand}" CommandParameter="{Binding}" Padding="8,2"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Trade builder" IsVisible="{Binding TradesOpen}">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Trade partner" VerticalAlignment="Center" Classes="muted"/>
            <ComboBox ItemsSource="{Binding Partners}" SelectedItem="{Binding Partner}" Width="230">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding PartnerDirection}" VerticalAlignment="Center" Classes="muted"/>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,Auto">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="You send" Classes="h2" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Ours}" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="66"/>
                  <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66" IsReadOnly="True"/>
                  <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="1">
              <TextBlock DockPanel.Dock="Top" Text="You receive" Classes="h2" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Theirs}" IsReadOnly="False">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="66"/>
                  <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66" IsReadOnly="True"/>
                  <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="112" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OurPicks}" IsReadOnly="False" MaxHeight="150" Margin="0,8,6,0">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="44"/>
                <DataGridTextColumn Header="Your picks" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proj." Binding="{Binding Projected}" Width="66" IsReadOnly="True"/>
                <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TheirPicks}" IsReadOnly="False" MaxHeight="150" Margin="6,8,0,0">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Included}" Width="44"/>
                <DataGridTextColumn Header="Their picks" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Proj." Binding="{Binding Projected}" Width="66" IsReadOnly="True"/>
                <DataGridTextColumn Header="Their value" Binding="{Binding Value}" Width="90" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Border Grid.Row="2" Classes="panel">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding VerdictDetail}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Clear" Command="{Binding ClearTradeCommand}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="primary" Content="Propose trade" Command="{Binding ProposeCommand}" IsEnabled="{Binding CanPropose}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
