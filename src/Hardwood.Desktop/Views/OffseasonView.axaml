<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.OffseasonView"
             x:DataType="vm:OffseasonViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
      <TextBlock Text="{Binding Headline}" Classes="h1" Margin="0"/>
      <TextBlock Text="{Binding Instructions}" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding CapText}" IsVisible="{Binding InOffseason}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Status}" Classes="accent"/>
    </StackPanel>

    <Grid ColumnDefinitions="3*,2*" IsVisible="{Binding InOffseason}">
      <TabControl SelectedIndex="{Binding Tab}">
        <TabItem Header="Contracts up" IsEnabled="{Binding ShowContracts}">
          <DataGrid ItemsSource="{Binding Expiring}" SelectedItem="{Binding SelectedExpiring}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="64"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="64"/>
              <DataGridTextColumn Header="Last season" Binding="{Binding LastSeason}" Width="*"/>
              <DataGridTextColumn Header="Asks" Binding="{Binding Ask}" Width="110"/>
              <DataGridTextColumn Header="" Binding="{Binding Fits}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Free agents" IsEnabled="{Binding ShowFreeAgency}">
          <DataGrid ItemsSource="{Binding FreeAgents}" SelectedItem="{Binding SelectedFreeAgent}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="190"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
              <DataGridTextColumn Header="Asks" Binding="{Binding Asks}" Width="112"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
              <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="84"/>
              <DataGridTextColumn Header="Ply" Binding="{Binding Ply}" Width="84"/>
              <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="84"/>
              <DataGridTextColumn Header="Phy" Binding="{Binding Phy}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Overseas (buyouts)" IsVisible="{Binding ShowBuyouts}">
          <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Buy out selected" Command="{Binding BuyOutCommand}"/>
              <TextBlock Text="Players under contract abroad" Classes="h2" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,6"
                       Text="Every overseas contract has a buyout clause. You pay up to the league's buyout allowance; the player pays the rest himself, but only if the move is worth it to him. (The full transfer market comes next.)"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Overseas}" SelectedItem="{Binding SelectedOverseas}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="80"/>
                <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="80"/>
                <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="200"/>
                <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="100"/>
                <DataGridTextColumn Header="Buyout" Binding="{Binding Buyout}" Width="80"/>
                <DataGridTextColumn Header="Can you sign him?" Binding="{Binding Terms}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Your roster">
          <Grid RowDefinitions="Auto,*">
            <Button Content="Release selected" Command="{Binding WaivePlayerCommand}" Margin="0,0,0,6"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedRosterPlayer}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="72"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="100"/>
                <DataGridTextColumn Header="Yrs" Binding="{Binding Years}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Draft" IsVisible="{Binding ShowDraft}">
          <Grid RowDefinitions="Auto,Auto,2*,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Draft selected" Command="{Binding DraftCommand}" IsEnabled="{Binding OnTheClock}"/>
              <TextBlock Text="College draft" Classes="h2" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding DraftText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,6"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding DraftPool}" SelectedItem="{Binding SelectedProspect}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="48"/>
                <DataGridTextColumn Header="Graduate" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
                <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="76"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
                <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
                <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="84"/>
                <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="The order (an equal-odds lottery)" Classes="h2" Margin="0,10,0,4"/>
            <DataGrid Grid.Row="4" ItemsSource="{Binding DraftSlots}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pick" Binding="{Binding Pick}" Width="60"/>
                <DataGridTextColumn Header="" Binding="{Binding Mark}" Width="56"/>
                <DataGridTextColumn Header="Club" Binding="{Binding Team}" Width="*"/>
                <DataGridTextColumn Header="Selection" Binding="{Binding Player}" Width="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
      <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
        <ContentControl Content="{Binding Talk}"/>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
