<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.OffseasonView"
             x:DataType="vm:OffseasonViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
      <TextBlock Text="{Binding Headline}" Classes="h1" Margin="0"/>
      <TextBlock Text="{Binding Instructions}" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding CapText}" IsVisible="{Binding InOffseason}" FontWeight="SemiBold"/>
      <!-- H112 (run 118): a one-line banner; how the cut works is behind "How it works". -->
      <Grid x:Name="RelegationBanner" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left" IsVisible="{Binding HasRelegationText}" ToolTip.Tip="{Binding RelegationDetail}" Background="Transparent">
        <TextBlock Text="{Binding RelegationText}" Classes="bad" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="How it works" Classes="muted" TextDecorations="Underline" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{Binding Status}" Classes="accent"/>
      <!-- Run 67 (review #13 rank 6, Danny's #464): the summer boards as player cards; the full tables one click away. -->
      <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="120" Margin="0,4,0,0" IsVisible="{Binding InOffseason}" ToolTip.Tip="Player cards, or the full tables with every rating"/>
    </StackPanel>

    <Grid ColumnDefinitions="3*,2*" IsVisible="{Binding InOffseason}">
      <TabControl SelectedIndex="{Binding Tab}">
        <TabItem Header="Contracts up" IsEnabled="{Binding ShowContracts}" IsVisible="{Binding ShowTalk}">
          <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowCards}">
            <ItemsControl x:Name="ExpiringCards" ItemsSource="{Binding Expiring}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="270" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpiringRow">
                  <Button Classes="marketCard summerCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Click="OnExpiringClick" ToolTip.Tip="Pick him to talk about a new deal">
                    <Border BorderBrush="{Binding Team, Converter={x:Static c:Converters.TeamAccentBrush}}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="56,*,Auto">
                          <c:Avatar Player="{Binding Player}" Team="{Binding Team}" Width="52" Height="52" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LastSeason}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="Last season, per game"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip.Tip="Current ability">
                            <TextBlock Text="{Binding CA}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="CA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Bars}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SkillBar">
                                <Grid ColumnDefinitions="28,*,Auto" Height="15" Margin="0,0,8,0" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/>
                                  <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        <WrapPanel>
                          <Border Background="#2A3440" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="What his agent asks: wage a season × years">
                            <TextBlock Text="{Binding AskChip}" FontWeight="SemiBold" FontSize="11"/>
                          </Border>
                          <Border Background="{Binding FitBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding FitTip}" IsVisible="{Binding ShowFit}">
                            <TextBlock Text="{Binding Fits}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DataGrid x:Name="ExpiringGrid" ItemsSource="{Binding Expiring}" SelectedItem="{Binding SelectedExpiring}" IsVisible="{Binding ShowTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="64"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="64"/>
              <DataGridTextColumn Header="Last season" Binding="{Binding LastSeason}" Width="*"/>
              <DataGridTextColumn Header="Asks" Binding="{Binding Ask}" Width="110"/>
              <DataGridTextColumn Header="" Binding="{Binding Fits}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          </Panel>
        </TabItem>
        <TabItem Header="Free agents" IsEnabled="{Binding ShowFreeAgency}" IsVisible="{Binding ShowTalk}">
          <Panel>
          <DockPanel IsVisible="{Binding ShowCards}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding FreeAgentNote}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FreeAgentCards" ItemsSource="{Binding FreeAgentCards}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="270" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FreeAgentRow">
                  <Button Classes="marketCard summerCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Click="OnFreeAgentClick" ToolTip.Tip="Pick him to see his ask and make an offer">
                    <Border BorderBrush="{Binding FitBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="56,*,Auto">
                          <c:Avatar Player="{Binding Player}" Width="52" Height="52" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding CardName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CardName}"/>
                            <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip.Tip="Current ability as your scouts see him">
                            <TextBlock Text="{Binding CA}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="CA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Bars}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SkillBar">
                                <Grid ColumnDefinitions="28,*,Auto" Height="15" Margin="0,0,8,0" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/>
                                  <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        <WrapPanel>
                          <Border Background="#2A3440" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding AskTip}">
                            <TextBlock Text="{Binding AskChip}" FontWeight="SemiBold" FontSize="11"/>
                          </Border>
                          <Border Background="{Binding FitBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" ToolTip.Tip="{Binding FitTip}">
                            <TextBlock Text="{Binding FitText}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                          </Border>
                          <Border Background="{x:Static vm:SummerCards.GraduateBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,5,3" IsVisible="{Binding Graduate}" ToolTip.Tip="This year's college graduate, undrafted">
                            <TextBlock Text="Graduate" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </DockPanel>
          <DataGrid x:Name="SummerFreeAgentGrid" ItemsSource="{Binding FreeAgents}" SelectedItem="{Binding SelectedFreeAgent}" IsVisible="{Binding ShowTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="190"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
              <DataGridTextColumn Header="Asks" Binding="{Binding Asks}" Width="112"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
              <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="84"/>
              <DataGridTextColumn Header="Ply" Binding="{Binding Ply}" Width="84"/>
              <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="84"/>
              <DataGridTextColumn Header="Phy" Binding="{Binding Phy}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          </Panel>
        </TabItem>
        <TabItem Header="Overseas (buyouts)" IsVisible="{Binding ShowBuyouts}">
          <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Buy out selected" Command="{Binding BuyOutCommand}" IsEnabled="{Binding SelectedOverseas, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a player in the list first" ToolTip.ShowOnDisabled="True"/>
              <TextBlock Text="Players under contract abroad" Classes="h2" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,6"
                       Text="Every overseas contract has a buyout clause. You pay up to the league's buyout allowance; the player pays the rest himself, but only if the move is worth it to him. (The full transfer market comes next.)"/>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Overseas}" SelectedItem="{Binding SelectedOverseas}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="80"/>
                <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="80"/>
                <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="200"/>
                <DataGridTextColumn Header="Contract" Binding="{Binding Salary}" Width="100"/>
                <DataGridTextColumn Header="Buyout" Binding="{Binding Buyout}" Width="80"/>
                <DataGridTextColumn Header="Can you sign him?" Binding="{Binding Terms}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Your roster">
          <Grid RowDefinitions="Auto,Auto,*">
            <Button Content="Release selected" IsVisible="{Binding CanReleaseFromRoster}" Command="{Binding WaivePlayerCommand}" IsEnabled="{Binding SelectedRosterPlayer, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a player in the list first" ToolTip.ShowOnDisabled="True" Margin="0,0,0,6"/>
            <!-- H24: Release asks before it cuts anyone. -->
            <Border x:Name="ReleaseConfirm" Grid.Row="1" Classes="panel" Margin="0,0,0,6" IsVisible="{Binding ConfirmingRelease}" BorderBrush="{DynamicResource HwAccentBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Kind="TriangleAlert" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ReleaseQuestion}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                  <Button Content="Keep him" Command="{Binding CancelReleaseCommand}"/>
                  <Button Classes="primary" Content="Release him" Command="{Binding ConfirmReleaseCommand}"/>
                </StackPanel>
              </Grid>
            </Border>
            <DataGrid x:Name="SummerRosterGrid" Grid.Row="2" ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedRosterPlayer}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="72"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="100"/>
                <DataGridTextColumn Header="Yrs" Binding="{Binding Years}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Draft" IsVisible="{Binding ShowDraft}">
          <Grid RowDefinitions="Auto,Auto,2*,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="{Binding DraftButton}" Command="{Binding DraftCommand}" IsEnabled="{Binding OnTheClock}" IsVisible="{Binding ShowTalk}" ToolTip.Tip="Your turn comes in the lottery's order" ToolTip.ShowOnDisabled="True"/>
              <TextBlock Text="College draft" Classes="h2" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,4,0,6" Spacing="2">
              <TextBlock Text="{Binding DraftText}" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Text="{Binding DraftHint}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding DraftHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Text="{Binding DraftNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowCards}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowCards}">
              <ItemsControl x:Name="DraftCards" ItemsSource="{Binding DraftCards}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="270" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProspectRow">
                    <Button Classes="marketCard summerCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="OnProspectClick" ToolTip.Tip="Put him top of your board">
                      <Border BorderBrush="{DynamicResource HwAccentBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="Auto,56,*,Auto">
                            <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Your scouts' rank: potential first"/>
                            <c:Avatar Grid.Column="1" Player="{Binding Player}" Width="52" Height="52" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                              <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                              <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="Current ability as your scouts see him">
                                <Run Text="CA "/><Run Text="{Binding CA}" FontWeight="SemiBold"/>
                              </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip.Tip="{Binding PaTip}">
                              <TextBlock Text="{Binding PA}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                              <TextBlock Text="PA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Bars}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SkillBar">
                                <Grid ColumnDefinitions="28,*,Auto" Height="15" Margin="0,0,8,0" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/>
                                  <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <DataGrid x:Name="DraftGrid" Grid.Row="2" ItemsSource="{Binding DraftPool}" SelectedItem="{Binding SelectedProspect}" IsVisible="{Binding ShowTable}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="48"/>
                <DataGridTextColumn Header="Graduate" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="60"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="56"/>
                <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="76"/>
                <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
                <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
                <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="84"/>
                <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="The order (an equal-odds lottery)" Classes="h2" Margin="0,10,0,4"/>
            <DataGrid Grid.Row="4" ItemsSource="{Binding DraftSlots}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pick" Binding="{Binding Pick}" Width="60"/>
                <DataGridTextColumn Header="" Binding="{Binding Mark}" Width="56"/>
                <DataGridTextColumn Header="Club" Binding="{Binding Team}" Width="*"/>
                <DataGridTextColumn Header="Selection" Binding="{Binding Player}" Width="240"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
      <ScrollViewer Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding ShowTalkPanel}">
        <ContentControl Content="{Binding Talk}"/>
      </ScrollViewer>
      <!-- H18 (run 100): on the Draft tab, the picked graduate's scouting card in place of the last contract talk. -->
      <ScrollViewer x:Name="ProspectPanel" Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding ShowProspectPanel}">
        <Border Classes="panel" VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Kind="GraduationCap" Width="20" Height="20" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="Scouting report" Classes="h2" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Pick a graduate on the board to see your scouts' report." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasProspect}"/>
            <ContentControl x:Name="ProspectCard" Content="{Binding SelectedProspect}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ProspectRow">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="56,*,Auto,Auto">
                <c:Avatar Player="{Binding Player}" Width="52" Height="52" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock x:Name="ProspectName" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding BoardLine}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Current ability as your scouts see him">
                  <TextBlock Text="{Binding CA}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                  <TextBlock Text="CA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip.Tip="{Binding PaTip}">
                  <TextBlock Text="{Binding PA}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                  <TextBlock Text="PA" Classes="muted" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Bars}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SkillBar">
                    <Grid ColumnDefinitions="28,*,Auto" Height="16" Margin="0,0,8,0" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/>
                      <c:RatingBar Grid.Column="1" Value="{Binding Value}" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ScoutLine}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
            </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock x:Name="ProspectHint" Text="{Binding DraftHint}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}" IsVisible="{Binding DraftHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- H37 (run 79): a college coach's summer in place of contract talks. -->
      <Border x:Name="CollegeSummerPanel" Grid.Column="1" Margin="12,0,0,0" Classes="panel" VerticalAlignment="Top" IsVisible="{Binding CollegeSummer}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="GraduationCap" Width="20" Height="20" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Your program's summer" Classes="h2" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding CollegeSummerText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
