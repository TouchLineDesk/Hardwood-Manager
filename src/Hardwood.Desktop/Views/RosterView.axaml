<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.RosterView"
             x:DataType="vm:RosterViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <c:TeamLogo Team="{Binding Team}" Width="56" Height="56" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Team.FullName}" Classes="h1" Margin="0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ToggleButton Content="Cards" IsChecked="{Binding CardView}"/>
        <TextBlock Text="Team" VerticalAlignment="Center" Classes="muted"/>
        <ComboBox ItemsSource="{Binding Teams}" SelectedItem="{Binding Team}" Width="220">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Open player" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}"/>
      </StackPanel>
    </Grid>
    <c:StatStrip DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Accent="{Binding Accent}" Margin="0,0,0,4"/>
    <ScrollViewer IsVisible="{Binding CardView}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlayerRow">
            <c:PlayerCard Player="{Binding Player}" Team="{Binding TeamObj}" Knowledge="{Binding Knowledge}" Footer="{Binding CardFooter}" Width="180" Height="268" Margin="0,0,10,10"
                          DoubleTapped="OnCardDoubleTapped" ToolTip.Tip="Click to flip · double-click to open his page"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DoubleTapped="OnRowDoubleTapped" IsVisible="{Binding TableView}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
        <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="76"/>
        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66"/>
        <DataGridTextColumn Header="Ht" Binding="{Binding Height}" Width="66"/>
        <DataGridTemplateColumn Header="Mood" Width="130" SortMemberPath="Player.Morale">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PlayerRow">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0" VerticalAlignment="Center">
                <c:Icon Kind="{Binding MoodIcon}" Width="15" Height="15" Foreground="{Binding MoodBrush}"/>
                <TextBlock Text="{Binding Mood}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Tier" Width="104" SortMemberPath="Player.CurrentAbility">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PlayerRow">
              <Border Background="{Binding TierBrush}" CornerRadius="9" Padding="8,1" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding TierName}" Foreground="#111" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="OVR" Binding="{Binding Ovr}" Width="84"/>
        <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="84"/>
        <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="84"/>
        <DataGridTextColumn Header="Sho" Binding="{Binding Sho}" Width="80"/>
        <DataGridTextColumn Header="Ply" Binding="{Binding Ply}" Width="80"/>
        <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="80"/>
        <DataGridTextColumn Header="Men" Binding="{Binding Men}" Width="80"/>
        <DataGridTextColumn Header="Phy" Binding="{Binding Phy}" Width="80"/>
        <DataGridTextColumn Header="MPG" Binding="{Binding Mpg}" Width="66"/>
        <DataGridTextColumn Header="PPG" Binding="{Binding Ppg}" Width="66"/>
        <DataGridTextColumn Header="RPG" Binding="{Binding Rpg}" Width="66"/>
        <DataGridTextColumn Header="APG" Binding="{Binding Apg}" Width="66"/>
        <DataGridTextColumn Header="FG%" Binding="{Binding FgPct}" Width="66"/>
        <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="82"/>
        <DataGridTextColumn Header="Contract" Binding="{Binding Years}" Width="92"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
