<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.CollegeView"
             x:DataType="vm:CollegeViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:Icon Kind="GraduationCap" Width="26" Height="26" Foreground="{DynamicResource HwAccentBrush}"/>
        <TextBlock Text="{Binding Headline}" Classes="h1" Margin="0"/>
      </StackPanel>
      <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl IsVisible="{Binding HasCollege}" SelectedIndex="{Binding Tab}">
      <TabItem Header="Top 25">
        <DataGrid ItemsSource="{Binding Top25}" CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
            <DataGridTemplateColumn Header="" Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:RankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Program" Width="300">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:RankRow"><c:TeamLink Team="{Binding Team}" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Conf" Binding="{Binding Conference}" Width="80"/>
            <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="90"/>
            <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Conferences">
        <DockPanel>
          <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding ConferenceNames}" SelectedItem="{Binding Conference}" MinWidth="260" Margin="0,0,0,6"/>
          <DataGrid ItemsSource="{Binding ConferenceRows}" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
              <DataGridTemplateColumn Header="" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Program" Width="300">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:RankRow"><c:TeamLink Team="{Binding Team}" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
              <DataGridTextColumn Header="Conference" Binding="{Binding ConfRecord}" Width="110"/>
              <DataGridTextColumn Header="Overall" Binding="{Binding Record}" Width="90"/>
              <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="March Madness">
        <!-- The bracket (college depth part 2): a region's four rounds as columns, or the Final Four. -->
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding BracketNote}" Classes="muted" TextWrapping="Wrap"/>
            <!-- Bracketology (C4 part 1): the projected field by seed line, then the bubble, until Selection Sunday. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasBracketology}">
              <c:StatStrip ItemsSource="{Binding BracketologyChips}" Accent="{DynamicResource HwAccent}"/>
              <ItemsControl ItemsSource="{Binding Bubble}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BubbleList">
                    <Border Background="#1C232C" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes="muted"/>
                        <ItemsControl ItemsSource="{Binding Teams}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeedCell">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Record}" FontSize="12" Classes="muted" Margin="8,0,0,0"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Projected seed lines" FontWeight="SemiBold" Classes="muted" Margin="2,4,0,0"/>
              <ItemsControl ItemsSource="{Binding SeedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SeedLine">
                    <Grid ColumnDefinitions="40,*" Margin="0,1">
                      <Border Background="{DynamicResource HwAccentBrush}" CornerRadius="4" Width="32" Height="24" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Seed}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                      </Border>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Teams}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SeedCell">
                            <Border Background="#1C232C" CornerRadius="4" Padding="6,3" Margin="0,1,6,1" BorderThickness="3,0,0,0"
                                    BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Record}" FontSize="11" Classes="muted"/>
                                  <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding HasTag}" VerticalAlignment="Center"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <c:StatStrip ItemsSource="{Binding MadnessChips}" Accent="{DynamicResource HwAccent}" IsVisible="{Binding HasBracket}"/>
            <ComboBox ItemsSource="{Binding BracketViews}" SelectedItem="{Binding BracketView}" MinWidth="200" IsVisible="{Binding HasBracket}"/>
            <ItemsControl ItemsSource="{Binding BracketColumns}" Height="620" IsVisible="{Binding HasBracket}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BracketColumn">
                  <DockPanel Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" Classes="muted" Margin="2,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BracketCard">
                          <Border Background="#1C232C" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,2" BorderThickness="3,0,0,0"
                                  BorderBrush="{DynamicResource HwAccentBrush}">
                            <StackPanel>
                              <Grid ColumnDefinitions="22,*,Auto" Opacity="{Binding OpacityA}">
                                <TextBlock Text="{Binding SeedA}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding NameA}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding WinA, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreA}" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                              </Grid>
                              <Grid ColumnDefinitions="22,*,Auto" Opacity="{Binding OpacityB}">
                                <TextBlock Text="{Binding SeedB}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding NameB}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding WinB, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreB}" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
                              </Grid>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Note}" Classes="muted" FontSize="10"/>
                                <TextBlock Text="UPSET" FontSize="10" FontWeight="Bold" Foreground="#D29922" IsVisible="{Binding Upset}"/>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Prospects">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Ages}" SelectedItem="{Binding Age}" MinWidth="220" Margin="0,0,8,4"/>
            <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding Position}" MinWidth="80" Margin="0,0,8,4"/>
            <Button Content="Open player" Command="{Binding OpenProspectCommand}" Margin="0,0,8,4"/>
            <TextBlock Text="Players turn pro at 23 and join free agency in the summer. Ranges show what your scouts believe." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
          </WrapPanel>
          <DataGrid ItemsSource="{Binding Prospects}" SelectedItem="{Binding SelectedProspect}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="66"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66"/>
              <DataGridTextColumn Header="Program or high school" Binding="{Binding Program}" Width="330"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="80"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="80"/>
              <DataGridTextColumn Header="This season" Binding="{Binding Line}" Width="240"/>
              <DataGridTextColumn Header="" Binding="{Binding Turns}" Width="*" MinWidth="190"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Recruiting" IsVisible="{Binding IsProRecruiting}">
        <!-- Senior recruiting (decision #157): the board, and the selected senior beside it (or under it when narrow). -->
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding RecruitNote}" Classes="muted" TextWrapping="Wrap"/>
            <c:StatStrip ItemsSource="{Binding RecruitChips}" Accent="{DynamicResource HwAccent}"/>
            <Grid x:Name="RecruitRowGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <DockPanel x:Name="RecruitBoard" VerticalAlignment="Top">
                <CheckBox DockPanel.Dock="Top" Content="Only my list and commitments" IsChecked="{Binding ListedOnly}" Margin="0,0,0,4"/>
                <DataGrid x:Name="RecruitGrid" ItemsSource="{Binding Recruits}" SelectedItem="{Binding SelectedRecruit}" RowHeight="NaN" Height="500">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Senior" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="56"/>
                    <DataGridTemplateColumn Header="Program" Width="*" MinWidth="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:RecruitRow"><TextBlock Text="{Binding Program}" TextWrapping="Wrap" Margin="6,3" VerticalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="60"/>
                    <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="60"/>
                    <DataGridTemplateColumn Header="Interest" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:RecruitRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding Interest}" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding InterestText}" FontSize="11" Margin="6,0,0,0"/>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <StackPanel x:Name="RecruitPanel" Grid.Column="1" Width="330" Margin="10,0,0,0" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="Pick a senior to court him." Classes="muted" IsVisible="{Binding !HasRecruit}" TextWrapping="Wrap"/>
                <Border Classes="panel" IsVisible="{Binding HasRecruit}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SelectedRecruit.Name}" Classes="h2" Margin="0"/>
                    <TextBlock Text="{Binding SelectedRecruit.Program}" Classes="muted" TextWrapping="Wrap"/>
                    <c:StatStrip ItemsSource="{Binding InterestChips}" Accent="{DynamicResource HwAccent}"/>
                    <TextBlock Text="{Binding RecruitLean}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <WrapPanel>
                      <Button Content="Call (1 pt)" Command="{Binding CallRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="Visit (3 pts)" Command="{Binding VisitRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="List / unlist" Command="{Binding ShortlistRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="Open player" Command="{Binding OpenRecruitCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Text="Offer terms (he signs when the season ends)" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <TextBlock Text="$M a year" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,6"/>
                      <NumericUpDown Value="{Binding OfferWage}" Minimum="0" Maximum="80" Increment="0.25" FormatString="0.00" Width="130" Margin="0,0,10,6"/>
                      <TextBlock Text="Years" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,6"/>
                      <NumericUpDown Value="{Binding OfferYears}" Minimum="1" Maximum="5" Increment="1" FormatString="0" Width="100" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <Button Classes="primary" Content="Make the offer" Command="{Binding OfferRecruitCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding RecruitReply}" Classes="accent" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- The recruiting trail (C3, #173): a college coach's own high-school recruiting. -->
      <TabItem Header="Recruiting" IsVisible="{Binding IsCollegeCoach}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding TrailNote}" Classes="muted" TextWrapping="Wrap"/>
            <c:StatStrip ItemsSource="{Binding TrailChips}" Accent="{DynamicResource HwAccent}"/>
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding TrailClass}" MinWidth="220" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding TrailViews}" SelectedItem="{Binding TrailView}" MinWidth="170" Margin="0,0,8,4"/>
              <CheckBox Content="My assistant uses the hours I leave" IsChecked="{Binding AssistantRecruits}" Margin="0,0,8,4"/>
            </WrapPanel>
            <Grid x:Name="TrailRowGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <DataGrid x:Name="TrailGrid" ItemsSource="{Binding TrailRows}" SelectedItem="{Binding SelectedTrail}" Height="500" VerticalAlignment="Top">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
                  <DataGridTextColumn Header="Stars" Binding="{Binding Stars}" Width="70"/>
                  <DataGridTextColumn Header="Prospect" Binding="{Binding Name}" Width="140"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="48"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="56"/>
                  <DataGridTemplateColumn Header="Interest" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:TrailRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                          <ProgressBar Value="{Binding Interest}" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding InterestText}" FontSize="11" Margin="6,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Leaning" Binding="{Binding Leaning}" Width="150"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="130"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="TrailPanel" Grid.Column="1" Width="330" Margin="10,0,0,0" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="Pick a prospect to recruit him." Classes="muted" IsVisible="{Binding !HasTrail}" TextWrapping="Wrap"/>
                <Border Classes="panel" IsVisible="{Binding HasTrail}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SelectedTrail.Name}" Classes="h2" Margin="0"/>
                    <TextBlock Text="{Binding TrailHeader}" Classes="muted" TextWrapping="Wrap"/>
                    <c:StatStrip ItemsSource="{Binding ProspectChips}" Accent="{DynamicResource HwAccent}"/>
                    <TextBlock Text="{Binding TrailConsidering}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <WrapPanel>
                      <Button Content="Scout (1 h)" Command="{Binding ScoutTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Call (1 h)" Command="{Binding CallTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Home visit (4 h)" Command="{Binding HomeVisitTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Official visit (8 h)" Command="{Binding OfficialVisitTrailCommand}" Margin="0,0,6,6"/>
                      <Button Classes="primary" Content="Offer a scholarship (2 h)" Command="{Binding OfferTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Board +/-" Command="{Binding BoardTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Open player" Command="{Binding OpenTrailCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding TrailReply}" Classes="accent" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Recruiting (decision #162): the high-school classes and where they're going. -->
      <TabItem Header="High school" IsVisible="{Binding HasRecruiting}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <c:StatStrip ItemsSource="{Binding HighSchoolChips}" Accent="{DynamicResource HwAccent}"/>
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding HighSchoolClass}" MinWidth="220" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding StarFilters}" SelectedItem="{Binding StarFilter}" MinWidth="140" Margin="0,0,8,4"/>
              <Button Content="Open player" Command="{Binding OpenHighSchoolCommand}" Margin="0,0,8,4"/>
              <TextBlock Text="Stars are the recruiting services' opinion, not a promise: busts and sleepers happen." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid ItemsSource="{Binding HighSchoolers}" SelectedItem="{Binding SelectedHighSchool}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
              <DataGridTextColumn Header="Stars" Binding="{Binding Stars}" Width="70"/>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="48"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="50"/>
              <DataGridTextColumn Header="Committed to" Binding="{Binding Committed}" Width="230"/>
              <DataGridTextColumn Header="High school" Binding="{Binding HighSchool}" Width="190"/>
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" MinWidth="56"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Class rankings" IsVisible="{Binding HasRecruiting}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding HighSchoolClass}" MinWidth="220"/>
            <TextBlock Text="{Binding ClassNote}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding ClassRanks}" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
              <DataGridTemplateColumn Header="" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ClassRankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Program" Width="300">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ClassRankRow"><c:TeamLink Team="{Binding Team}" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Conf" Binding="{Binding Conference}" Width="70"/>
              <DataGridTextColumn Header="Signed" Binding="{Binding Commits}" Width="76"/>
              <DataGridTextColumn Header="5-star" Binding="{Binding FiveStars}" Width="70"/>
              <DataGridTextColumn Header="4-star" Binding="{Binding FourStars}" Width="70"/>
              <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="*" MinWidth="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
