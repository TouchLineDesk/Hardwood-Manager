<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             xmlns:v="using:Hardwood.Desktop.Views"
             x:Class="Hardwood.Desktop.Views.CollegeView"
             x:DataType="vm:CollegeViewModel">
  <UserControl.Styles>
    <!-- Run 68 (bug hunt H18): seven tabs at the theme's 24 px wrapped "Class rankings" onto a second line at 1480 px. -->
    <Style Selector="TabControl#CollegeTabs > TabItem">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:Icon Kind="GraduationCap" Width="26" Height="26" Foreground="{DynamicResource HwAccentBrush}"/>
        <TextBlock Text="{Binding Headline}" Classes="h1" Margin="0"/>
      </StackPanel>
      <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
    <TabControl x:Name="CollegeTabs" IsVisible="{Binding HasCollege}" SelectedIndex="{Binding Tab}">
      <TabItem Header="Top 25">
        <!-- Danny, #528: the Top 25 as a grid of logos with the rank in each tile, re-ranked after every game. -->
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox x:Name="PollViewBox" ItemsSource="{Binding PollViews}" SelectedItem="{Binding PollView}" MinWidth="110" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="{Binding PollNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding DroppedOut}" IsVisible="{Binding HasDroppedOut}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Panel>
            <ScrollViewer IsVisible="{Binding ShowPollGrid}" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PollGrid" ItemsSource="{Binding PollTiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PollTile">
                    <Button Classes="card" Command="{Binding Open}" CommandParameter="{Binding Team}" Margin="0,0,8,8" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="{Binding Tip}">
                      <Border Background="{StaticResource HwPanelBrush}" BorderBrush="{Binding Edge}" BorderThickness="0,4,0,0" CornerRadius="8" Padding="8,6,8,8" MinHeight="148">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="{Binding Rank}" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Top"/>
                            <Border Grid.Column="2" Background="#1F2633" CornerRadius="8" Padding="6,1" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Move}" FontSize="11" FontWeight="Bold" Foreground="{Binding MoveBrush}"/>
                            </Border>
                          </Grid>
                          <c:TeamLogo Grid.Row="1" Team="{Binding Team}" ShowRank="False" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                          <TextBlock Grid.Row="2" Text="{Binding School}" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Row="3" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
                            <Run Text="{Binding Record}"/><Run Text=" · "/><Run Text="{Binding Conference}"/>
                          </TextBlock>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <DataGrid IsVisible="{Binding ShowPollTable}" ItemsSource="{Binding Top25}" CanUserSortColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
                <DataGridTextColumn Header="Move" Binding="{Binding Move}" Width="70"/>
                <DataGridTemplateColumn Header="" Width="44">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:RankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Program" Width="300">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:RankRow"><c:TeamLink Team="{Binding Team}" ShowRank="False" Margin="4,0"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Conf" Binding="{Binding Conference}" Width="80"/>
                <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="90"/>
                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Conferences">
        <DockPanel>
          <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding ConferenceNames}" SelectedItem="{Binding Conference}" MinWidth="260" Margin="0,0,0,6"/>
          <TextBlock x:Name="ConferenceStyle" DockPanel.Dock="Top" Text="{Binding ConferenceStyle}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                     IsVisible="{Binding ConferenceStyle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <DataGrid ItemsSource="{Binding ConferenceRows}" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
              <DataGridTemplateColumn Header="" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Program" Width="300">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:RankRow"><c:TeamLink Team="{Binding Team}" Margin="4,0"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
              <DataGridTextColumn Header="Conference" Binding="{Binding ConfRecord}" Width="110"/>
              <DataGridTextColumn Header="Overall" Binding="{Binding Record}" Width="90"/>
              <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="March Madness">
        <!-- The bracket (college depth part 2): a region's four rounds as columns, or the Final Four. -->
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding BracketNote}" Classes="muted" TextWrapping="Wrap"/>
            <!-- Bracketology (C4 part 1): the projected field by seed line, then the bubble, until Selection Sunday. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasBracketology}">
              <c:StatStrip ItemsSource="{Binding BracketologyChips}" Accent="{DynamicResource HwAccent}"/>
              <ItemsControl ItemsSource="{Binding Bubble}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BubbleList">
                    <Border Background="#1C232C" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes="muted"/>
                        <ItemsControl ItemsSource="{Binding Teams}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeedCell">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Record}" FontSize="12" Classes="muted" Margin="8,0,0,0"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Projected seed lines" FontWeight="SemiBold" Classes="muted" Margin="2,4,0,0"/>
              <ItemsControl ItemsSource="{Binding SeedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SeedLine">
                    <Grid ColumnDefinitions="40,*" Margin="0,1">
                      <Border Background="{DynamicResource HwAccentBrush}" CornerRadius="4" Width="32" Height="24" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Seed}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                      </Border>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Teams}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SeedCell">
                            <Border Background="#1C232C" CornerRadius="4" Padding="6,3" Margin="0,1,6,1" BorderThickness="3,0,0,0"
                                    BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <WrapPanel>
                                  <TextBlock Text="{Binding Record}" FontSize="11" Classes="muted" Margin="0,0,6,0"/>
                                  <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding HasTag}" VerticalAlignment="Center"/>
                                </WrapPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <c:StatStrip ItemsSource="{Binding MadnessChips}" Accent="{DynamicResource HwAccent}" IsVisible="{Binding FieldPicked}"/>
            <!-- Run 190 (the bracket redesign): the views as tabs (the whole field, each region, the reveal, the weekend), not a drop-down. -->
            <ListBox x:Name="BracketTabs" ItemsSource="{Binding BracketViews}" SelectedItem="{Binding BracketView}" IsVisible="{Binding FieldPicked}"
                     Background="Transparent" SelectionMode="AlwaysSelected">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="CornerRadius" Value="4"/></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <!-- Selection Sunday as a reveal (C4 part 2): the regions one at a time, then the bubble. -->
            <!-- The Selection Show (B1, run 139): the reveal on the HSN set, game by game, until Advance. -->
            <v:SelectionShowView IsVisible="{Binding ShowOn}"/>
            <StackPanel Spacing="6" IsVisible="{Binding ShowRegions}">
              <TextBlock Text="{Binding SelectionIntro}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel IsVisible="{Binding CanReveal}">
                <Button Content="{Binding RevealButton}" Command="{Binding RevealNextCommand}" IsEnabled="{Binding CanReveal}" Classes="primary" Margin="0,0,8,4"/>
                <Button Content="Reveal all" Command="{Binding RevealAllCommand}" IsEnabled="{Binding CanReveal}" Margin="0,0,8,4"/>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding RevealRegions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RevealRegion">
                    <Border Background="#161C24" CornerRadius="8" Padding="10,8" Margin="0,0,8,8" BorderThickness="0,3,0,0"
                            BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                          <TextBlock Grid.Column="1" Text="{Binding Line}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <Border IsVisible="{Binding Hidden}" Background="#1C232C" CornerRadius="6" Height="64">
                          <TextBlock Text="?" FontSize="28" FontWeight="Bold" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Pairs}" IsVisible="{Binding Shown}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RevealPair">
                              <Border Background="#1C232C" CornerRadius="6" Padding="8,3" Margin="0,2" BorderThickness="3,0,0,0"
                                      BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                                <StackPanel>
                                  <Grid ColumnDefinitions="24,*,Auto,Auto">
                                    <TextBlock Text="{Binding Top.Seed}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Top.Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Top.Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Top.Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding Top.HasTag}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Top.Record}" FontSize="11" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                  </Grid>
                                  <Grid ColumnDefinitions="24,*,Auto,Auto">
                                    <TextBlock Text="{Binding Bottom.Seed}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Bottom.Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Bottom.Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Bottom.Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding Bottom.HasTag}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Bottom.Record}" FontSize="11" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                  </Grid>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding SelectionBubble}" IsVisible="{Binding HasSelectionBubble}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BubbleList">
                    <Border Background="#1C232C" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes="muted"/>
                        <ItemsControl ItemsSource="{Binding Teams}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SeedCell">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" FontWeight="{Binding Mine, Converter={x:Static vm:HomeConverters.Bold}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Record}" FontSize="12" Classes="muted" Margin="8,0,0,0"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- The Final Four weekend (C4 part 2): the neutral site, the four teams, the semis and the final, the champions' run. -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowFinalFour}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding WeekendTitle}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WeekendSub}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding WeekendTeams}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FinalFourTeam">
                    <Border Background="#161C24" CornerRadius="8" Padding="10,8" Margin="0,0,8,0" BorderThickness="0,3,0,0" Opacity="{Binding Fade}"
                            BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Region}" FontSize="11" FontWeight="Bold" Classes="muted"/>
                          <TextBlock Grid.Column="1" Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding HasTag}" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding Seed}" FontSize="12" Classes="muted"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Record}" FontSize="12" Classes="muted"/>
                        <TextBlock Text="{Binding Route}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding WeekendGames}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WeekendGame">
                    <Border Background="#1C232C" CornerRadius="8" Padding="10,8" Margin="0,0,8,0" BorderThickness="3,0,0,0"
                            BorderBrush="{Binding Mine, Converter={x:Static vm:CollegeConverters.MineEdge}}">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Classes="muted" TextWrapping="Wrap"/>
                          <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11" Classes="muted" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="24,*,Auto">
                          <TextBlock Text="{Binding A.Seed}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding A.Name}" FontSize="15" TextWrapping="Wrap" FontWeight="{Binding A.Won, Converter={x:Static vm:HomeConverters.Bold}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding A.Score}" FontSize="15" Margin="8,0,0,0" FontWeight="{Binding A.Won, Converter={x:Static vm:HomeConverters.Bold}}"/>
                        </Grid>
                        <Grid ColumnDefinitions="24,*,Auto">
                          <TextBlock Text="{Binding B.Seed}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding B.Name}" FontSize="15" TextWrapping="Wrap" FontWeight="{Binding B.Won, Converter={x:Static vm:HomeConverters.Bold}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding B.Score}" FontSize="15" Margin="8,0,0,0" FontWeight="{Binding B.Won, Converter={x:Static vm:HomeConverters.Bold}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Stars}" FontSize="11" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStars}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="4" IsVisible="{Binding HasMontage}" Margin="0,6,0,0">
                <TextBlock Text="{Binding MontageTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MontageSub}" Classes="muted" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Montage}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MontageCard">
                      <Border Background="#161C24" CornerRadius="8" Padding="10,8" Margin="0,0,8,8" BorderThickness="0,0,0,3" BorderBrush="{DynamicResource HwAccentBrush}">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Round}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                          </Grid>
                          <TextBlock Text="{Binding Opponent}" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Star}" FontSize="12" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStar}"/>
                          <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" IsVisible="{Binding HasTag}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <!-- Run 190 (Danny, Nov 24, claude/bracket-redesign.md): the bracket as the TV graphic draws it: the whole field of 64
                 on one dark screen (or one region bigger), team-colour bars, elbow lines, our own emblem. It shrinks to fit, never grows. -->
            <Border x:Name="MadnessField" IsVisible="{Binding ShowField}" Background="#14171C" BorderBrush="#E8731C" BorderThickness="2" CornerRadius="8" Padding="12">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                <c:MadnessBracketView Field="{Binding MadnessField}"/>
              </Viewbox>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Prospects">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Ages}" SelectedItem="{Binding Age}" MinWidth="220" Margin="0,0,8,4"/>
            <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding Position}" MinWidth="80" Margin="0,0,8,4"/>
            <Button Content="Open player" Command="{Binding OpenProspectCommand}" IsEnabled="{Binding SelectedProspect, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a player in the list first" ToolTip.ShowOnDisabled="True" Margin="0,0,8,4"/>
            <TextBlock Text="Players turn pro at 22, after four years, and join free agency in the summer. Ranges show what your scouts believe." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding !HasProspects}">
            <TextBlock Text="{Binding ProspectsEmpty}" Classes="muted" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
            <Button Content="Show college players" Command="{Binding ShowCollegeProspectsCommand}" IsVisible="{Binding ProspectsOfferCollege}" HorizontalAlignment="Left"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Prospects}" SelectedItem="{Binding SelectedProspect}" IsVisible="{Binding HasProspects}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="66"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="66"/>
              <DataGridTextColumn Header="Program or high school" Binding="{Binding Program}" Width="330"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="80"/>
              <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="80"/>
              <DataGridTextColumn Header="This season" Binding="{Binding Line}" Width="240"/>
              <DataGridTextColumn Header="" Binding="{Binding Turns}" Width="*" MinWidth="190"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Recruiting" IsVisible="{Binding IsProRecruiting}">
        <!-- Senior recruiting (decision #157): the board, and the selected senior beside it (or under it when narrow). -->
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding RecruitNote}" Classes="muted" TextWrapping="Wrap"/>
            <c:StatStrip ItemsSource="{Binding RecruitChips}" Accent="{DynamicResource HwAccent}"/>
            <Grid x:Name="RecruitRowGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <DockPanel x:Name="RecruitBoard" VerticalAlignment="Top">
                <CheckBox DockPanel.Dock="Top" Content="Only my list and commitments" IsChecked="{Binding ListedOnly}" Margin="0,0,0,4"/>
                <DataGrid x:Name="RecruitGrid" ItemsSource="{Binding Recruits}" SelectedItem="{Binding SelectedRecruit}" RowHeight="NaN" Height="500">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Senior" Binding="{Binding Name}" Width="170"/>
                    <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="56"/>
                    <DataGridTemplateColumn Header="Program" Width="*" MinWidth="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:RecruitRow"><TextBlock Text="{Binding Program}" TextWrapping="Wrap" Margin="6,3" VerticalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="60"/>
                    <DataGridTextColumn Header="PA" Binding="{Binding PA}" Width="60"/>
                    <DataGridTemplateColumn Header="Interest" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:RecruitRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding Interest}" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding InterestText}" FontSize="11" Margin="6,0,0,0"/>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <StackPanel x:Name="RecruitPanel" Grid.Column="1" Width="330" Margin="10,0,0,0" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="Pick a senior to court him." Classes="muted" IsVisible="{Binding !HasRecruit}" TextWrapping="Wrap"/>
                <Border Classes="panel" IsVisible="{Binding HasRecruit}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding RecruitName}" Classes="h2" Margin="0"/>
                    <TextBlock Text="{Binding RecruitProgram}" Classes="muted" TextWrapping="Wrap"/>
                    <c:StatStrip ItemsSource="{Binding InterestChips}" Accent="{DynamicResource HwAccent}"/>
                    <TextBlock Text="{Binding RecruitLean}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <WrapPanel>
                      <Button Content="Call (1 pt)" Command="{Binding CallRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="Visit (3 pts)" Command="{Binding VisitRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="List / unlist" Command="{Binding ShortlistRecruitCommand}" Margin="0,0,6,6"/>
                      <Button Content="Open player" Command="{Binding OpenRecruitCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Text="Offer terms (he signs when the season ends)" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <TextBlock Text="$M a year" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,6"/>
                      <NumericUpDown Value="{Binding OfferWage}" Minimum="0" Maximum="80" Increment="0.25" FormatString="0.00" Width="130" Margin="0,0,10,6"/>
                      <TextBlock Text="Years" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,6"/>
                      <NumericUpDown Value="{Binding OfferYears}" Minimum="1" Maximum="5" Increment="1" FormatString="0" Width="100" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <Button Classes="primary" Content="Make the offer" Command="{Binding OfferRecruitCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding RecruitReply}" Classes="accent" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- The recruiting trail (C3, #173): a college coach's own high-school recruiting. -->
      <TabItem Header="Recruiting" IsVisible="{Binding IsCollegeCoach}">
        <!-- H198 (run 184): the scroll bar stays shown, so a detail pane that runs past the bottom (Promise, Board) has a cue. -->
        <ScrollViewer x:Name="TrailPageScroll" AllowAutoHide="False">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding TrailNote}" Classes="muted" TextWrapping="Wrap"/>
            <c:StatStrip ItemsSource="{Binding TrailChips}" Accent="{DynamicResource HwAccent}"/>
            <!-- Run 164 (critic review #21 item 5): the first week on the trail in three steps; gone once all three are done. -->
            <Border x:Name="TrailGuidePanel" Classes="panel" IsVisible="{Binding HasTrailGuide}">
              <StackPanel Spacing="6">
                <TextBlock x:Name="TrailGuideHeaderText" Text="{Binding TrailGuideHeader}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ItemsControl x:Name="TrailGuideSteps" ItemsSource="{Binding TrailGuide}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GuideStepRow">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,12,0" Opacity="{Binding Faded}">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource HwAccent}" VerticalAlignment="Top" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Mark}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding How}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding TrailClass}" MinWidth="220" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding TrailViews}" SelectedItem="{Binding TrailView}" MinWidth="170" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding BoardViews}" SelectedItem="{Binding BoardView}" Width="120" Margin="0,0,8,4" ToolTip.Tip="Star cards, or the full table with every prospect"/>
              <CheckBox Content="My assistant uses the hours I leave" IsChecked="{Binding AssistantRecruits}" Margin="0,0,8,4" ToolTip.Tip="{Binding AssistantTip}"/>
            </WrapPanel>
            <TextBlock Text="{Binding TrailCardNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasTrailEmpty}"/>
            <Border Classes="panel" IsVisible="{Binding HasTrailEmpty}" HorizontalAlignment="Left">
              <StackPanel Spacing="6">
                <TextBlock x:Name="TrailEmptyText" Text="{Binding TrailEmpty}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Button x:Name="TrailOtherClassButton" Content="{Binding TrailOtherClassText}" Command="{Binding OtherTrailClassCommand}" IsVisible="{Binding HasTrailOtherClass}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Grid x:Name="TrailRowGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <Panel x:Name="TrailBoard" VerticalAlignment="Top">
              <ScrollViewer x:Name="TrailCardScroll" IsVisible="{Binding ShowBoardCards}" Height="500" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TrailCards" ItemsSource="{Binding TrailCards}" VerticalAlignment="Top">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="270" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrailRow">
                      <!-- H198 (run 184): every card fills its grid cell (the Fluent button centres itself), so a card with a "Says no" line
                           doesn't stagger its row. -->
                      <Button Classes="marketCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                              Click="OnTrailClick" ToolTip.Tip="Pick him to recruit him">
                        <Border BorderBrush="{Binding StarBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="Auto,52,*">
                              <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="Bold" Foreground="{Binding StarBrush}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="{Binding StarTip}"/>
                              <c:Avatar Grid.Column="1" Player="{Binding Player}" Width="48" Height="48" VerticalAlignment="Center"/>
                              <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CaresText}" FontSize="11" FontWeight="SemiBold" Classes="muted" IsVisible="{Binding HasCares}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CaresTip}"/>
                                <TextBlock FontSize="15" ToolTip.Tip="{Binding StarTip}"><Run Text="{Binding StarsOn}" Foreground="#FFC83D"/><Run Text="{Binding StarsOff}" Foreground="#3A4452"/></TextBlock>
                              </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="His interest in your program, 0 to 100">
                              <TextBlock Text="Interest" FontSize="11" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <c:RatingBar Grid.Column="1" Value="{Binding Interest}" Maximum="100" Fill="{Binding InterestBrush}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2" Text="{Binding InterestText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Height="22">
                              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="The program he leans to today">
                                <c:TeamLogo Team="{Binding LeaningTeam}" Width="18" Height="18" ShowText="False" IsVisible="{Binding HasLeaning}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LeaningText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                              </StackPanel>
                              <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding NoReason}" FontSize="11" Foreground="#E0A030" IsVisible="{Binding HasNoReason}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="Why he would turn you down today. The prospect panel breaks it down factor by factor."/>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <DataGrid x:Name="TrailGrid" ItemsSource="{Binding TrailRows}" SelectedItem="{Binding SelectedTrail}" Height="500" VerticalAlignment="Top" IsVisible="{Binding ShowBoardTable}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
                  <DataGridTemplateColumn Header="Stars" Width="92">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:TrailRow">
                        <TextBlock Text="{Binding Stars}" Foreground="#FFC83D" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Prospect" Binding="{Binding Name}" Width="176"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="48"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="56"/>
                  <DataGridTemplateColumn Header="Interest" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:TrailRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                          <ProgressBar Value="{Binding Interest}" Maximum="100" Height="6" MinWidth="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding InterestText}" FontSize="11" Margin="6,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Leaning" Binding="{Binding Leaning}" Width="150"/>
                  <DataGridTextColumn Header="Cares about" Binding="{Binding CaresCell}" Width="110"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="130"/>
                </DataGrid.Columns>
              </DataGrid>
              </Panel>
              <StackPanel x:Name="TrailPanel" Grid.Column="1" Width="330" Margin="10,0,0,0" Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="Pick a prospect to recruit him." Classes="muted" IsVisible="{Binding !HasTrail}" TextWrapping="Wrap"/>
                <Border Classes="panel" IsVisible="{Binding HasTrail}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TrailName}" Classes="h2" Margin="0"/>
                    <TextBlock Text="{Binding TrailHeader}" Classes="muted" TextWrapping="Wrap"/>
                    <c:StatStrip ItemsSource="{Binding ProspectChips}" Accent="{DynamicResource HwAccent}"/>
                    <TextBlock Text="{Binding TrailConsidering}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TrailWhyText" Text="{Binding TrailWhy}" TextWrapping="Wrap" IsVisible="{Binding HasTrailWhy}"/>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Pitch" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <ComboBox x:Name="TrailPitchBox" Grid.Column="1" ItemsSource="{Binding TrailPitches}" SelectedItem="{Binding TrailPitch}" HorizontalAlignment="Stretch" ToolTip.Tip="What your calls and visits sell him (free to change)"/>
                    </Grid>
                    <TextBlock Text="{Binding TrailPitchNote}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="Scout (1 h)" Command="{Binding ScoutTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Call (1 h)" Command="{Binding CallTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Home visit (4 h)" Command="{Binding HomeVisitTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Official visit (8 h)" Command="{Binding OfficialVisitTrailCommand}" Margin="0,0,6,6"/>
                      <Button Classes="primary" Content="Offer a scholarship (2 h)" Command="{Binding OfferTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Promise a starting role (1 h)" Command="{Binding PromiseTrailCommand}" Margin="0,0,6,6" ToolTip.Tip="Promise him a starting role as a freshman (two a class). It is judged in mid-January of his first season: start him in half his games or give him 25 minutes a game."/>
                      <Button Content="Board +/-" Command="{Binding BoardTrailCommand}" Margin="0,0,6,6"/>
                      <Button Content="Open player" Command="{Binding OpenTrailCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding TrailReply}" Classes="accent" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Recruiting (decision #162): the high-school classes and where they're going. -->
      <TabItem Header="High school" IsVisible="{Binding HasRecruiting}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <c:StatStrip ItemsSource="{Binding HighSchoolChips}" Accent="{DynamicResource HwAccent}"/>
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding HighSchoolClass}" MinWidth="220" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding StarFilters}" SelectedItem="{Binding StarFilter}" MinWidth="140" Margin="0,0,8,4"/>
              <ComboBox ItemsSource="{Binding BoardViews}" SelectedItem="{Binding BoardView}" Width="120" Margin="0,0,8,4" ToolTip.Tip="Star cards, or the full table with every prospect"/>
              <Button Content="Open player" Command="{Binding OpenHighSchoolCommand}" IsEnabled="{Binding SelectedHighSchool, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a prospect in the list first" ToolTip.ShowOnDisabled="True" Margin="0,0,8,4"/>
              <TextBlock Text="Stars are the recruiting services' opinion, not a promise: busts and sleepers happen." Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock Text="{Binding HighSchoolCardNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowBoardCards}"/>
            <TextBlock Text="{Binding HighSchoolHint}" Classes="accent" TextWrapping="Wrap" IsVisible="{Binding HasHighSchoolHint}"/>
          </StackPanel>
          <Panel>
          <ScrollViewer IsVisible="{Binding ShowBoardCards}" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="HighSchoolCards" ItemsSource="{Binding HighSchoolCards}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid MinItemWidth="280" MaxColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HighSchoolRow">
                  <Button Classes="marketCard" Classes.picked="{Binding Picked}" Margin="0,0,10,10" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Click="OnHighSchoolClick" ToolTip.Tip="Pick him (then Open player for his page)">
                    <Border BorderBrush="{Binding StarBrush}" BorderThickness="4,0,0,0" CornerRadius="3" Padding="8,6">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,52,*">
                          <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="Bold" Foreground="{Binding StarBrush}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="{Binding StarTip}"/>
                          <c:Avatar Grid.Column="1" Player="{Binding Player}" Width="48" Height="48" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="15" ToolTip.Tip="{Binding StarTip}"><Run Text="{Binding StarsOn}" Foreground="#FFC83D"/><Run Text="{Binding StarsOff}" Foreground="#3A4452"/></TextBlock>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Where}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Where}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Height="22">
                          <c:TeamLogo Team="{Binding CommittedTeam}" Width="20" Height="20" ShowText="False" IsVisible="{Binding HasCommit}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding CommitText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <DataGrid ItemsSource="{Binding HighSchoolers}" SelectedItem="{Binding SelectedHighSchool}" IsVisible="{Binding ShowBoardTable}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="48"/>
              <DataGridTemplateColumn Header="Stars" Width="92">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:HighSchoolRow">
                        <TextBlock Text="{Binding Stars}" Foreground="#FFC83D" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
              <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="48"/>
              <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="50"/>
              <DataGridTextColumn Header="Committed to" Binding="{Binding Committed}" Width="230"/>
              <DataGridTextColumn Header="High school" Binding="{Binding HighSchool}" Width="206"/>
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" MinWidth="56"/>
            </DataGrid.Columns>
          </DataGrid>
          </Panel>
        </DockPanel>
      </TabItem>
      <TabItem Header="Class rankings" IsVisible="{Binding HasRecruiting}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding HighSchoolClass}" MinWidth="220"/>
            <TextBlock Text="{Binding ClassNote}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding ClassRanks}" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"/>
              <DataGridTemplateColumn Header="" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ClassRankRow"><c:TeamLogo Team="{Binding Team}" Width="24" Height="24" ShowText="False" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Program" Width="300">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ClassRankRow"><c:TeamLink Team="{Binding Team}" Margin="4,0"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Conf" Binding="{Binding Conference}" Width="70"/>
              <DataGridTextColumn Header="Signed" Binding="{Binding Commits}" Width="76"/>
              <DataGridTextColumn Header="5-star" Binding="{Binding FiveStars}" Width="70"/>
              <DataGridTextColumn Header="4-star" Binding="{Binding FourStars}" Width="70"/>
              <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="*" MinWidth="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <!-- CP3 (run 132): the alumni tracker. Your graduates wherever they play now; their pro record helps you recruit. -->
      <TabItem Header="Your pros" IsVisible="{Binding IsCollegeCoach}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <c:StatStrip ItemsSource="{Binding AlumniChips}" Accent="{DynamicResource HwAccent}"/>
            <WrapPanel>
              <Button Content="Open player" Command="{Binding OpenAlumnusCommand}" CommandParameter="{x:Null}" IsVisible="{Binding HasAlumni}" IsEnabled="{Binding SelectedAlumnus, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Pick a graduate in the list first" ToolTip.ShowOnDisabled="True" Margin="0,0,8,4"/>
              <TextBlock x:Name="AlumniNoteText" Text="{Binding AlumniNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="1100" Margin="0,0,0,4"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="AlumniGrid" ItemsSource="{Binding Alumni}" SelectedItem="{Binding SelectedAlumnus}" IsVisible="{Binding HasAlumni}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Graduate" Binding="{Binding Name}" Width="214"/>
              <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="52"/>
              <DataGridTextColumn Header="Class of" Binding="{Binding Class}" Width="80"/>
              <DataGridTextColumn Header="Plays for" Binding="{Binding Club}" Width="*" MinWidth="214"/>
              <DataGridTextColumn Header="League" Binding="{Binding League}" Width="76"/>
              <DataGridTextColumn Header="CA" Binding="{Binding CA}" Width="52"/>
              <DataGridTextColumn Header="Drafted" Binding="{Binding Draft}" Width="122"/>
              <DataGridTextColumn Header="Honours" Binding="{Binding Honours}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
