<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.TacticsView"
             x:DataType="vm:TacticsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <StackPanel>
        <TextBlock Text="Tactics" Classes="h1" Margin="0"/>
        <TextBlock Text="{Binding FitSummary}" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
        <Button Content="Assistant: set up for me" Command="{Binding AssistantSetupCommand}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,*,*" Margin="0,0,0,10">
      <StackPanel Spacing="10" Margin="0,0,10,0">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Offensive system" Classes="h2" Margin="0"/>
            <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SystemOption">
                  <StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding FitText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- The play diagram (Danny, #475, D60 A): the five starters run the system, the scheme defends it -->
            <c:PlayDiagram System="{Binding DiagramSystem}" Scheme="{Binding DiagramScheme}" Labels="{Binding PlayLabels}" Accent="{Binding Accent}"
                           MaxHeight="380" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding SelectedSystem.Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
            <!-- Why it fits (roadmap 4): the ingredients, best and worst first -->
            <StackPanel Spacing="1" IsVisible="{Binding SelectedSystem.HasReasons}">
              <TextBlock Text="Why this fit" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <ItemsControl ItemsSource="{Binding SelectedSystem.Reasons}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="10" Margin="0,0,10,0">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Defensive scheme" Classes="h2" Margin="0"/>
            <ComboBox ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SystemOption">
                  <StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding FitText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedScheme.Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DefenceNote}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource HwAccentBrush}"/>
            <!-- Why it fits (roadmap 4): the ingredients, best and worst first -->
            <StackPanel Spacing="1" IsVisible="{Binding SelectedScheme.HasReasons}">
              <TextBlock Text="Why this fit" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <ItemsControl ItemsSource="{Binding SelectedScheme.Reasons}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="Their best scorer" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <ComboBox ItemsSource="{Binding Stoppers}" SelectedItem="{Binding SelectedStopper}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:StopperOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Double-team him (he shoots less and worse; his teammates get open looks)" IsChecked="{Binding DoubleStar}"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="10">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding BoardTitle}" Classes="h2" Margin="0" TextWrapping="Wrap"/>
            <StackPanel Spacing="6" IsVisible="{Binding HasOpponent}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding OurAttack}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{Binding OurAttackBrush}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OurAttackEdge}" FontSize="11" FontWeight="Bold" Foreground="#0E1116"/>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TheirAttack}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{Binding TheirAttackBrush}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TheirAttackEdge}" FontSize="11" FontWeight="Bold" Foreground="#0E1116"/>
                </Border>
              </Grid>
              <TextBlock Text="Starting fives" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
              <ItemsControl ItemsSource="{Binding Board}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MatchupRow">
                    <Grid ColumnDefinitions="30,*,52,*" Margin="0,2">
                      <TextBlock Text="{Binding Pos}" FontWeight="Bold" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource HwMutedBrush}"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Ours}" FontSize="11.5" TextWrapping="Wrap"/>
                        <Border Height="5" Width="{Binding OursWidth}" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource HwAccentBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding EdgeText}" Foreground="{Binding EdgeBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="{Binding Theirs}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right"/>
                        <Border Height="5" Width="{Binding TheirsWidth}" HorizontalAlignment="Right" CornerRadius="2" Background="#58A6FF"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding OpponentHeadline}" Classes="h2" Margin="0"/>
            <TextBlock Text="{Binding ScoutingReport}" TextWrapping="Wrap" FontSize="12"/>
            <Button Command="{Binding UseSuggestionCommand}"><TextBlock Text="Use the assistant's game plan" TextWrapping="Wrap"/></Button>
            <CheckBox IsChecked="{Binding AssistantPlans}" ToolTip.Tip="Before every game the assistant sets the system, scheme and star matchup from his scouting report. Your roles, sliders and presets stay yours."><TextBlock Text="Assistant plans every game" TextWrapping="Wrap" FontSize="12"/></CheckBox>
            <CheckBox IsChecked="{Binding HalftimeAdjust}" ToolTip.Tip="In games you don't watch live, the assistant reads what the other bench is really running at halftime and switches to the counter for the second half. Your saved tactics don't change."><TextBlock Text="Halftime read (games you don't watch)" TextWrapping="Wrap" FontSize="12"/></CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Suggested setups as cards (Danny, #475, D60 A) -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="Suggested setups" Classes="h2" Margin="0"/>
      <ItemsControl ItemsSource="{Binding Setups}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SetupCard">
            <Button Classes="card" Command="{Binding ApplyCommand}" Width="236" Margin="0,0,8,8" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <Border Padding="10,8" BorderThickness="3,0,0,0" BorderBrush="{Binding ScoreBrush}" Background="{StaticResource HwPanelBrush}" CornerRadius="6" MinHeight="150">
                <StackPanel Spacing="3">
                  <Border IsVisible="{Binding HasBadge}" Background="{StaticResource HwAccentBrush}" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="#0E1116" LetterSpacing="0.6"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Plan}" FontSize="11.5" Foreground="{StaticResource HwAccentBrush}" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <TextBlock Text="{Binding FitStars}" FontSize="12" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="5" Width="{Binding ScoreWidth}" Margin="8,0,0,0" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding ScoreBrush}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding EdgeText}" IsVisible="{Binding HasEdge}" Foreground="{Binding EdgeBrush}" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Pitch}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <!-- Fine-tuning as gauges (Danny, #475, D60 A), with presets beside -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <Border Classes="panel" Margin="0,0,10,0">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Fine-tuning" Classes="h2" Margin="0"/><Button Grid.Column="1" Content="Reset" Command="{Binding ResetSlidersCommand}"/></Grid>
          <WrapPanel Orientation="Horizontal">
          <StackPanel Width="150" Margin="0,0,10,6">
            <TextBlock Text="Pace" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <c:Gauge Value="{Binding Pace}" Minimum="88" Maximum="110" Word="{Binding PaceWord}" Number="{Binding PaceNumber}" HorizontalAlignment="Center" Width="120"/>
            <Slider Minimum="88" Maximum="110" Value="{Binding Pace}" Margin="0,-8,0,0"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,10,6">
            <TextBlock Text="Three-point emphasis" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <c:Gauge Value="{Binding ThreeEmphasis}" Minimum="0" Maximum="100" Word="{Binding ThreeText}" Number="{Binding ThreeNumber}" HorizontalAlignment="Center" Width="120"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding ThreeEmphasis}" Margin="0,-8,0,0"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,10,6">
            <TextBlock Text="Offensive glass" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <c:Gauge Value="{Binding CrashGlass}" Minimum="0" Maximum="100" Word="{Binding CrashText}" Number="{Binding CrashNumber}" HorizontalAlignment="Center" Width="120"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding CrashGlass}" Margin="0,-8,0,0"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,10,6">
            <TextBlock Text="Defensive aggression" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <c:Gauge Value="{Binding Aggression}" Minimum="0" Maximum="100" Word="{Binding AggressionText}" Number="{Binding AggressionNumber}" HorizontalAlignment="Center" Width="120"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding Aggression}" Margin="0,-8,0,0"/>
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,10,6">
            <TextBlock Text="Star usage" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            <c:Gauge Value="{Binding StarUsage}" Minimum="0" Maximum="100" Word="{Binding StarText2}" Number="{Binding StarNumber}" HorizontalAlignment="Center" Width="120"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding StarUsage}" Margin="0,-8,0,0"/>
          </StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding PaceText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Width="330">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="Presets" Classes="h2" Margin="0"/>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch" MinWidth="140" PlaceholderText="Saved presets"/>
              <Button Grid.Column="1" Content="Load" Command="{Binding LoadPresetCommand}" Margin="6,0,0,0"/>
              <Button Grid.Column="2" Content="Delete" Command="{Binding DeletePresetCommand}" Margin="6,0,0,0"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewPresetName}" Watermark="Name, e.g. Small ball"/>
              <Button Grid.Column="1" Content="Save current" Command="{Binding SavePresetCommand}" Margin="6,0,0,0"/>
            </Grid>
            <TextBlock Text="Late-game tactics (last 5 minutes, within 6 points)" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding LateGameOptions}" SelectedItem="{Binding LateGame}" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Roles -->
    <DockPanel Grid.Row="4">
      <TextBlock DockPanel.Dock="Top" Text="Roles" Classes="h2" Margin="0,0,0,4"/>
      <DataGrid ItemsSource="{Binding RoleRows}" CanUserSortColumns="False" RowHeight="NaN">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="64" IsReadOnly="True"/>
          <DataGridTextColumn Header="Min" Binding="{Binding MinutesText}" Width="52" IsReadOnly="True"/>
          <DataGridTemplateColumn Header="Role" Width="272">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RoleRow">
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" Margin="2">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RoleChoice"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Best fit" Binding="{Binding Best}" Width="216" IsReadOnly="True"/>
          <!-- Wraps onto a second line rather than running off the edge of the table. -->
          <DataGridTemplateColumn Header="What he does" Width="*" MinWidth="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:RoleRow"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,3"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
