<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             xmlns:college="using:Hardwood.Core.College"
             x:Class="Hardwood.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <!-- Header -->
      <Border CornerRadius="10" ClipToBounds="True" MinHeight="132">
        <Grid>
          <c:CourtBackdrop Glow="{Binding Glow}" Intensity="0.8"/>
          <!-- The next-game card drops below the team name when both don't fit (big text sizes). -->
          <Grid x:Name="Hero" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="20,12" VerticalAlignment="Center">
            <StackPanel x:Name="HeroLeft" Orientation="Horizontal" VerticalAlignment="Center">
            <c:TeamLogo Team="{Binding HeroTeam}" Width="92" Height="92" VerticalAlignment="Center" IsVisible="{Binding Coaching}"/>
            <Border Width="92" Height="92" CornerRadius="46" Background="#33161B22" BorderBrush="#4A5563" BorderThickness="2" VerticalAlignment="Center" IsVisible="{Binding OutOfWork}">
              <c:Icon Kind="Shield" Width="40" Height="40" Foreground="#8B96A5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="18,0">
              <TextBlock Text="{Binding Headline}" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="{Binding Subline}" Classes="muted" FontSize="14"/>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding Coaching}">
                <c:Icon Kind="HeartHandshake" Width="15" Height="15" Foreground="{DynamicResource HwAccentBrush}"/>
                <TextBlock Text="{Binding ChemistryText}" FontSize="12.5"/>
              </StackPanel>
            </StackPanel>
            </StackPanel>
            <Border x:Name="HeroRight" Grid.Column="1" HorizontalAlignment="Right" Background="#B0161B22" CornerRadius="8" Padding="14,10" VerticalAlignment="Center" MinWidth="320">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="{Binding CardIcon}" Width="15" Height="15" Foreground="{DynamicResource HwAccentBrush}"/>
                    <TextBlock Text="{Binding CardTitle}" Classes="muted" FontSize="11" FontWeight="SemiBold" LetterSpacing="1"/>
                  </StackPanel>
                  <TextBlock Text="{Binding NextGame}" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock Text="{Binding NextDetail}" Classes="muted" FontSize="12"/>
                  <!-- C5 part 1 (run 94): a rivalry or a ranked matchup, and the series since the career began. -->
                  <TextBlock x:Name="GameTag" Text="{Binding GameTag}" Foreground="{DynamicResource HwAccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"
                             IsVisible="{Binding GameTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <!-- C5 part 2 (run 95): the college home court (an arena's own edge). -->
                  <TextBlock x:Name="CourtLine" Text="{Binding CourtLine}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" MaxWidth="300"
                             IsVisible="{Binding CourtLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <!-- C5 (run 96): the conference's style in conference play. -->
                  <TextBlock x:Name="StyleLine" Text="{Binding StyleLine}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" MaxWidth="300"
                             IsVisible="{Binding StyleLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <TextBlock Text="{Binding Scouting}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="300" Margin="0,4,0,0" IsVisible="{Binding Scouting, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <Button Classes="link" Content="Pre-game show" Command="{Binding StudioCommand}" IsVisible="{Binding HasOpponent}" Margin="0,4,0,0" ToolTip.Tip="The HSN desk previews the game"/>
                  <Button Classes="primary" Content="See open jobs" Command="{Binding GoCommand}" CommandParameter="Board" IsVisible="{Binding OutOfWork}" Margin="0,6,0,0" ToolTip.Tip="Board → Out of work: open jobs"/>
                </StackPanel>
                <c:TeamLogo Grid.Column="1" Team="{Binding Opponent}" Width="56" Height="56" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Quick actions -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding GoCommand}" CommandParameter="Tactics" IsVisible="{Binding Coaching}"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="ClipboardList" Width="15" Height="15" Foreground="#E6EAF0"/><TextBlock Text="Game plan"/></StackPanel></Button>
        <Button Command="{Binding GoCommand}" CommandParameter="Rotation" IsVisible="{Binding Coaching}"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Repeat" Width="15" Height="15" Foreground="#E6EAF0"/><TextBlock Text="Rotation"/></StackPanel></Button>
        <Button Command="{Binding GoCommand}" CommandParameter="Squad" IsVisible="{Binding Coaching}"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="HeartHandshake" Width="15" Height="15" Foreground="#E6EAF0"/><TextBlock Text="Squad"/></StackPanel></Button>
        <Button Command="{Binding GoCommand}" CommandParameter="Board" IsVisible="{Binding OutOfWork}"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Shield" Width="15" Height="15" Foreground="#E6EAF0"/><TextBlock Text="Open jobs"/></StackPanel></Button>
        <Button Command="{Binding GoCommand}" CommandParameter="Inbox"><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Inbox" Width="15" Height="15" Foreground="#E6EAF0"/><TextBlock Text="Inbox"/></StackPanel></Button>
      </StackPanel>

      <!-- March Madness (C4 part 2): a pro career's view of the tournament, Selection Sunday to a few days after the final. -->
      <Border x:Name="MadnessPanel" Classes="panel" IsVisible="{Binding HasMadness}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Icon Kind="Trophy" Width="16" Height="16" Foreground="#E3B341" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="h2" Margin="0" TextWrapping="Wrap">
                <Run Text="{Binding MadnessTitle}"/><Run Text=" · " Foreground="#8B96A5"/><Run Text="{Binding MadnessStage}" FontWeight="Normal"/>
              </TextBlock>
              <TextBlock Text="{Binding MadnessSummary}" Classes="muted" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="link" Content="Open the bracket" Command="{Binding OpenBracketCommand}" VerticalAlignment="Top" Margin="10,0,0,0" ToolTip.Tip="College → March Madness"/>
          </Grid>
          <Grid x:Name="MadnessColumns" ColumnDefinitions="*,*">
            <StackPanel Spacing="3" Margin="0,0,14,0" Grid.IsSharedSizeScope="True">
              <TextBlock Text="{Binding MadnessResultsTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding MadnessResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="college:MadnessWatchRow">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="MadTag"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Background="#3A4654" HorizontalAlignment="Left" CornerRadius="3" Padding="5,0" VerticalAlignment="Top" Margin="0,2,8,0">
                        <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.6" Foreground="White"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding HasMadnessProspects}">
              <TextBlock Text="{Binding MadnessProspectsTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding MadnessProspects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="college:MadnessWatchRow">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                      <Border Background="#58A6FF" CornerRadius="3" Padding="5,0" VerticalAlignment="Top" Margin="0,2,8,0" MinWidth="26">
                        <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Three across; when narrow (big text sizes) the standings get their own row and the other two share the next. -->
      <Grid x:Name="Panels" ColumnDefinitions="3*,2*,2*" RowDefinitions="Auto,Auto">
        <!-- Standings (the wider panel, so full team names fit at 1280 px with the assistant open) -->
        <Border x:Name="TablePanel" Classes="panel" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="ListOrdered" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding TableTitle}" Classes="h2" Margin="0"/></StackPanel>
            <ItemsControl ItemsSource="{Binding Table}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TableRow">
                  <Border Padding="4,3" CornerRadius="4" Background="{Binding Ours, Converter={x:Static vm:HomeConverters.Highlight}}">
                    <!-- Record and margin columns are only as wide as the widest row needs, so long team names keep the room. -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Rec"/><ColumnDefinition Width="Auto" SharedSizeGroup="Diff"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Rank}" Classes="muted"/>
                      <c:TeamLogo Grid.Column="1" Team="{Binding Team}" ShowText="False" Width="18" Height="18" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="{Binding Ours, Converter={x:Static vm:HomeConverters.Bold}}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Record}" HorizontalAlignment="Right" Margin="6,0,0,0"/>
                      <TextBlock Grid.Column="4" Text="{Binding Diff}" Classes="muted" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Squad pulse and injuries -->
        <StackPanel x:Name="PulsePanel" Grid.Column="1" Spacing="10" Margin="0,0,10,0">
          <!-- H15b (run 93): out of work, the open jobs take the squad panels' place. -->
          <Border x:Name="JobsPanel" Classes="panel" IsVisible="{Binding OutOfWork}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Shield" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Open jobs" Classes="h2" Margin="0"/></StackPanel>
              <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HomeRow">
                    <Grid ColumnDefinitions="24,*" Margin="0,2">
                      <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="{Binding Highlight, Converter={x:Static vm:HomeConverters.Bold}}"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding JobsNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Classes="panel" IsVisible="{Binding Coaching}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="HeartHandshake" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Squad pulse" Classes="h2" Margin="0"/></StackPanel>
              <ItemsControl ItemsSource="{Binding Pulse}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HomeRow">
                    <!-- Name, then the detail underneath: side by side they didn't fit in a narrow panel. -->
                    <Grid ColumnDefinitions="24,*" Margin="0,2">
                      <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="panel" IsVisible="{Binding Coaching}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Bandage" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Injuries" Classes="h2" Margin="0"/></StackPanel>
              <ItemsControl ItemsSource="{Binding Injuries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HomeRow">
                    <Grid ColumnDefinitions="24,*" Margin="0,2">
                      <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- News -->
        <Border x:Name="LatestPanel" Grid.Column="2" Classes="panel">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="Newspaper" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Latest" Classes="h2" Margin="0"/></StackPanel>
            <ItemsControl ItemsSource="{Binding News}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HomeRow">
                  <Grid ColumnDefinitions="24,*,Auto" Margin="0,3">
                    <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <Border Background="{Binding BadgeBrush}" CornerRadius="3" Padding="5,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.6" Foreground="White"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="{Binding Highlight, Converter={x:Static vm:HomeConverters.Bold}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" Margin="8,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- On this day (roadmap 4): earlier seasons around today's date -->
            <StackPanel Spacing="3" Margin="0,8,0,0" IsVisible="{Binding HasOnThisDay}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="History" Width="14" Height="14" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="On this day" FontWeight="SemiBold"/></StackPanel>
              <ItemsControl ItemsSource="{Binding OnThisDay}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Charts (your club's; none out of work, H15b) -->
      <Grid ColumnDefinitions="2*,*,*" IsVisible="{Binding Coaching}">
        <Border Classes="panel" Margin="0,0,10,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="TrendingUp" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Season form (running point differential)" Classes="h2" Margin="0"/></StackPanel>
            <TextBlock Text="{Binding FormNote}" IsVisible="{Binding FormNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="muted" Margin="0,8,0,0"/>
            <c:LineChart Series="{Binding Form}" XLabels="{Binding FormLabels}" ZeroLine="True" Height="180" IsVisible="{Binding FormNote, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
            <TextBlock Text="Chemistry and morale by week" Classes="h2" Margin="0,8,0,0" IsVisible="{Binding HasMood}"/>
            <c:LineChart Series="{Binding Mood}" XLabels="{Binding MoodLabels}" Height="150" IsVisible="{Binding HasMood}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="panel" Margin="0,0,10,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="ChartColumnIncreasing" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Points per game" Classes="h2" Margin="0"/></StackPanel>
            <TextBlock Text="{Binding ComparisonNote}" IsVisible="{Binding ComparisonNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <c:BarChart Bars="{Binding Comparison}" Height="180" IsVisible="{Binding ComparisonNote, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="{Binding PayrollIcon}" Width="16" Height="16" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding PayrollTitle}" Classes="h2" Margin="0"/></StackPanel>
            <c:BarChart Bars="{Binding Payroll}" Lines="{Binding PayrollLines}" Height="180"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
