<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             x:Class="Hardwood.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Saving" Classes="h2"/>
          <TextBlock Text="{Binding SaveNote}" TextWrapping="Wrap" Classes="muted"/>
          <Button Content="Save now" Command="{Binding SaveCareerCommand}" IsEnabled="{Binding CanSave}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Text and interface size" Classes="h2"/>
          <TextBlock Text="Makes all text, tables and charts bigger or smaller. Pages reflow to fit, so nothing is cut off; at larger sizes some tables scroll sideways."
                     TextWrapping="Wrap" Classes="muted"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Size" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding Size}" MinWidth="180"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Your assistant" Classes="h2"/>
          <TextBlock Text="A panel on the right of every page: what to do next, what the page you're on is for, and strategy for your team. 'Grows with me' starts with the basics and moves on to strategy as you play."
                     TextWrapping="Wrap" Classes="muted"/>
          <CheckBox Content="Show the assistant" IsChecked="{Binding Guide.On}"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="How much it explains" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Guide.LevelChoices}" SelectedItem="{Binding Guide.Level}" MinWidth="180"/>
          </StackPanel>
          <Button Content="Show hidden tips again" Command="{Binding Guide.ResetDismissedCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Guide.ResetNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Guide.ResetNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Sound" Classes="h2"/>
          <TextBlock Text="The crowd in live games: it swells with big crowds, runs and close finishes, cheers the home side's baskets and groans at the visitors'. The referee's whistle and the buzzer too. At 4× and 8× only the biggest moments play. The speaker button on the live game (or M) mutes it there."
                     TextWrapping="Wrap" Classes="muted"/>
          <CheckBox Content="Play the crowd's sound in live games" IsChecked="{Binding SoundOn}"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Volume" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolume}" IsEnabled="{Binding SoundOn}" Width="240"/>
            <TextBlock Text="{Binding SoundVolumeText}" VerticalAlignment="Center" Classes="muted"/>
          </StackPanel>
          <TextBlock Text="Fight songs: at a college game the home band plays its school's song before the tip, at halftime, after a home run of 8-0 or more and when the home side wins. Every program has its own original song. To use your own recording instead, put it in the fight-songs folder named after the school (for example &quot;Duke.ogg&quot; or &quot;miami-fl.mp3&quot;; .ogg, .wav or .mp3)."
                     TextWrapping="Wrap" Classes="muted"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding FightSongsText}" VerticalAlignment="Center"/>
            <Button Content="Open folder" Command="{Binding OpenFightSongsCommand}" ToolTip.Tip="{Binding FightSongsFolder}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <ContentControl Content="{Binding Graphics}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
