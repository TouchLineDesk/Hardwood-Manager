<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel">
  <!-- "Around the league" moves under the results when both can't sit side by side without the table scrolling. -->
  <Grid x:Name="Page" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <DockPanel x:Name="Results">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Schedule &amp; Results" Classes="h1" Margin="0"/>
          <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Open box score" Command="{Binding OpenBoxCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding CanOpenBox}" ToolTip.Tip="{Binding OpenBoxTip}" ToolTip.ShowOnDisabled="True" VerticalAlignment="Top"/>
      </Grid>
      <!-- Danny's #529: filter by the season's parts, each tournament and the playoffs; each chip carries its record. -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
        <ItemsControl x:Name="FilterChips" ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <Button Classes="filter" Classes.on="{Binding Selected}" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}"
                      Tag="{Binding Name}" Click="OnFilterClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Record}" Classes="filterRecord"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding FilterSummary}" Classes="muted" IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <!-- Run 72 (review #13 rank 9): the view switch and the form strip (the last ten results in the games shown). -->
        <WrapPanel>
          <ComboBox x:Name="GameViews" ItemsSource="{Binding GameViews}" SelectedItem="{Binding GameView}" Width="120" Margin="0,0,14,4" VerticalAlignment="Center" ToolTip.Tip="Scoreboard tiles, or the full table"/>
          <StackPanel x:Name="FormStrip" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" VerticalAlignment="Center" IsVisible="{Binding HasForm}">
            <ItemsControl ItemsSource="{Binding Form}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FormBox">
                  <Border Width="20" Height="20" CornerRadius="4" Background="{Binding Won, Converter={x:Static c:Converters.WinLossBrush}}" ToolTip.Tip="{Binding Tip}">
                    <TextBlock Text="{Binding Letter}" Foreground="#111" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FormText}" Classes="muted" VerticalAlignment="Center"/>
          </StackPanel>
        </WrapPanel>
        <!-- H20 (run 72): out of the postseason, the page says so. -->
        <TextBlock Text="{Binding SeasonOver}" Foreground="{DynamicResource HwAccentBrush}" TextWrapping="Wrap" IsVisible="{Binding SeasonOver, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
      <Panel>
      <!-- Run 72: scoreboard tiles first: a W/L stripe, the opponent's logo, the score big and the top performer. Click picks, double-click opens the box score. -->
      <ListBox x:Name="GameTiles" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" DoubleTapped="OnRowDoubleTapped" IsVisible="{Binding ShowCards}"
               Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="CornerRadius" Value="6"/></Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
          <Style Selector="ListBoxItem:selected Border.tile"><Setter Property="BorderBrush" Value="{DynamicResource HwAccentBrush}"/></Style>
          <Style Selector="ListBoxItem:pointerover Border.tile"><Setter Property="Background" Value="{StaticResource HwPanelAltBrush}"/></Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GameRow">
            <Border Classes="panel tile" Width="204" Height="134" Padding="0" ClipToBounds="True" BorderThickness="2" ToolTip.Tip="Click to see the head-to-head · double-click to open the box score">
              <Grid ColumnDefinitions="5,*">
                <Border Background="{Binding Kind, Converter={x:Static c:Converters.ResultStripe}}"/>
                <StackPanel Grid.Column="1" Margin="10,7,8,6" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding TileWhen}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    <!-- C5 part 1 (run 94): a rivalry or a ranked matchup. -->
                    <TextBlock Grid.Column="1" Text="{Binding Tag}" IsVisible="{Binding HasTag}" ToolTip.Tip="{Binding TagTip}" Foreground="{DynamicResource HwAccentBrush}"
                               FontSize="10.5" FontWeight="Bold" LetterSpacing="0.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" Height="34">
                    <c:TeamLogo Team="{Binding OpponentTeam}" Width="30" Height="30" ShowText="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TileOpponent}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding TileScore}" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Record}" Classes="muted" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                  </Grid>
                  <TextBlock Text="{Binding TileFoot}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasEvent}"/>
                  <TextBlock Text="{Binding Competition}" Foreground="{DynamicResource HwAccentBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasEvent}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DataGrid x:Name="GameTable" ItemsSource="{Binding Games}" IsVisible="{Binding ShowTable}" SelectedItem="{Binding Selected}" DoubleTapped="OnRowDoubleTapped" RowHeight="28">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="72"/>
          <DataGridTemplateColumn Header="" Width="34">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:GameRow"><c:TeamLogo Team="{Binding OpponentTeam}" Width="22" Height="22" ShowText="False" Margin="4,0"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Opponent" Binding="{Binding Opponent}" Width="*" MinWidth="220"/>
          <DataGridTextColumn Header="Event" Binding="{Binding Competition}" Width="186" IsVisible="False"/>
          <!-- The result and score in one column ("W 78-66"), so the H2H column (#529) fits beside them. -->
          <!-- Run 101: 130 fits the widest result, a three-digit multi-overtime game ("W 161-158 2OT", 119 px at 100%). -->
          <DataGridTextColumn Header="Score" Binding="{Binding ResultText}" Width="130"/>
          <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="56"/>
          <DataGridTextColumn Header="H2H" Binding="{Binding HeadToHead}" Width="50"/>
          <DataGridTextColumn Header="Top performer" Binding="{Binding TopPerformer}" Width="*" MinWidth="200"/>
        </DataGrid.Columns>
      </DataGrid>
      </Panel>
    </DockPanel>
    <StackPanel x:Name="Side" Grid.Column="1" Spacing="10" Width="300" Margin="16,0,0,0">
      <!-- #529: the head-to-head with the selected game's opponent, counted from the career's start only. -->
      <Border x:Name="Rival" Classes="panel" Padding="12,10" IsVisible="{Binding HasRival}"
              BorderBrush="{Binding RivalTeam, Converter={x:Static c:Converters.TeamAccentBrush}}">
        <!-- Two halves that sit side by side when the panel spans the page (stacked) and one above the other beside the table. -->
        <WrapPanel>
          <StackPanel Spacing="4" Width="274" Margin="0,0,16,0">
            <TextBlock Text="Head-to-head" Classes="muted" FontSize="11.5"/>
            <Grid ColumnDefinitions="Auto,*">
              <c:TeamLogo Team="{Binding RivalTeam}" Width="44" Height="44" ShowText="False" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding RivalName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RivalRecord}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding RivalPoints}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding RivalPoints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding RivalLast}" TextWrapping="Wrap" IsVisible="{Binding RivalLast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock x:Name="RivalryLine" Text="{Binding RivalryLine}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}"
                       IsVisible="{Binding RivalryLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <StackPanel Spacing="2" Width="274">
            <TextBlock Text="This season" Classes="muted" FontSize="11.5" Margin="0,4,0,0" IsVisible="{Binding HasMeetings}"/>
            <ItemsControl ItemsSource="{Binding RivalMeetings}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding RivalSince}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </WrapPanel>
      </Border>
      <TextBlock Text="{Binding ScoresTitle}" Classes="h2" Margin="0"/>
      <Border Classes="panel" MaxHeight="300" x:Name="Scores">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding LeagueScores}">
            <!-- One score per line beside the results; several per line when this panel sits underneath them. -->
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2,24,2" MinWidth="150" FontFamily="Consolas,Menlo,monospace"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowPlayoffs}">
        <c:CompetitionBadge Kind="Playoffs" Width="36" Height="36"/>
        <TextBlock Text="Playoffs" Classes="h2" Margin="0" VerticalAlignment="Center"/>
      </StackPanel>
      <!-- One card per series: round above, matchup and series score below, so long round names wrap rather than clip. -->
      <ScrollViewer x:Name="SeriesList" IsVisible="{Binding ShowPlayoffs}" MaxHeight="440">
        <ItemsControl ItemsSource="{Binding Series}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeriesRow">
              <Border Classes="panel" Padding="10,6" Margin="0,0,0,6" BorderBrush="{Binding Involved, Converter={x:Static c:Converters.AccentIfTrue}}">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Round}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                  <!-- Run 72: both clubs' logos beside the matchup. -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
                      <c:TeamLogo Team="{Binding High}" Width="24" Height="24" ShowText="False"/>
                      <c:TeamLogo Team="{Binding Low}" Width="24" Height="24" ShowText="False"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Matchup}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Score}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Grid>
</UserControl>
