<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel">
  <!-- "Around the league" moves under the results when both can't sit side by side without the table scrolling. -->
  <Grid x:Name="Page" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <DockPanel x:Name="Results">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Schedule &amp; Results" Classes="h1" Margin="0"/>
          <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Open box score" Command="{Binding OpenBoxCommand}" CommandParameter="{Binding Selected}" VerticalAlignment="Top"/>
      </Grid>
      <!-- Danny's #529: filter by the season's parts, each tournament and the playoffs; each chip carries its record. -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="4">
        <ItemsControl x:Name="FilterChips" ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <Button Classes="filter" Classes.on="{Binding Selected}" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}"
                      Tag="{Binding Name}" Click="OnFilterClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Record}" Classes="filterRecord"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding FilterSummary}" Classes="muted" IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" DoubleTapped="OnRowDoubleTapped" RowHeight="28">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="72"/>
          <DataGridTemplateColumn Header="" Width="34">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:GameRow"><c:TeamLogo Team="{Binding OpponentTeam}" Width="22" Height="22" ShowText="False" Margin="4,0"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Opponent" Binding="{Binding Opponent}" Width="*" MinWidth="220"/>
          <DataGridTextColumn Header="Event" Binding="{Binding Competition}" Width="186" IsVisible="False"/>
          <!-- The result and score in one column ("W 78-66"), so the H2H column (#529) fits beside them. -->
          <DataGridTextColumn Header="Score" Binding="{Binding ResultText}" Width="114"/>
          <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="56"/>
          <DataGridTextColumn Header="H2H" Binding="{Binding HeadToHead}" Width="50"/>
          <DataGridTextColumn Header="Top performer" Binding="{Binding TopPerformer}" Width="*" MinWidth="200"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <StackPanel x:Name="Side" Grid.Column="1" Spacing="10" Width="300" Margin="16,0,0,0">
      <!-- #529: the head-to-head with the selected game's opponent, counted from the career's start only. -->
      <Border x:Name="Rival" Classes="panel" Padding="12,10" IsVisible="{Binding HasRival}"
              BorderBrush="{Binding RivalTeam, Converter={x:Static c:Converters.TeamAccentBrush}}">
        <!-- Two halves that sit side by side when the panel spans the page (stacked) and one above the other beside the table. -->
        <WrapPanel>
          <StackPanel Spacing="4" Width="274" Margin="0,0,16,0">
            <TextBlock Text="Head-to-head" Classes="muted" FontSize="11.5"/>
            <Grid ColumnDefinitions="Auto,*">
              <c:TeamLogo Team="{Binding RivalTeam}" Width="44" Height="44" ShowText="False" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding RivalName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RivalRecord}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HwAccentBrush}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding RivalPoints}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding RivalPoints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding RivalLast}" TextWrapping="Wrap" IsVisible="{Binding RivalLast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <StackPanel Spacing="2" Width="274">
            <TextBlock Text="This season" Classes="muted" FontSize="11.5" Margin="0,4,0,0" IsVisible="{Binding HasMeetings}"/>
            <ItemsControl ItemsSource="{Binding RivalMeetings}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding RivalSince}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </WrapPanel>
      </Border>
      <TextBlock Text="Around the league (yesterday)" Classes="h2" Margin="0"/>
      <Border Classes="panel" MaxHeight="300" x:Name="Scores">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding LeagueScores}">
            <!-- One score per line beside the results; several per line when this panel sits underneath them. -->
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2,24,2" MinWidth="150" FontFamily="Consolas,Menlo,monospace"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowPlayoffs}">
        <c:CompetitionBadge Kind="Playoffs" Width="36" Height="36"/>
        <TextBlock Text="Playoffs" Classes="h2" Margin="0" VerticalAlignment="Center"/>
      </StackPanel>
      <!-- One card per series: round above, matchup and series score below, so long round names wrap rather than clip. -->
      <ScrollViewer IsVisible="{Binding ShowPlayoffs}" MaxHeight="440">
        <ItemsControl ItemsSource="{Binding Series}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeriesRow">
              <Border Classes="panel" Padding="10,6" Margin="0,0,0,6" BorderBrush="{Binding Involved, Converter={x:Static c:Converters.AccentIfTrue}}">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Round}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Matchup}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Score}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Grid>
</UserControl>
