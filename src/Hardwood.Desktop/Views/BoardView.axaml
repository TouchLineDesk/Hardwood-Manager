<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <ScrollViewer>
    <!-- Side by side when wide; the coach drops below the club when narrow (big text sizes), so his bars keep their length. -->
    <Grid x:Name="Columns" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto">
      <StackPanel x:Name="ClubColumn" Spacing="12" Margin="0,0,12,0">
        <!-- Employed: owner, goals, confidence -->
        <Border Classes="panel" IsVisible="{Binding Employed}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="{Binding FinanceIcon}" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding FinanceTitle}" Classes="h2" Margin="0"/></StackPanel>
            <c:StatStrip ItemsSource="{Binding FinanceChips}" Accent="{Binding Accent}"/>
            <TextBlock Text="{Binding FinanceNote}" Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
          </StackPanel>
        </Border>
        <!-- Item M (#281): facilities -->
        <Border Classes="panel" IsVisible="{Binding HasFacilities}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="House" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Facilities" Classes="h2" Margin="0"/></StackPanel>
            <c:StatStrip ItemsSource="{Binding FacilityChips}" Accent="{Binding Accent}"/>
            <ItemsControl ItemsSource="{Binding Facilities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FacilityRow">
                  <StackPanel Margin="0,4" ToolTip.Tip="{Binding Pitch}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="muted" Margin="8,0,0,0"/>
                    </Grid>
                    <ProgressBar MinWidth="0" Value="{Binding Level}" Maximum="5" Height="6" Margin="0,3"/>
                    <TextBlock Text="{Binding Effect}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Building}" IsVisible="{Binding HasBuilding}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Text="Proposals" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ProposalNote}" Classes="muted" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Proposals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProposalRow">
                  <Border Background="{StaticResource HwPanelAltBrush}" CornerRadius="8" Padding="10" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Classes="primary" Content="Approve" Command="{Binding Approve}"/>
                        <Button Content="Decline" Command="{Binding Decline}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Content="Let the GM decide each summer" IsChecked="{Binding GmDecides}"/>
            <TextBlock Text="{Binding FacilityStatus}" Classes="accent" TextWrapping="Wrap"/>
            <TextBlock Text="Each facility counts against the league's average: keeping up holds your ground, getting ahead pays. Facilities date and drop a level unless they're renewed (levels 4 and 5 sooner), and they cost money to run; the top levels cost more to build. Only an ambitious owner builds well past the league's average. The owner keeps a reserve in the bank (less if he's ambitious) and funds projects from the rest." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <!-- CS7 (run 170, K19): the college program's boosters and facilities -->
        <Border Classes="panel" IsVisible="{Binding HasProgram}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="GraduationCap" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Program building" Classes="h2" Margin="0"/></StackPanel>
            <c:StatStrip ItemsSource="{Binding ProgramBuildChips}" Accent="{Binding Accent}"/>
            <TextBlock Text="{Binding ProgramAppeal}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProgramPrestige}" TextWrapping="Wrap" FontSize="11.5"/>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Button Content="{Binding BuildGymText}" Command="{Binding BuildGymCommand}" IsEnabled="{Binding CanBuildGym}" ToolTip.Tip="{Binding BuildGymTip}" Margin="0,0,8,6"/>
              <Button Content="{Binding BuildArenaText}" Command="{Binding BuildArenaCommand}" IsEnabled="{Binding CanBuildArena}" ToolTip.Tip="{Binding BuildArenaTip}" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding ProgramStatus}" Classes="accent" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProgramLastSummer}" Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
            <TextBlock Text="College players are paid nothing: the boosters' money goes into the program. They give each summer, more at a bigger program and more when they're happy (winning, March runs and rivalry wins). Each level costs more than the last." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <!-- CS7 part 2c (run 175): academics -->
        <Border Classes="panel" IsVisible="{Binding HasAcademics}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="ClipboardPen" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Academics" Classes="h2" Margin="0"/></StackPanel>
            <c:StatStrip ItemsSource="{Binding AcademicChips}" Accent="{Binding Accent}"/>
            <TextBlock Text="{Binding AcademicSummary}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding AcademicRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AcademicRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Standing}" Foreground="{Binding StandingBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Grid.Column="2" Content="{Binding ButtonText}" Command="{Binding Toggle}" VerticalAlignment="Center" MinWidth="130"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Button Content="{Binding BuildCenterText}" Command="{Binding BuildCenterCommand}" IsEnabled="{Binding CanBuildCenter}" ToolTip.Tip="{Binding BuildCenterTip}" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding AcademicStatus}" Classes="accent" TextWrapping="Wrap"/>
            <TextBlock Text="Each term the advisers project every player's grades from his work habits. A midterm report (Nov 20 and Mar 2) names anyone who could fall under 2.0; nobody else can. Study hall gets an at-risk player through and costs the coaches a recruiting hour a week. The academic-support center, paid for from the booster fund, lifts everyone's grades." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <!-- D81 (run 169): the revenue levers -->
        <Border Classes="panel" IsVisible="{Binding HasBusiness}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="DollarSign" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Match-day business" Classes="h2" Margin="0"/></StackPanel>
            <c:StatStrip ItemsSource="{Binding BusinessChips}" Accent="{Binding Accent}"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Text="Ticket prices" VerticalAlignment="Center" Margin="0,0,12,4"/>
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TicketChoices}" SelectedItem="{Binding Ticket}" MinWidth="160" Margin="0,0,0,4" ToolTip.Tip="Cheap 80%, high 115%, premium 130% of the standard price. A big, loyal support fills the arena at any price; a small one stays home."/>
              <TextBlock Grid.Row="1" Text="Food and drink" VerticalAlignment="Center" Margin="0,0,12,4"/>
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FoodChoices}" SelectedItem="{Binding Food}" MinWidth="160" Margin="0,0,0,4" ToolTip.Tip="A value menu sells more at less each (85% of the takings); premium earns 112% and costs a little goodwill."/>
              <TextBlock Grid.Row="2" Text="Parking" VerticalAlignment="Center" Margin="0,0,12,4"/>
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ParkingChoices}" SelectedItem="{Binding Parking}" MinWidth="160" Margin="0,0,0,4" ToolTip.Tip="Free parking gives up the lots' takings for goodwill; premium earns 125%."/>
              <TextBlock Grid.Row="3" Text="Fan appreciation days" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FanDayChoices}" SelectedItem="{Binding FanDays}" MinWidth="160" ToolTip.Tip="Giveaways, open practices and autographs: each costs about 0.4% of revenue and grows the fan base (less for each extra day)."/>
            </Grid>
            <TextBlock Text="{Binding BusinessPreview}" TextWrapping="Wrap" FontSize="11.5"/>
            <TextBlock Text="{Binding BusinessWhen}" Classes="muted" TextWrapping="Wrap" FontSize="11.5"/>
            <TextBlock Text="{Binding BusinessStatus}" Classes="accent" TextWrapping="Wrap"/>
            <TextBlock Text="The match day is about 30% of revenue: tickets, food and drink, parking. Higher prices earn more now and cost fans; cheaper ones, free parking and fan days grow the fan base, and revenue grows with the fans. Arena upgrades are in Facilities." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Classes="panel" IsVisible="{Binding Employed}">
          <Grid ColumnDefinitions="Auto,*">
            <c:TeamLogo Team="{Binding Team}" Width="72" Height="72" VerticalAlignment="Top" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="Shield" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding OwnerTitle}" Classes="h2" Margin="0"/></StackPanel>
              <TextBlock Text="{Binding OwnerName}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding OwnerStyle}" Classes="muted"/>
              <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                <TextBlock Text="Patience" Classes="muted"/>
                <ProgressBar Grid.Column="1" MinWidth="0" Value="{Binding Patience}" Maximum="20" Height="6" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding PatienceText}" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                <TextBlock Grid.Row="1" Text="Ambition" Classes="muted"/>
                <ProgressBar Grid.Row="1" Grid.Column="1" MinWidth="0" Value="{Binding Ambition}" Maximum="20" Height="6" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AmbitionText}" Margin="10,0,0,0" HorizontalAlignment="Left"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="panel" IsVisible="{Binding Employed}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="Trophy" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="This season" Classes="h2" Margin="0"/></StackPanel>
            <TextBlock Text="{Binding Goal}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Pace}" Classes="muted"/>
            <ItemsControl ItemsSource="{Binding Demands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DemandRow">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <c:Icon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding Brush}"/>
                    <TextBlock Text="{Binding Text}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ConfidenceTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,Auto">
              <ProgressBar Value="{Binding Confidence}" Maximum="100" Height="10" Foreground="{Binding ConfidenceBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Margin="10,0,0,0" Foreground="{Binding ConfidenceBrush}" FontWeight="SemiBold"/>
            </Grid>
            <c:LineChart Series="{Binding ConfidenceTrend}" Height="140" MinY="0" MaxY="100" IsVisible="{Binding HasTrend}"/>
            <!-- What moved confidence (roadmap 4) -->
            <TextBlock Text="What's moving it" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ConfidenceHeading}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ConfidenceRecent}" Classes="muted" TextWrapping="Wrap"/>
            <c:StatStrip ItemsSource="{Binding ConfidenceDrivers}" Accent="{Binding Accent}"/>
            <TextBlock Text="{Binding ConfidenceNote}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Jobs: out of work, or bigger jobs and offers while in work (run 61, #651) -->
        <Border Classes="panel" IsVisible="{Binding ShowJobs}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="Newspaper" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="{Binding JobsTitle}" Classes="h2" Margin="0" TextWrapping="Wrap"/></StackPanel>
            <TextBlock Text="{Binding JobsNote}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Status}" Classes="accent"/>
            <ItemsControl ItemsSource="{Binding Vacancies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VacancyRow">
                  <Border Background="{StaticResource HwPanelAltBrush}" CornerRadius="8" Padding="10" Margin="0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <c:TeamLogo Team="{Binding Team}" Width="44" Height="44" Margin="0,0,10,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" FontSize="11.5"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Apply" Command="{Binding Apply}" IsVisible="{Binding CanApply}"/>
                        <Button Classes="primary" Content="Accept" Command="{Binding Accept}" IsVisible="{Binding HasOffer}"/>
                        <Button Content="Decline" Command="{Binding Decline}" IsVisible="{Binding HasOffer}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Coach profile -->
      <StackPanel x:Name="CoachColumn" Grid.Column="1" Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Kind="ClipboardList" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/><TextBlock Text="Your coach" Classes="h2" Margin="0"/></StackPanel>
            <TextBlock Text="{Binding CoachName}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CoachBio}" Classes="muted" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="132,*,40" Margin="0,6,0,4">
              <TextBlock Text="Reputation" FontWeight="SemiBold"/>
              <ProgressBar Grid.Column="1" MinWidth="0" Value="{Binding Reputation}" Maximum="100" Height="8" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Reputation, StringFormat={}{0:0}}" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding CoachAttrs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CoachAttrView">
                  <Grid ColumnDefinitions="132,*,30" Margin="0,2">
                    <TextBlock Text="{Binding Label}" Classes="muted"/>
                    <ProgressBar Grid.Column="1" MinWidth="0" Value="{Binding Value}" Maximum="20" Height="6" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Job history" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding JobHistory}" Classes="muted" TextWrapping="Wrap"/>
            <!-- The career path (run 61, #651): resign, with one confirm -->
            <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding Employed}">
              <TextBlock Text="{Binding ResignNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Resign" Command="{Binding ResignCommand}" IsVisible="{Binding !ConfirmingResign}" ToolTip.Tip="Leave your job and look for work (asks first)"/>
                <Button Classes="primary" Content="Yes, resign" Command="{Binding ResignCommand}" IsVisible="{Binding ConfirmingResign}"/>
                <Button Content="Stay" Command="{Binding CancelResignCommand}" IsVisible="{Binding ConfirmingResign}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
