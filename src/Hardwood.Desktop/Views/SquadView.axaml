<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.SquadView"
             x:DataType="vm:SquadViewModel">
  <!-- Run 74: side by side when there is room; on narrow windows the side panel drops under the cards and the page scrolls (Reflow). -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Page" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <DockPanel x:Name="Main">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Squad" Classes="h1" Margin="0"/>
          <ComboBox x:Name="Views" Grid.Column="1" ItemsSource="{Binding Views}" SelectedItem="{Binding View}" Width="120" VerticalAlignment="Top"
                    ToolTip.Tip="The dressing room as cards, or the full table"/>
        </Grid>
        <c:StatStrip ItemsSource="{Binding Chips}" Accent="{Binding Accent}"/>
        <!-- Run 74 (review #13 rank 11): chemistry as a dial, and what moves it as bars. -->
        <Grid ColumnDefinitions="Auto,*">
          <c:Gauge x:Name="ChemistryDial" Width="124" Value="{Binding Chemistry}" Maximum="100" Word="{Binding ChemistryWord}" Number="{Binding ChemistryNumber}"
                   ArcColor="{Binding ChemistryColor}" VerticalAlignment="Top" ToolTip.Tip="{Binding ChemistryHeadline}"/>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
            <TextBlock Text="{Binding ChemistryHeadline}" Classes="h2" Margin="0"/>
            <ItemsControl x:Name="ChemistryBars" ItemsSource="{Binding ChemistryFactors}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FactorRow">
                  <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="Effect"/>
                      <ColumnDefinition Width="96"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EffectText}" FontWeight="SemiBold" Classes.good="{Binding Positive}" Classes.bad="{Binding !Positive}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#2A333D" VerticalAlignment="Center" Margin="0,0,6,0">
                      <Border Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"
                              Classes.goodBar="{Binding Positive}" Classes.badBar="{Binding !Positive}"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Reason}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding MoraleSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>

      <Panel>
        <!-- Run 74: every player as a card in his mood's lane, the unsettled first. Click one to talk to him. -->
        <ScrollViewer x:Name="MoodCards" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowCards}">
          <ItemsControl ItemsSource="{Binding Lanes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MoodLane">
                <StackPanel Spacing="4" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MoodRow">
                        <Button Classes="marketCard" Classes.picked="{Binding Picked}" Width="206" MinHeight="104" Margin="0,0,8,8" Padding="0" VerticalAlignment="Top"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="OnCardClick" ToolTip.Tip="{Binding CardTip}">
                          <Border BorderBrush="{Binding MoodBrush}" BorderThickness="0,4,0,0" CornerRadius="3" Padding="8,6">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="40,*">
                                <c:Avatar Player="{Binding Player}" Team="{Binding Team}" Width="38" Height="38" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding CardLine}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*,28">
                                <c:Icon Kind="{Binding MoodIcon}" Width="16" Height="16" Foreground="{Binding MoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <c:RatingBar Grid.Column="1" Value="{Binding Morale}" Maximum="100" Fill="{Binding MoodBrush}" VerticalAlignment="Center" ToolTip.Tip="Morale, out of 100"/>
                                <TextBlock Grid.Column="2" Text="{Binding Morale}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                              </Grid>
                              <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Classes.bad="{Binding StatusBad}" Classes.accent="{Binding !StatusBad}"
                                         IsVisible="{Binding HasStatus}" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding WorryLine}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      <DataGrid x:Name="MoodTable" IsVisible="{Binding ShowTable}" ItemsSource="{Binding Players}" SelectedItem="{Binding Selected}" IsReadOnly="True" RowHeight="NaN">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="152"/>
          <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="44"/>
          <DataGridTemplateColumn Header="Mood" Width="134">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MoodRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0" VerticalAlignment="Center">
                  <c:Icon Kind="{Binding MoodIcon}" Width="15" Height="15" Foreground="{Binding MoodBrush}"/>
                  <TextBlock Text="{Binding Mood}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Morale" Width="100" SortMemberPath="Morale">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MoodRow">
                <Grid ColumnDefinitions="*,28" Margin="6,0" VerticalAlignment="Center">
                  <ProgressBar Value="{Binding Morale}" Maximum="100" Height="6" MinWidth="50" Foreground="{Binding MoodBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Morale}" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MoodRow"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,3" Classes.bad="{Binding StatusBad}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Biggest worry" Width="*" MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:MoodRow"><TextBlock Text="{Binding MainReason}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,3"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      </Panel>
    </DockPanel>

    <StackPanel x:Name="Side" Grid.Column="1" Spacing="10" Width="300" Margin="12,0,0,0">
      <Border Classes="panel">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding PlayerHeadline}" Classes="h2" Margin="0" TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="{Binding PlayerScore}" Classes="h2" Margin="8,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" ToolTip.Tip="Morale, out of 100"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding PlayerFactors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FactorRow">
                <Grid ColumnDefinitions="40,*">
                  <TextBlock Text="{Binding EffectText}" FontWeight="SemiBold" Classes.good="{Binding Positive}" Classes.bad="{Binding !Positive}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Reason}" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Talk to him" Classes="h2" Margin="0"/>
          <ItemsControl ItemsSource="{Binding Topics}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TalkButton">
                <Button Content="{Binding Label}" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" Margin="0,0,6,6"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding TalkNote}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Classes="panel" IsVisible="{Binding HasTrend}">
        <StackPanel>
          <TextBlock Text="Chemistry and morale by week" Classes="h2" Margin="0"/>
          <c:LineChart Series="{Binding Trend}" XLabels="{Binding TrendLabels}" Height="150"/>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="4">
          <TextBlock Text="Your promises" Classes="h2" Margin="0"/>
          <TextBlock Text="{Binding PromisesText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
