<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hardwood.Desktop.ViewModels"
             xmlns:c="using:Hardwood.Desktop.Controls"
             x:Class="Hardwood.Desktop.Views.TalkView"
             x:DataType="vm:TalkViewModel">
  <Border Classes="panel">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:Icon Kind="Handshake" Width="18" Height="18" Foreground="{DynamicResource HwAccentBrush}"/>
        <TextBlock Text="{Binding Title}" Classes="h2" Margin="0"/>
      </StackPanel>
      <c:PlayerCard Player="{Binding Player}" Team="{Binding PlayerTeam}" Width="170" Height="246" HorizontalAlignment="Left" IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding AskText}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="Auto,*,Auto,112" RowDefinitions="Auto" IsVisible="{Binding CanTalk}">
        <TextBlock Text="Wage $M/yr" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <NumericUpDown Grid.Column="1" Value="{Binding Wage}" Increment="{Binding WageStep}" Minimum="0" FormatString="0.00"/>
        <TextBlock Grid.Column="2" Text="Years" Classes="muted" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <NumericUpDown Grid.Column="3" Value="{Binding Years}" Increment="1" Minimum="1" Maximum="5" FormatString="0"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="Make offer" Command="{Binding OfferCommand}" IsEnabled="{Binding CanTalk}"/>
        <Button Content="Release" Command="{Binding ReleaseCommand}" IsVisible="{Binding IsRenewal}"/>
      </StackPanel>
      <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource HwAccentBrush}"/>
    </StackPanel>
  </Border>
</UserControl>
