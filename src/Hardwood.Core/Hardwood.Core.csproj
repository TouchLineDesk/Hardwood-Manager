<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="RealWorld/Data/*.json" />
    <!-- Fight songs B (run 167): the tier 1 note data (public-domain tunes, our own chords). -->
    <EmbeddedResource Include="../../tools/Assets/fightsongs/*.song" LogicalName="Hardwood.FightSongs.%(Filename).song" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
</Project>
